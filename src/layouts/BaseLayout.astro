---
import '../styles/global.css';
import settings from '../data/settings.json';
import Header from '../components/organisms/Header.astro';
import Footer from '../components/organisms/Footer.astro';
import ScrollToTop from '../components/molecules/ScrollToTop.astro';
import SmoothScroll from '../components/molecules/SmoothScroll.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import sharp from 'sharp';
import { toLd } from '../lib/jsonld';
import { toE164 } from '../lib/phone';
// The display face the hero headline waits for: preloaded so the copy doesn't reflow late (CLS).
import oswald700 from '@fontsource/oswald/files/oswald-latin-700-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  /** Extra structured data for this page (e.g. BreadcrumbList, FAQPage). */
  jsonLd?: Record<string, unknown>[];
  /** Never indexed, whatever the build flag says (the 404). Such a page answers at addresses
   *  that are not its own, so it also goes without a canonical and og:url. */
  noindex?: boolean;
}

const props = Astro.props;
// An emptied CMS field falls back to the site defaults instead of dropping the tag (CMS-10).
const title = props.title || settings.siteName;
const description = props.description || settings.defaultDescription;
const image = props.image || settings.defaultOgImage;
const imageAlt = props.imageAlt || settings.siteName;
const jsonLd = props.jsonLd ?? [];

// Indexing gate: the whole site stays noindex until go-live. The production
// build sets PUBLIC_SITE_INDEXABLE=true to allow indexing. See
// docs/geo-e-indicizzazione.md.
const indexable = import.meta.env.PUBLIC_SITE_INDEXABLE === 'true' && !props.noindex;
const canonical = props.noindex ? undefined : new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).toString() : undefined;
const ogTypes: Record<string, string> = { jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp', svg: 'image/svg+xml' };
const ogType = image ? ogTypes[image.split('.').pop()?.toLowerCase() ?? ''] : undefined;

// Social previews render faster and uncropped when the size is declared: read it from the file.
// The build runs from the project root; the bundled module's own URL is not under src/.
const publicFile = (src: string) => join(process.cwd(), 'public', src);
let ogSize: { width: number; height: number } | undefined;
if (image && !image.endsWith('.svg') && existsSync(publicFile(image))) {
  const { width, height } = await sharp(publicFile(image)).metadata();
  if (width && height) ogSize = { width, height };
}

// Structured data for the business. One entity for the whole site (stable @id, fixed image), fed
// by settings.json; optional fields are emitted only when present.
const address = settings.postalAddress;
const hasAddress = address && Object.values(address).some(Boolean);
const social = Object.values(settings.social ?? {}).filter(Boolean);
const businessLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'SportsActivityLocation',
  '@id': new URL('/#business', settings.siteUrl).toString(),
  name: settings.siteName,
  url: settings.siteUrl,
  description: settings.defaultDescription,
  ...(settings.defaultOgImage ? { image: new URL(settings.defaultOgImage, settings.siteUrl).toString() } : {}),
  ...(settings.email ? { email: settings.email } : {}),
  ...(settings.phone ? { telephone: toE164(settings.phone) } : {}),
  ...(settings.vatNumber ? { vatID: settings.vatNumber } : {}),
  ...(hasAddress ? { address: { '@type': 'PostalAddress', ...address } } : settings.address ? { address: settings.address } : {}),
  // sameAs = the same business elsewhere: its social profiles. The outdoor arena is a different place.
  ...(social.length ? { sameAs: social } : {}),
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta
      name="robots"
      content={indexable ? 'index, follow' : 'noindex, nofollow'}
    />
    <!-- Favicons: crosshair mark in the accent colour (favicon.svg is the source; PNG/ICO via scripts/generate-favicons.mjs) -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0e1114" />
    <link rel="preload" href={oswald700} as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={settings.siteName} />
    <meta property="og:locale" content="it_IT" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={imageAlt} />}
    {ogType && <meta property="og:image:type" content={ogType} />}
    {ogSize && <meta property="og:image:width" content={String(ogSize.width)} />}
    {ogSize && <meta property="og:image:height" content={String(ogSize.height)} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

    <script type="application/ld+json" set:html={toLd(businessLd)} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={toLd(data)} />)}
  </head>
  <body>
    <a href="#main" class="skip-link">Salta al contenuto</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <ScrollToTop />
    <SmoothScroll />
  </body>
</html>

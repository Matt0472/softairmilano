---
import navigation from '../../data/navigation.json';
import Button from '../atoms/Button.astro';

const { items } = navigation;
---

{/* Floating nav overlaid on the full-bleed hero (no classic top bar). */}
<header class="pointer-events-none absolute inset-x-0 top-0 z-50">
  <div class="shell pointer-events-auto flex items-center justify-between gap-4 py-5">
    <a
      href="/"
      class="font-display text-lg font-bold uppercase tracking-wide text-foreground [text-shadow:0_1px_12px_rgba(0,0,0,0.65)]"
    >
      SoftAir<span class="text-accent">Milano</span>
    </a>

    {/* Desktop: pill nav */}
    <nav
      class="hidden items-center gap-1 rounded-full border border-white/10 bg-background/60 px-2 py-1.5 backdrop-blur-md lg:flex"
      aria-label="Principale"
    >
      {
        items.map((it) => (
          <a
            href={it.href}
            class="rounded-full px-4 py-2 text-sm text-muted transition-colors hover:bg-white/5 hover:text-accent"
          >
            {it.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:block">
      <Button href="#prenota" variant="primary">Prenota</Button>
    </div>

    {/* Mobile: floating pill toggle (not a classic bordered hamburger) */}
    <button
      id="menu-toggle"
      class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-white/10 bg-background/60 px-4 font-display text-sm uppercase tracking-wide text-foreground backdrop-blur-md lg:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Apri il menu"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      Menu
    </button>
  </div>

  {/* Mobile: floating panel */}
  <nav
    id="mobile-menu"
    class="mobile-menu shell pointer-events-auto pt-2 lg:hidden"
    data-open="false"
    aria-label="Principale (mobile)"
  >
    <div class="rounded-2xl border border-white/10 bg-background/95 p-3 shadow-md backdrop-blur-md">
      {
        items.map((it) => (
          <a
            href={it.href}
            class="block rounded-xl px-4 py-3 text-foreground transition-colors hover:bg-white/5 hover:text-accent"
          >
            {it.label}
          </a>
        ))
      }
      <a
        href="#prenota"
        class="mt-2 block rounded-md bg-accent px-5 py-3 text-center font-display text-sm font-semibold uppercase tracking-wide text-on-accent transition-colors hover:bg-accent-hover"
      >
        Prenota
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.setAttribute('data-open', String(open));
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Chiudi il menu' : 'Apri il menu');
    };
    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  }
</script>

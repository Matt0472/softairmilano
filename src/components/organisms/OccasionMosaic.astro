---
// The occasions for groups. The featured one is the large photo with its title on it: beside the
// section heading and its action from 1280, under them on narrower screens. The others follow
// beneath it, each a photo with its title and line under it: side by side from 1024, as rows (photo
// beside the copy) on tablets and landscape phones, one after the other on portrait phones. A tile
// with a link is a whole-tile link with an arrow; a tile without one stays a plain photo, with no
// hover promise. The heading's action comes before the photos on screen and in the focus order. Copy
// and photos come from the CMS; an occasion without title or photo is skipped.

import Button from '../atoms/Button.astro';
import Icon from '../atoms/Icon.astro';
import Picture from '../atoms/Picture.astro';
import SectionHead from '../molecules/SectionHead.astro';
import { has } from '../../lib/fields';
import { keepShortWords } from '../../lib/typography';

interface Item {
  title: string;
  text?: string;
  image: string;
  imageMobile?: string;
  imageAlt?: string;
  href?: string;
  featured?: boolean;
}
interface Props {
  title: string;
  text?: string;
  cta?: { label?: string; href?: string };
  items: Item[];
  headingId?: string;
}

const { title, text, cta, items, headingId = 'occasions-title' } = Astro.props;
const filled = (items ?? []).filter((it) => has(it?.title) && has(it?.image));
const hasTitle = has(title);
const hasCta = has(cta?.label) && has(cta?.href);

// The featured occasion leads; without one, the first does. The others keep the CMS order.
const leadAt = Math.max(0, filled.findIndex((it) => it.featured));
const lead = filled[leadAt];
const others = filled.filter((_, i) => i !== leadAt);
const LeadTag = has(lead?.href) ? 'a' : 'div';
// A single other occasion keeps the row layout (photo beside its copy) at every width from 600:
// alone at full width, its photo would outweigh the featured one.
const othersAsRows = others.length === 1;

// Rendered width of each photo (PERF-04), shell max 1520px. The lead: the shell up to 1279, then
// eight of twelve columns. The others: the shell on portrait phones, five twelfths as rows, then a
// half or a third of the shell from 1024.
const leadSizes = '(max-width: 767px) calc(100vw - 2.5rem), (max-width: 1279px) calc(100vw - 4rem), (max-width: 1520px) 64vw, 970px';
const otherSizes = othersAsRows
  ? '(max-width: 599px) calc(100vw - 2.5rem), (max-width: 1520px) 40vw, 600px'
  : others.length === 2
    ? '(max-width: 599px) calc(100vw - 2.5rem), (max-width: 1023px) 40vw, (max-width: 1520px) 48vw, 720px'
    : '(max-width: 599px) calc(100vw - 2.5rem), (max-width: 1023px) 40vw, (max-width: 1520px) 32vw, 480px';
// Portrait phones show the lead tall, on its dedicated vertical photo (DES-09).
const leadMobileMedia = '(max-width: 599px)';
---

{lead && (
  <section class="occ band" aria-labelledby={hasTitle ? headingId : undefined}>
    <div class="shell occ__layout">
      <div class="occ__head" data-reveal>
        <SectionHead title={keepShortWords(title)} text={text} id={headingId} />
        {hasCta && <Button href={cta!.href} variant="primary" class="occ__cta">{cta!.label}</Button>}
      </div>

      <div class="occ__lead" data-reveal style="--i: 1">
        <LeadTag class:list={['occ__tile', LeadTag === 'a' && 'is-link']} href={LeadTag === 'a' ? lead.href : undefined}>
          <span class="occ__media">
            <Picture
              src={lead.image}
              srcMobile={lead.imageMobile}
              mobileMedia={leadMobileMedia}
              alt={lead.imageAlt ?? ''}
              sizes={leadSizes}
              class="occ__img"
            />
          </span>
          <div class="occ__copy">
            <h3 class="occ__title">{keepShortWords(lead.title)}</h3>
            {has(lead.text) && <p class="occ__text">{lead.text}</p>}
          </div>
          {LeadTag === 'a' && <span class="occ__go"><Icon name="arrowUpRight" size={20} /></span>}
        </LeadTag>
      </div>

      {others.length > 0 && (
        <ul class:list={['occ__more', othersAsRows && 'occ__more--rows']} role="list" style={`--n: ${others.length}`}>
          {others.map((it, i) => {
            const Tag = has(it.href) ? 'a' : 'div';
            return (
              <li class="occ__item" style={`--i: ${i + 2}`} data-reveal>
                <Tag class:list={['occ__card', Tag === 'a' && 'is-link']} href={Tag === 'a' ? it.href : undefined}>
                  <span class="occ__photo">
                    <span class="occ__media">
                      <Picture src={it.image} alt={it.imageAlt ?? ''} sizes={otherSizes} class="occ__img" />
                    </span>
                    {Tag === 'a' && <span class="occ__go"><Icon name="arrowUpRight" size={20} /></span>}
                  </span>
                  <div class="occ__body">
                    <h3 class="occ__name">{keepShortWords(it.title)}</h3>
                    {has(it.text) && <p class="occ__line">{it.text}</p>}
                  </div>
                </Tag>
              </li>
            );
          })}
        </ul>
      )}
    </div>
  </section>
)}

<style is:global>
  .occ {
    --accent: var(--color-accent);
    --occ-gap: clamp(0.75rem, 1.5vw, 1.25rem);
    padding-block: clamp(4rem, 9vw, 7rem) clamp(4.5rem, 10vw, 8rem);
  }

  /* One column on phones: the heading, the lead, then the others. */
  .occ__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: clamp(1.75rem, 4vw, 2.25rem);
  }

  /* The intro with the action on its last line (under it when the line is full). */
  .occ__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem clamp(2rem, 6vw, 5rem);
  }
  .occ__cta { min-height: 48px; padding-inline: 1.6rem; }
  .occ__cta:active { transform: translateY(1px); }

  /* ---- Photo boxes, shared by the lead and the others ---- */
  .occ__tile,
  .occ__photo {
    position: relative;
    isolation: isolate;
    display: flex;
    /* Clip, not hidden: no scroll container, so the photo's view timeline follows the page. */
    overflow: clip;
    border-radius: var(--radius-lg);
    background: var(--lift);
  }
  /* The photo's edge on the band: a faint hairline drawn over it, not a border around it. */
  .occ__tile::after,
  .occ__photo::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-foreground) 9%, transparent);
    pointer-events: none;
  }
  .occ__media,
  .occ__media picture,
  .occ__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .occ__media { z-index: -1; }
  .occ__img {
    object-fit: cover;
    object-position: 50% 40%;
    transition: transform calc(var(--duration-slow) * 2.5) var(--ease-out-expo);
  }

  /* ---- The lead: tall on portrait phones (its vertical photo), wide up to 1279, 3:2 from 1280 ---- */
  .occ__tile {
    align-items: flex-end;
    aspect-ratio: 4 / 5;
    color: var(--color-foreground);
    text-decoration: none;
  }
  /* A light gradient from the floor of the photo (DES-09): the photo stays a photo. */
  .occ__tile .occ__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-background) 65%, transparent) 0%,
      transparent 55%
    );
  }
  /* And a shade that follows the caption, however many lines it runs to, so the copy reads on any photo. */
  .occ__copy {
    position: relative;
    isolation: isolate;
    /* Full width, so its shade spans the tile; the lines keep their own measure. */
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: clamp(1.25rem, 3.2vw, 2.75rem);
    text-shadow: 0 1px 12px color-mix(in srgb, var(--color-background) 70%, transparent);
  }
  .occ__copy::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -2.5rem 0 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-background) 58%, transparent) 0%,
      color-mix(in srgb, var(--color-background) 48%, transparent) calc(100% - 2.5rem),
      transparent
    );
  }
  .occ__title {
    margin: 0;
    max-width: 16ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1.12;
    letter-spacing: 0.01em;
    text-wrap: balance;
    transition: color var(--duration-base) var(--ease-out-expo);
  }
  .occ__text {
    margin: 0;
    max-width: 42ch;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-foreground) 88%, var(--color-muted));
    text-wrap: pretty;
  }
  .occ__tile.is-link .occ__copy { padding-right: 4.5rem; }

  /* The lead's photo settles as the section arrives: the one moving thing in the view. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .occ__tile { view-timeline-name: --occ-lead; }
      .occ__tile .occ__media {
        animation-name: occ-settle;
        animation-timing-function: var(--ease-out-expo);
        animation-fill-mode: both;
        animation-timeline: --occ-lead;
        animation-range: entry 0% cover 45%;
      }
    }
  }
  @keyframes occ-settle {
    from { transform: scale(1.08); }
  }

  /* ---- The others: photo with its title and line under it ---- */
  .occ__more {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem var(--occ-gap);
  }
  .occ__item { display: flex; min-width: 0; }
  .occ__card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-radius: var(--radius-lg);
    color: var(--color-foreground);
    text-decoration: none;
  }
  .occ__photo { aspect-ratio: 3 / 2; }
  .occ__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-inline: 0.125rem;
  }
  .occ__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.3rem, 1.8vw, 1.65rem);
    line-height: 1.12;
    letter-spacing: 0.01em;
    text-wrap: balance;
    transition: color var(--duration-base) var(--ease-out-expo);
  }
  .occ__line {
    margin: 0;
    max-width: 40ch;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  /* ---- Link tiles only: an arrow chip in the photo's corner, the photo leaning in on hover and focus ---- */
  .occ__go {
    position: absolute;
    z-index: 2;
    top: clamp(0.75rem, 2vw, 1.5rem);
    right: clamp(0.75rem, 2vw, 1.5rem);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 30%, transparent);
    background: color-mix(in srgb, var(--color-background) 55%, transparent);
    color: var(--color-foreground);
    transition:
      background-color var(--duration-base) var(--ease-out-expo),
      border-color var(--duration-base) var(--ease-out-expo),
      color var(--duration-base) var(--ease-out-expo);
  }
  .occ__go svg { transition: transform var(--duration-slow) var(--ease-out-expo); }
  :is(.occ__tile, .occ__card).is-link { transition: transform var(--duration-fast) var(--ease-out-expo); }
  :is(.occ__tile, .occ__card).is-link:active { transform: translateY(1px) scale(0.99); }
  :is(.occ__tile, .occ__card).is-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  :is(.occ__tile, .occ__card).is-link:focus-visible .occ__img { transform: scale(1.04); }
  :is(.occ__tile, .occ__card).is-link:focus-visible .occ__go {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--color-on-accent);
  }
  @media (hover: hover) {
    :is(.occ__tile, .occ__card).is-link:hover .occ__img { transform: scale(1.04); }
    :is(.occ__tile, .occ__card).is-link:hover :is(.occ__title, .occ__name) { color: var(--color-accent-hover); }
    :is(.occ__tile, .occ__card).is-link:hover .occ__go {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--color-on-accent);
    }
    :is(.occ__tile, .occ__card).is-link:hover .occ__go svg { transform: translate(2px, -2px); }
  }
  @media (prefers-reduced-motion: reduce) {
    :is(.occ__tile, .occ__card).is-link:is(:hover, :focus-visible) .occ__img { transform: none; }
  }

  /* Landscape phones and tablets: the lead goes wide, the others become rows, photo beside the copy. */
  @media (min-width: 600px) {
    .occ__tile { aspect-ratio: 16 / 9; }
    .occ__more { row-gap: var(--occ-gap); }
    .occ__card {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
      gap: clamp(1.25rem, 3vw, 2rem);
    }
  }

  /* From 1024 two or three others stand side by side under the lead, copy under each photo. */
  @media (min-width: 1024px) {
    .occ__more:not(.occ__more--rows) { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); }
    .occ__more:not(.occ__more--rows) .occ__card { display: flex; align-items: stretch; gap: 1.1rem; }
    .occ__layout { row-gap: var(--occ-gap); }
    .occ__head { margin-bottom: clamp(0.75rem, 2vw, 1.5rem); }
  }

  /* From 1280 the heading takes the first four columns and the lead, at its own 3:2, the other eight;
     the others line up beneath, on the same columns. */
  @media (min-width: 1280px) {
    .occ__layout { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--occ-gap); }
    .occ__head {
      grid-column: 1 / span 4;
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 2rem;
      margin: 0;
      padding-right: clamp(1rem, 2vw, 2rem);
    }
    .occ__lead { grid-column: 5 / -1; }
    .occ__more { grid-column: 1 / -1; }
    .occ__tile { aspect-ratio: 3 / 2; }
  }
</style>

---
// Booking block (#prenota), the page's single goal. Until the TicketingHub
// widget is wired, booking happens by phone, WhatsApp or email: the call button
// leads (its label is the number itself), writing is secondary, and hours,
// address (opens Google Maps) and directions sit beside them. Contact data comes
// from settings.json, the copy from the page; an empty field drops its action.

import Icon from '../atoms/Icon.astro';
import settings from '../../data/settings.json';
import { telHref, toE164 } from '../../lib/phone';

interface Props {
  title: string;
  text?: string;
  id?: string;
  headingId?: string;
}

const { title, text, id = 'prenota', headingId = 'booking-title' } = Astro.props;
const { phone, whatsapp, email, address, openingHours, directions } = settings;

const tel = telHref(phone);
// wa.me wants the international number as bare digits, without "+".
const waDigits = toE164(whatsapp).replace(/\D/g, '');
const waHref = waDigits ? `https://wa.me/${waDigits}` : '';
const mapsHref = address
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`
  : '';
const hasInfo = Boolean(openingHours || address || directions);
---

<section class="book" id={id} aria-labelledby={headingId}>
  <div class="shell">
    <div class="book__panel" data-inview>
      <div class="book__main">
        <h2 class="book__title" id={headingId}>{title}</h2>
        {text && <p class="book__text">{text}</p>}

        {(tel || waHref || email) && (
          <div class="book__actions">
            {tel && (
              <a class="book__call" href={tel} aria-label={`Chiama il ${phone}`}>
                <span class="book__call-icon"><Icon name="phone" size={22} /></span>
                <span class="book__call-num">{phone}</span>
              </a>
            )}
            {waHref && (
              <a class="book__write" href={waHref} target="_blank" rel="noopener">
                <Icon name="messageCircle" size={20} />
                <span class="book__write-addr">WhatsApp</span>
                <span class="sr-only">(si apre in una nuova scheda)</span>
              </a>
            )}
            {email && (
              <a class="book__write" href={`mailto:${email}`} aria-label={`Scrivi a ${email}`}>
                <Icon name="mail" size={20} />
                <span class="book__write-addr">{email}</span>
              </a>
            )}
          </div>
        )}
      </div>

      {hasInfo && (
        <ul class="book__info" role="list">
          {openingHours && (
            <li class="book__row">
              <span class="book__row-icon"><Icon name="clock" size={20} /></span>
              <span class="book__row-text">{openingHours}</span>
            </li>
          )}
          {address && (
            <li class="book__row">
              <span class="book__row-icon"><Icon name="mapPin" size={20} /></span>
              <a class="book__row-text book__map" href={mapsHref} target="_blank" rel="noopener">
                {address}
                <span class="sr-only">(apre Google Maps in una nuova scheda)</span>
              </a>
            </li>
          )}
          {directions && (
            <li class="book__row">
              <span class="book__row-icon"><Icon name="route" size={20} /></span>
              <span class="book__row-text">{directions}</span>
            </li>
          )}
        </ul>
      )}
    </div>
  </div>
</section>

<style is:global>
  .book {
    --accent: var(--color-accent);
    padding-block: clamp(3rem, 7vw, 5rem) 0;
  }
  /* The Prenota links move focus here: the ring marks the panel rather than the full-width section. */
  .book:focus { outline: none; }
  .book:focus-visible .book__panel { outline: 2px solid var(--accent); outline-offset: 4px; }

  .book__panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    padding: clamp(1.75rem, 5.5vw, 4.5rem);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background:
      linear-gradient(160deg,
        color-mix(in srgb, var(--accent) 7%, var(--color-surface)) 0%,
        var(--color-surface) 45%);
  }
  /* Accent rule on the top edge: the page's finish line. */
  .book__panel::before {
    content: "";
    position: absolute;
    top: 0;
    left: clamp(1.75rem, 5.5vw, 4.5rem);
    width: clamp(80px, 14vw, 180px);
    height: 3px;
    background: var(--accent);
  }

  .book__title {
    margin: 0;
    max-width: 14ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.3rem, 6vw, 4.5rem);
    line-height: 0.96;
    letter-spacing: 0.005em;
    text-wrap: balance;
  }
  .book__text {
    margin: 1.2rem 0 0;
    max-width: 44ch;
    color: var(--color-muted);
    font-size: clamp(1rem, 1.7vw, 1.15rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .book__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.5rem;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .book__call {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 60px;
    padding: 0.5rem 1.6rem 0.5rem 0.55rem;
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--color-on-accent);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    transition: background-color var(--duration-fast) var(--ease-out-expo), transform var(--duration-fast) var(--ease-out-expo);
  }
  .book__call-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: var(--radius-sm);
    background: var(--color-on-accent);
    color: var(--accent);
  }
  /* "Ringing" ring: three pulses when the panel comes into view, then still (3.3 s, under the 5 s of A11Y-07). */
  .book__call-icon::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-sm);
    border: 2px solid var(--color-on-accent);
    opacity: 0;
  }
  .book__panel.is-armed.is-in .book__call-icon::after {
    animation: book-ring 1.1s var(--ease-out-expo) 0.5s 3;
  }
  @keyframes book-ring {
    from { opacity: 0.7; transform: scale(1); }
    to { opacity: 0; transform: scale(1.6); }
  }
  .book__call:hover { background: var(--color-accent-hover); }
  .book__call:active { transform: translateY(1px) scale(0.98); }
  .book__call:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .book__write {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 48px;
    padding: 0 0.25rem;
    color: var(--color-foreground);
    text-decoration: none;
    font-size: 1rem;
    border-bottom: 2px solid color-mix(in srgb, var(--accent) 50%, transparent);
    transition: color var(--duration-fast) var(--ease-out-expo), border-color var(--duration-fast) var(--ease-out-expo);
  }
  .book__write svg { color: var(--accent); flex: none; }
  .book__write-addr { overflow-wrap: anywhere; }
  .book__write:hover { color: var(--color-accent-hover); border-color: var(--accent); }
  .book__write:active { transform: translateY(1px); }

  .book__info {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }
  .book__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .book__row-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    color: var(--accent);
  }
  .book__row-text {
    font-size: 0.97rem;
    line-height: 1.5;
    color: var(--color-foreground);
    font-variant-numeric: tabular-nums;
  }
  .book__map {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 50%, transparent);
    text-underline-offset: 4px;
    transition: color var(--duration-fast) var(--ease-out-expo), text-decoration-color var(--duration-fast) var(--ease-out-expo);
  }
  .book__map:hover { color: var(--color-accent-hover); text-decoration-color: var(--accent); }

  @media (max-width: 1023px) {
    .book__panel { grid-template-columns: minmax(0, 1fr); align-items: start; }
  }
  @media (max-width: 599px) {
    .book__actions { flex-direction: column; align-items: stretch; }
    .book__call { justify-content: flex-start; }
    .book__write { align-self: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .book__panel.is-armed.is-in .book__call-icon::after { animation: none; }
  }
</style>

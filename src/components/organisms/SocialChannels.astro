---
// The social channels as a reticle across the page column: the site's crosshair mark in the middle
// and the channels on its arms, under a centred heading. From 768 the arms run the width of the
// column, two channels on each side of the mark; on phones they close into a cross, one channel on
// each arm. Each tile is a real link to the profile in settings.social, opening a new tab, with the
// logo and the channel's name; the logos are monochrome and take the accent on hover and focus,
// never their brand colours (DES-04). A channel left empty in the CMS leaves its arm empty; with
// none at all the section does not render.

import Icon from '../atoms/Icon.astro';
import SectionHead from '../molecules/SectionHead.astro';
import settings from '../../data/settings.json';
import { has } from '../../lib/fields';

interface Props {
  title: string;
  text?: string;
  headingId?: string;
}

const { title, text, headingId = 'social-title' } = Astro.props;

const social: Partial<Record<'instagram' | 'facebook' | 'youtube' | 'tiktok', string>> = settings.social ?? {};
// Arms in reading order. `col`: the column on the wide rail (the mark holds the third); `x`, `y`:
// the cell in the phone's 3 × 3 cross (top, left, right, bottom).
const arms = [
  { key: 'instagram', label: 'Instagram', col: 1, x: 2, y: 1 },
  { key: 'facebook', label: 'Facebook', col: 2, x: 1, y: 2 },
  { key: 'youtube', label: 'YouTube', col: 4, x: 3, y: 2 },
  { key: 'tiktok', label: 'TikTok', col: 5, x: 2, y: 3 },
] as const;
const channels = arms.filter((c) => has(social[c.key]));
---

{channels.length > 0 && (
  <section class="soc band" aria-labelledby={has(title) ? headingId : undefined}>
    <div class="shell">
      <div data-reveal>
        <SectionHead title={title} text={text} id={headingId} align="center" />
      </div>

      <div class="soc__reticle">
        {/* The site's mark (public/favicon.svg), drawn without its tile background. */}
        <span class="soc__hub" aria-hidden="true" data-reveal>
          <svg viewBox="10 10 44 44" width="40" height="40" fill="none" stroke="currentColor" stroke-width="4">
            <circle cx="32" cy="32" r="18" />
            <circle cx="32" cy="32" r="8" />
            <circle cx="32" cy="32" r="2.5" fill="currentColor" stroke="none" />
          </svg>
        </span>
        <ul class="soc__list" role="list">
          {channels.map((c, i) => (
            <li class="soc__slot" style={`--col: ${c.col}; --x: ${c.x}; --y: ${c.y}; --i: ${i + 1}`} data-reveal>
              <a class="soc__tile" href={social[c.key]} target="_blank" rel="noopener">
                <Icon name={c.key} size={32} class="soc__logo" />
                <span class="soc__name">{c.label}</span>
                <Icon name="arrowUpRight" size={16} class="soc__out" />
                <span class="sr-only"> (si apre in una nuova scheda)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
)}

<style is:global>
  .soc {
    --accent: var(--color-accent);
    /* Phones: the side of a tile and the gap of the cross, three tiles each way. */
    --soc-s: clamp(5rem, 25vw, 6.5rem);
    --soc-g: 0.6rem;
    /* How far the mark's upright arm reaches past the tiles. */
    --soc-tick: 1.75rem;
    padding-block: clamp(4.5rem, 10vw, 8rem) clamp(5rem, 11vw, 9rem);
  }

  /* The reticle spans the column; on phones its 3 × 3 cross sits in the middle of it. The list
     shares the reticle's grid (subgrid), so the mark and the tiles line up in one set of tracks. */
  .soc__reticle {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(3, var(--soc-s));
    grid-template-rows: repeat(3, var(--soc-s));
    gap: var(--soc-g);
    justify-content: center;
    margin-top: clamp(2.75rem, 6vw, 4.5rem);
  }
  /* The arms: a hairline across the whole column and a short upright through the mark, under
     the opaque tiles, so they show only between them. */
  .soc__reticle::before,
  .soc__reticle::after {
    content: "";
    position: absolute;
    z-index: -1;
    background: var(--color-border);
    pointer-events: none;
  }
  .soc__reticle::before { left: 0; right: 0; top: 50%; height: 1px; }
  .soc__reticle::after { top: calc(-1 * var(--soc-tick)); bottom: calc(-1 * var(--soc-tick)); left: 50%; width: 1px; }

  .soc__list {
    grid-column: 1 / -1;
    grid-row: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .soc__slot { grid-column: var(--x); grid-row: var(--y); }

  .soc__hub {
    grid-column: 2;
    grid-row: 2;
    display: grid;
    place-items: center;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--color-border));
    background: var(--lift-2);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-foreground) 8%, transparent);
    color: var(--accent);
  }

  .soc__tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: 100%;
    height: 100%;
    padding: 0.5rem 0.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: linear-gradient(180deg, var(--lift-2), var(--lift));
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-foreground) 6%, transparent);
    color: var(--color-muted);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out-expo),
      border-color var(--duration-fast) var(--ease-out-expo),
      transform var(--duration-base) var(--ease-out-expo);
  }
  .soc__logo { flex: none; width: 28px; height: 28px; }
  .soc__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.7rem;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-foreground);
    transition: color var(--duration-fast) var(--ease-out-expo);
  }
  /* The way out: a small arrow in the tile's corner, from 768 where the tile has room for it. */
  .soc__out {
    display: none;
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    transition: transform var(--duration-fast) var(--ease-out-expo);
  }

  .soc__tile:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: var(--radius-md);
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .soc__tile:focus-visible .soc__name { color: var(--accent); }
  @media (hover: hover) {
    .soc__tile:hover {
      color: var(--accent);
      border-color: color-mix(in srgb, var(--accent) 55%, transparent);
      transform: translateY(-2px);
    }
    .soc__tile:hover .soc__name { color: var(--accent); }
    .soc__tile:hover .soc__out { transform: translate(2px, -2px); }
  }
  .soc__tile:active { transform: scale(0.98); }

  /* From 768: one row across the column. The mark's column is the mark plus an arm each side;
     the four tiles share the rest. */
  @media (min-width: 768px) {
    .soc {
      --soc-row: clamp(7.5rem, 11vw, 10rem);
      --soc-arm: clamp(1.5rem, 4vw, 3rem);
    }
    .soc__reticle {
      grid-template-columns:
        repeat(2, minmax(0, 1fr))
        calc(var(--soc-row) + 2 * var(--soc-arm))
        repeat(2, minmax(0, 1fr));
      grid-template-rows: var(--soc-row);
      gap: clamp(0.75rem, 1.25vw, 1.25rem);
      justify-content: stretch;
    }
    .soc__slot { grid-column: var(--col); grid-row: 1; }
    .soc__hub {
      grid-column: 3;
      grid-row: 1;
      justify-self: center;
      width: var(--soc-row);
      height: var(--soc-row);
    }
    .soc__hub svg { width: 52px; height: 52px; }
    .soc__tile { gap: 0.75rem; padding: 1rem; }
    .soc__logo { width: 32px; height: 32px; }
    .soc__name { font-size: 0.85rem; letter-spacing: 0.14em; }
    .soc__out { display: block; }
  }
  @media (min-width: 1024px) {
    .soc__logo { width: 40px; height: 40px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .soc__tile:hover { transform: none; }
  }
</style>

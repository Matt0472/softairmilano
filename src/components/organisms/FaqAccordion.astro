---
// FAQ as native <details>/<summary>: keyboard and screen-reader support come
// from the platform, and every answer is in the HTML for crawlers. The page
// builds the FAQPage JSON-LD from the same items. Exclusive: one answer open at a
// time (DES-11). One reading column, title above the list.

import Icon from '../atoms/Icon.astro';
import SectionHead from '../molecules/SectionHead.astro';

interface Item {
  q: string;
  a: string;
}
interface Props {
  title: string;
  items: Item[];
  headingId?: string;
}

const { title, items, headingId = 'faq-title' } = Astro.props;
const list = (items ?? []).filter((it) => it?.q?.trim() && it?.a?.trim());
const hasTitle = !!title?.trim();
---

{list.length > 0 && (
  <section class="faq" aria-labelledby={hasTitle ? headingId : undefined}>
    <div class="shell">
      <div class="faq__col">
        {hasTitle && (
          <div data-reveal>
            <SectionHead title={title} id={headingId} />
          </div>
        )}

        <div class="faq__list" data-reveal style="--i: 1">
          {list.map((it) => (
            <details class="faq__item" name={headingId}>
              <summary class="faq__q">
                <span class="faq__q-text">{it.q}</span>
                <span class="faq__icon"><Icon name="plus" size={18} /></span>
              </summary>
              <div class="faq__a"><p>{it.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

<style is:global>
  .faq {
    --accent: var(--color-accent);
    padding-block: clamp(4rem, 9vw, 7rem) clamp(4.5rem, 10vw, 8rem);
  }
  /* A single reading column, centred in the page: breaks the run of side-by-side sections. */
  .faq__col { max-width: 56rem; margin-inline: auto; }

  .faq__list {
    margin-top: clamp(2rem, 4.5vw, 3rem);
    border-top: 1px solid var(--color-border);
  }
  .faq__item { border-bottom: 1px solid var(--color-border); }

  .faq__q {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 44px;
    padding: 1.3rem 0.25rem;
    font-size: clamp(1.02rem, 1.5vw, 1.15rem);
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-foreground);
    transition: color var(--duration-fast) var(--ease-out-expo);
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:hover { color: var(--color-accent-hover); }
  .faq__q:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  .faq__q-text { text-wrap: pretty; }

  .faq__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    color: var(--accent);
    transition:
      transform var(--duration-slow) var(--ease-out-expo),
      background-color var(--duration-base) var(--ease-out-expo),
      border-color var(--duration-base) var(--ease-out-expo),
      color var(--duration-base) var(--ease-out-expo);
  }
  .faq__q:hover .faq__icon { border-color: color-mix(in srgb, var(--accent) 55%, transparent); }
  .faq__q:active .faq__icon { transform: scale(0.94); }
  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
    background: var(--accent);
    border-color: var(--accent);
    color: var(--color-on-accent);
  }

  .faq__a { padding: 0 3.5rem 1.5rem 0.25rem; }
  .faq__a p {
    margin: 0;
    max-width: 62ch;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.65;
    text-wrap: pretty;
  }
  .faq__item[open] .faq__a { animation: faq-open var(--duration-slow) var(--ease-out-expo); }
  @keyframes faq-open {
    from { opacity: 0; transform: translate3d(0, -0.4rem, 0); }
  }

  @media (max-width: 599px) {
    .faq__q { padding-block: 1.1rem; }
    .faq__a { padding-right: 0.25rem; }
  }
</style>

<script>
  // Exclusive accordion: the shared `name` makes opening one answer close the others natively.
  // Older engines ignore `name`, so replicate it there.
  if (!('name' in HTMLDetailsElement.prototype)) {
    for (const item of document.querySelectorAll<HTMLDetailsElement>('.faq__item[name]')) {
      item.addEventListener('toggle', () => {
        if (!item.open) return;
        for (const other of document.querySelectorAll<HTMLDetailsElement>(`.faq__item[name="${item.getAttribute('name')}"]`)) {
          if (other !== item) other.open = false;
        }
      });
    }
  }
</script>

---
// "L'arena": the arena in one figure and four features. The surface ("1.500 m²") is the focal
// point, rolling in like the inner heroes' facts (Odometer) when the section arrives, with the
// radar sweeping behind it: the only thing here that keeps moving, and only while it is on screen.
// The features stand in columns divided by hairlines, each opening on its emblem (picked in the
// CMS) in a sight like the mission files' (ModeGrid); pointing at one locks the sight on. The
// features are not links, so nothing promises a click. The section is the #arena anchor, the
// target of the hero's secondary link. On the narrowest phones the features go one per row.

import type { ComponentProps } from 'astro/types';
import Icon from '../atoms/Icon.astro';
import Odometer from '../atoms/Odometer.astro';
import SectionHead from '../molecules/SectionHead.astro';
import { has } from '../../lib/fields';

type IconName = ComponentProps<typeof Icon>['name'];

interface Stat {
  value: string;
  unit?: string;
  label?: string;
}
interface Feature {
  icon?: string;
  title: string;
  text?: string;
}
interface Cta {
  label?: string;
  href?: string;
}
interface Props {
  title: string;
  text?: string;
  stat?: Stat;
  features: Feature[];
  cta?: Cta;
  headingId?: string;
}

// The emblems the CMS offers (arena.features.icon in .pages.yml): any other value draws none.
const EMBLEMS: IconName[] = ['hangar', 'roof', 'umbrella', 'bulb', 'floodlight', 'moon', 'cycle', 'layout', 'wrench', 'speaker', 'equalizer', 'note'];

const { title, text, stat, features, cta, headingId = 'arena-title' } = Astro.props;
const list = (features ?? [])
  .filter((f) => has(f?.title))
  .map((f) => ({ ...f, emblem: EMBLEMS.find((e) => e === f.icon) }));
const hasTitle = has(title);
const figure = has(stat?.value) ? stat : undefined;
// A link emptied in the CMS (or not yet pointing anywhere) disappears instead of rendering blank.
const link = has(cta?.label) && has(cta?.href) ? cta : undefined;
---

<section class="arena band" id="arena" aria-labelledby={hasTitle ? headingId : undefined} data-arena>
  <div class="arena__clip">
    <div class="shell">
      <div class="arena__top">
        <div class="arena__intro">
          <SectionHead title={title} text={text} id={headingId} />
          {link && (
            <a class="arena__cta" href={link.href}>
              {link.label}<Icon name="arrowRight" size={18} class="arena__arrow" />
            </a>
          )}
        </div>
        {figure && (
          <p class="arena__figure">
            <span class="arena__value">
              <span class="arena__radar" aria-hidden="true"></span>
              <Odometer value={figure.value} />{figure.unit?.trim() && <span class="arena__unit">{figure.unit}</span>}
            </span>
            {figure.label?.trim() && <span class="arena__label">{figure.label}</span>}
          </p>
        )}
      </div>

      {list.length > 0 && (
        <ul class="arena__feats" role="list" style={`--n: ${list.length}`}>
          {list.map((f) => (
            <li class="arena__feat">
              {f.emblem && (
                <span class="arena__sight" aria-hidden="true">
                  <span class="corners arena__sight-rest"></span>
                  <Icon name={f.emblem} size={34} class="arena__emblem" />
                  <span class="corners arena__sight-lock"></span>
                </span>
              )}
              <h3 class="arena__feat-title">{f.title}</h3>
              {f.text?.trim() && <p class="arena__feat-text">{f.text}</p>}
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>

<style is:global>
  .arena {
    --accent: var(--color-accent);
    /* Inner padding of a feature column. */
    --px: clamp(1rem, 2.4vw, 2.25rem);
  }
  /* The band's padding lives here, so the radar can fill it and still be clipped by the band
     without clipping the band's own seam. */
  .arena__clip {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 9vw, 7rem) clamp(4.5rem, 10vw, 8rem);
  }

  .arena__top {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "intro" "figure";
    row-gap: clamp(2.25rem, 6vw, 3rem);
  }
  /* The copy stays above the radar, which lives in the figure's layer. */
  .arena__intro { grid-area: intro; position: relative; z-index: 2; }

  .arena__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-foreground);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }
  .arena__cta:hover { color: var(--color-accent-hover); }
  .arena__arrow { transition: transform var(--duration-fast) var(--ease-out-expo); }
  .arena__cta:hover .arena__arrow { transform: translateX(4px); }

  /* The figure: the number in the display face, its unit in the accent, the label under it. */
  .arena__figure {
    grid-area: figure;
    position: relative;
    z-index: 1;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .arena__value {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(4.75rem, 21vw, 10.5rem);
    line-height: 1;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-foreground);
    --odo-delay: 0.25s;
  }
  .arena__unit {
    margin-left: 0.1em;
    font-size: 0.42em;
    color: var(--accent);
  }
  .arena__label {
    margin-top: 0.85rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(0.9rem, 1.4vw, 1.05rem);
    line-height: 1.3;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  /* A figure below the fold waits to roll until it is seen. */
  .arena.is-armed .odo__reel { animation-play-state: paused; }

  /* The radar turns behind the number, centred on it. Fixed size and margin-centred (no
     translate), so it turns in place and reads the same on any width. */
  .arena__radar {
    position: absolute;
    z-index: -1;
    pointer-events: none;
    left: 50%;
    top: 50%;
    width: 34rem;
    height: 34rem;
    margin: -17rem 0 0 -17rem;
    border-radius: 50%;
    background:
      conic-gradient(from 0deg, transparent 0deg, color-mix(in srgb, var(--accent) 20%, transparent) 28deg, transparent 42deg),
      repeating-radial-gradient(circle, transparent 0 calc(6.5rem - 1px), color-mix(in srgb, var(--color-foreground) 7%, transparent) calc(6.5rem - 1px) 6.5rem);
    mask-image: radial-gradient(closest-side, var(--color-background) 35%, transparent);
    /* Linear on purpose: a sweep turns at constant speed. */
    animation: arena-sweep calc(var(--duration-slow) * 20) linear infinite paused;
  }
  .arena.is-on .arena__radar { animation-play-state: running; }
  @keyframes arena-sweep { to { transform: rotate(360deg); } }

  /* Features: the hairlines are the plane showing through 1px gaps between opaque columns, so
     they follow any count; the colour stops 1px short of the outer edge. */
  .arena__feats {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    border-top: 1px solid var(--color-border);
    background: linear-gradient(var(--color-border), var(--color-border)) center / calc(100% - 2px) calc(100% - 2px) no-repeat;
  }
  .arena__feat {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2.25rem) var(--px) 0.25rem;
    background: var(--plane);
  }
  /* The outer columns line up with the page column. */
  .arena__feat:nth-child(odd) { padding-left: 0; }
  .arena__feat:nth-child(even) { padding-right: 0; }
  .arena__feat:nth-child(n + 3) { padding-top: clamp(1.75rem, 4vw, 2.25rem); }

  /* The emblem's sight: steel corners at rest; the accent pair closes in on a pointed feature. */
  .arena__sight {
    --arm: 9px;
    position: relative;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    margin-bottom: clamp(1.1rem, 2vw, 1.5rem);
    color: var(--accent);
  }
  .arena__sight-rest { color: var(--color-steel); }
  .arena__sight-lock {
    opacity: 0;
    transform: scale(1.35);
    transition:
      opacity var(--duration-base) var(--ease-out-expo),
      transform var(--duration-slow) var(--ease-out-expo);
  }
  /* Thinner than the 24px grid's stroke 2, so the line art stays fine at this size. */
  .arena__emblem { stroke-width: 1.5; }

  .arena__feat-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    letter-spacing: 0.03em;
    text-wrap: balance;
  }
  .arena__feat-text {
    margin: 0.5rem 0 0;
    max-width: 34ch;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  @media (hover: hover) {
    .arena__feat:hover .arena__sight-lock { opacity: 1; transform: none; }
  }

  /* Narrow phones: the sight shrinks so two columns of copy keep their measure. */
  @media (max-width: 399px) {
    .arena { --px: 0.9rem; }
    .arena__sight { --arm: 7px; width: 3.25rem; height: 3.25rem; }
    .arena__emblem { width: 28px; height: 28px; }
  }
  /* The narrowest phones: two columns would leave ~15 characters a line, so one feature per row,
     its emblem beside the title and the text. */
  @media (max-width: 359px) {
    .arena__feats { grid-template-columns: minmax(0, 1fr); }
    .arena__feat:nth-child(n) { padding: 1.5rem 0; }
    .arena__feat:last-child { padding-bottom: 0.25rem; }
    .arena__feat:has(.arena__sight) {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 1rem;
      align-content: start;
    }
    .arena__feat:has(.arena__sight) .arena__sight { grid-row: span 2; margin-bottom: 0; }
  }

  @media (min-width: 768px) {
    .arena__radar { width: 40rem; height: 40rem; margin: -20rem 0 0 -20rem; }
  }

  /* Desktop: the copy on the left, the figure against the right edge, on the copy's baseline;
     the four features in one row. */
  @media (min-width: 1024px) {
    .arena__top {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: "intro figure";
      column-gap: clamp(2rem, 5vw, 5rem);
      align-items: end;
    }
    .arena__figure { align-items: flex-end; text-align: right; }
    .arena__feats { grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr)); }
    .arena__feat:nth-child(n) { padding: clamp(1.75rem, 3vw, 2.5rem) var(--px) 0.25rem; }
    .arena__feat:first-child { padding-left: 0; }
    .arena__feat:last-child { padding-right: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .arena__radar { animation: none; }
    .arena__sight-lock { transform: none; }
  }
</style>

<script>
  // One observer: the radar turns only while the section is on screen, and a figure that starts
  // below the fold is held at zero until it is first seen. Without JS everything is already there.
  const root = document.querySelector<HTMLElement>('[data-arena]');
  if (root && 'IntersectionObserver' in window) {
    let first = true;
    new IntersectionObserver(
      ([entry]) => {
        if (first) {
          first = false;
          if (!entry.isIntersecting && entry.boundingClientRect.top > 0) root.classList.add('is-armed');
        }
        root.classList.toggle('is-on', entry.isIntersecting);
        if (entry.isIntersecting) root.classList.remove('is-armed');
      },
      { threshold: 0.2 }
    ).observe(root);
  }
</script>

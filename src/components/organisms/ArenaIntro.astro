---
// "L'arena in breve" — short pitch + 4 feature cards, between hero and activities.
// Animation ("mix"): per-card target-lock brackets, then the icon draws itself,
// with a continuous radar sweep and a one-shot scanline; the m² stat counts up.
// Triggered on viewport entry; static + fully legible under prefers-reduced-motion.

interface Stat {
  value: string;
  unit: string;
}
interface Feature {
  icon: string;
  title: string;
  text: string;
}
interface Cta {
  label: string;
  href: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  stat?: Stat;
  features: Feature[];
  cta?: Cta;
}

const { eyebrow, title, text, stat, features, cta } = Astro.props;

// Line-icon library (inner SVG only). `pathLength="1"` lets each shape "draw in".
// The CMS `icon` field picks one of these keys per feature.
const ICONS: Record<string, string> = {
  hangar: '<path pathLength="1" d="M22 8.35V20a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8.35a2 2 0 0 1 1.26-1.85l8-3.2a2 2 0 0 1 1.48 0l8 3.2A2 2 0 0 1 22 8.35Z"/><path pathLength="1" d="M6 18h12"/><path pathLength="1" d="M6 14h12"/>',
  roof: '<path pathLength="1" d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
  umbrella: '<path pathLength="1" d="M2 12a10 10 0 0 1 20 0Z"/><path pathLength="1" d="M12 12v7a2 2 0 0 0 4 0"/><path pathLength="1" d="M12 2v1.5"/>',
  bulb: '<path pathLength="1" d="M9 18h6"/><path pathLength="1" d="M10 22h4"/><path pathLength="1" d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5.76.76 1.23 1.52 1.41 2.5"/>',
  floodlight: '<rect pathLength="1" x="9" y="2" width="6" height="3.5" rx="1"/><path pathLength="1" d="M12 5.5 6.5 21h11z"/>',
  moon: '<path pathLength="1" d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
  cycle: '<path pathLength="1" d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path pathLength="1" d="M3 3v5h5"/><path pathLength="1" d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path pathLength="1" d="M21 21v-5h-5"/>',
  layout: '<rect pathLength="1" x="3" y="3" width="7" height="7" rx="1"/><rect pathLength="1" x="14" y="3" width="7" height="7" rx="1"/><rect pathLength="1" x="14" y="14" width="7" height="7" rx="1"/><rect pathLength="1" x="3" y="14" width="7" height="7" rx="1"/>',
  wrench: '<path pathLength="1" d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  speaker: '<path pathLength="1" d="M11 5 6 9H2v6h4l5 4z"/><path pathLength="1" d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path pathLength="1" d="M19.07 4.93a10 10 0 0 1 0 14.14"/>',
  equalizer: '<line pathLength="1" x1="4" y1="10" x2="4" y2="14"/><line pathLength="1" x1="8" y1="6" x2="8" y2="18"/><line pathLength="1" x1="12" y1="3" x2="12" y2="21"/><line pathLength="1" x1="16" y1="7" x2="16" y2="17"/><line pathLength="1" x1="20" y1="10" x2="20" y2="14"/>',
  note: '<path pathLength="1" d="M9 18V5l12-2v13"/><circle pathLength="1" cx="6" cy="18" r="3"/><circle pathLength="1" cx="18" cy="16" r="3"/>',
};
---

<section class="arena-wrap">
  <div class="shell">
    <div class="arena-block" aria-label={title}>
      <div class="gridbg" aria-hidden="true"></div>
      <div class="radar" aria-hidden="true"></div>
      <div class="scan" aria-hidden="true"></div>

      <div class="head">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        {stat && (
          <div class="stat"><b class="js-sqm">{stat.value}</b> {stat.unit}</div>
        )}
      </div>
      <h2 class="title">{title}</h2>
      {text && <p class="intro">{text}</p>}

      <div class="grid">
        {features.map((f) => (
          <article class="feat">
            <span class="corner tl"></span><span class="corner tr"></span>
            <span class="corner bl"></span><span class="corner br"></span>
            <span class="lock" aria-hidden="true">● LOCK</span>
            <div class="iconwrap">
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[f.icon] ?? ICONS.hangar}></svg>
            </div>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </article>
        ))}
      </div>

      {cta && (
        <div class="cta">
          <a href={cta.href}>{cta.label} <span class="arw" aria-hidden="true">→</span></a>
        </div>
      )}
    </div>
  </div>
</section>

<style is:global>
  .arena-wrap { padding-block: clamp(3rem, 7vw, 5.5rem); }

  .arena-block {
    position: relative; isolation: isolate; overflow: hidden;
    border: 1px solid var(--color-border); border-radius: 1.25rem;
    background: var(--color-surface);
    padding: clamp(1.75rem, 5vw, 3.5rem);
  }

  .arena-block .gridbg {
    position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: 0.12;
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 44px 44px;
    -webkit-mask-image: radial-gradient(120% 90% at 50% 0%, #000 30%, transparent 75%);
    mask-image: radial-gradient(120% 90% at 50% 0%, #000 30%, transparent 75%);
  }

  /* Fixed size + margin-based centering (no translate), so it spins in place and
     looks identical regardless of the content width. */
  .arena-block .radar {
    position: absolute; left: 50%; top: -30%; margin-left: -900px;
    width: 1800px; height: 1800px;
    transform-origin: center; z-index: 0; pointer-events: none; opacity: 0.9;
    border-radius: 50%; will-change: transform;
    background: conic-gradient(from 0deg, transparent 0deg,
      color-mix(in srgb, var(--color-accent) 22%, transparent) 26deg, transparent 40deg);
    animation: aRadar 8s linear infinite; animation-play-state: paused;
  }
  .arena-block.in-view .radar { animation-play-state: running; }
  @keyframes aRadar { from { transform: rotate(0); } to { transform: rotate(360deg); } }
  @media (max-width: 640px) {
    /* The stacked cards make the section tall → a big radar centred both ways so
       the sweep reaches every card. */
    .arena-block .radar {
      width: 1600px; height: 1600px;
      left: 50%; top: 50%; margin-left: -800px; margin-top: -800px;
    }
  }

  .arena-block .scan {
    position: absolute; left: 0; right: 0; height: 2px; top: 0; z-index: 4;
    pointer-events: none; opacity: 0; mix-blend-mode: screen;
    background: linear-gradient(90deg, transparent,
      color-mix(in srgb, var(--color-accent) 70%, transparent), transparent);
  }
  .arena-block.go .scan { animation: aScan 2s ease-in-out forwards; }
  @keyframes aScan {
    0% { top: 2%; opacity: 0; } 12% { opacity: 0.6; }
    88% { opacity: 0.6; } 100% { top: 98%; opacity: 0; }
  }

  .arena-block .head {
    position: relative; z-index: 5; display: flex; flex-wrap: wrap;
    align-items: flex-end; justify-content: space-between; gap: 1rem;
  }
  .arena-block .eyebrow {
    margin: 0; font-family: var(--font-display); font-size: 0.78rem;
    letter-spacing: 0.26em; text-transform: uppercase; color: var(--color-accent);
    display: flex; align-items: center; gap: 0.7rem;
  }
  .arena-block .eyebrow::before { content: ""; width: 30px; height: 2px; background: var(--color-accent); }
  .arena-block .stat {
    font-family: var(--font-display); font-weight: 700; letter-spacing: 0.02em;
    font-size: clamp(1.25rem, 3vw, 1.85rem); color: var(--color-foreground);
  }
  .arena-block .stat b { color: var(--color-accent); font-variant-numeric: tabular-nums; }

  .arena-block .title {
    position: relative; z-index: 5; margin: 0.5rem 0 0;
    font-family: var(--font-display); font-weight: 700; text-transform: uppercase;
    font-size: clamp(2rem, 5.5vw, 3.4rem); line-height: 1; letter-spacing: 0.01em;
  }
  .arena-block .intro {
    position: relative; z-index: 5; margin: 1rem 0 0; max-width: 58ch;
    color: var(--color-muted); font-size: clamp(1rem, 1.6vw, 1.12rem); line-height: 1.55;
  }

  .arena-block .grid {
    position: relative; z-index: 5; margin-top: clamp(1.75rem, 4vw, 2.75rem);
    display: grid; gap: 0.9rem; grid-template-columns: repeat(4, 1fr);
  }
  @media (max-width: 820px) { .arena-block .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 460px) { .arena-block .grid { grid-template-columns: 1fr; } }

  .arena-block .feat {
    position: relative; padding: 1.4rem 1.25rem; border-radius: 0.9rem;
    background: color-mix(in srgb, var(--color-surface-2) 60%, transparent);
    border: 1px solid transparent; transition: border-color 0.2s, background 0.2s;
  }
  .arena-block .feat:hover {
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    background: color-mix(in srgb, var(--color-surface-2) 92%, transparent);
  }

  .arena-block .corner {
    position: absolute; width: 13px; height: 13px;
    border: 2px solid var(--color-accent); opacity: 0;
  }
  .arena-block .corner.tl { left: 8px; top: 8px; border-right: 0; border-bottom: 0; }
  .arena-block .corner.tr { right: 8px; top: 8px; border-left: 0; border-bottom: 0; }
  .arena-block .corner.bl { left: 8px; bottom: 8px; border-right: 0; border-top: 0; }
  .arena-block .corner.br { right: 8px; bottom: 8px; border-left: 0; border-top: 0; }
  .arena-block.go .corner { animation: aLockIn 0.45s ease forwards; }
  @keyframes aLockIn { from { opacity: 0; transform: scale(1.7); } to { opacity: 1; transform: scale(1); } }

  .arena-block .lock {
    position: absolute; right: 11px; top: 11px; opacity: 0;
    font-family: var(--font-display); font-size: 9px; letter-spacing: 0.14em;
    color: var(--color-accent);
  }
  .arena-block.go .lock { animation: aLockLbl 0.4s steps(2) forwards; }
  @keyframes aLockLbl { from { opacity: 0; } to { opacity: 0.85; } }

  .arena-block .iconwrap { width: 52px; height: 52px; margin-bottom: 1rem; }
  .arena-block .ico { width: 52px; height: 52px; display: block; }
  .arena-block .ico :is(path, circle, line, rect) {
    fill: none; stroke: var(--color-accent); stroke-width: 2;
    stroke-linecap: round; stroke-linejoin: round; stroke-dashoffset: 0;
  }
  .arena-block.go .ico :is(path, circle, line, rect) {
    stroke-dasharray: 1; stroke-dashoffset: 1; animation: aDraw 0.85s ease forwards;
  }
  @keyframes aDraw { to { stroke-dashoffset: 0; } }

  /* Per-card stagger: brackets lock on, then the icon assembles. */
  .arena-block.go .feat:nth-child(1) :is(.corner, .lock) { animation-delay: 0.1s; }
  .arena-block.go .feat:nth-child(1) .ico :is(path, circle, line, rect) { animation-delay: 0.32s; }
  .arena-block.go .feat:nth-child(2) :is(.corner, .lock) { animation-delay: 0.4s; }
  .arena-block.go .feat:nth-child(2) .ico :is(path, circle, line, rect) { animation-delay: 0.62s; }
  .arena-block.go .feat:nth-child(3) :is(.corner, .lock) { animation-delay: 0.7s; }
  .arena-block.go .feat:nth-child(3) .ico :is(path, circle, line, rect) { animation-delay: 0.92s; }
  .arena-block.go .feat:nth-child(4) :is(.corner, .lock) { animation-delay: 1s; }
  .arena-block.go .feat:nth-child(4) .ico :is(path, circle, line, rect) { animation-delay: 1.22s; }

  .arena-block .feat h3 {
    margin: 0 0 0.35rem; font-family: var(--font-display); font-weight: 600;
    text-transform: uppercase; font-size: 1.05rem; letter-spacing: 0.03em;
  }
  .arena-block .feat p { margin: 0; color: var(--color-muted); font-size: 0.9rem; line-height: 1.5; }

  .arena-block .cta { position: relative; z-index: 5; margin-top: clamp(1.75rem, 3vw, 2.5rem); }
  .arena-block .cta a {
    display: inline-flex; align-items: center; gap: 0.55rem;
    font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.04em;
    font-weight: 600; color: var(--color-foreground); text-decoration: none;
    border-bottom: 2px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    padding-bottom: 3px; transition: color 0.18s;
  }
  .arena-block .cta a:hover { color: var(--color-accent-hover); }
  .arena-block .cta a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .arena-block .cta .arw { transition: transform 0.18s; }
  .arena-block .cta a:hover .arw { transform: translateX(5px); }

  @media (prefers-reduced-motion: reduce) {
    .arena-block *, .arena-block *::before { animation: none !important; transition: none !important; }
    .arena-block .radar { opacity: 0.35; }
    .arena-block .corner { opacity: 0.7; }
    .arena-block .lock { opacity: 0.85; }
    .arena-block .ico :is(path, circle, line, rect) { stroke-dashoffset: 0 !important; }
  }
</style>

<script>
  const el = document.querySelector('.arena-block');
  if (el) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const b = el.querySelector<HTMLElement>('.js-sqm');
    const finalText = b?.textContent ?? '';
    const target = parseInt(finalText.replace(/\D/g, ''), 10) || 0;
    let played = false;

    const count = () => {
      if (!b || reduce || !target) return;
      const t0 = performance.now();
      const step = (t: number) => {
        const p = Math.min(1, (t - t0) / 1200);
        const e = 1 - Math.pow(1 - p, 3);
        b.textContent = Math.round(target * e).toLocaleString('it-IT');
        if (p < 1) requestAnimationFrame(step);
        else b.textContent = finalText;
      };
      requestAnimationFrame(step);
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              el.classList.add('in-view');
              if (!played) { played = true; el.classList.add('go'); count(); }
            } else {
              el.classList.remove('in-view');
            }
          });
        },
        { threshold: 0.35 }
      );
      io.observe(el);
    } else {
      el.classList.add('go', 'in-view');
    }
  }
</script>

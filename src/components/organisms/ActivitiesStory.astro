---
// "Le attività" — Interactive Scrolling Story with a military "transmission"
// text stream (teletype + cursor, CoD-briefing style). A tall track pins a
// full-viewport split stage; scrolling advances the active activity, and after
// scrolling stops the view snaps to the nearest activity so its transmission
// completes. Uses the site-wide Lenis instance (window.__lenis) for snapping.
// Desktop: pinned scroll story. Mobile: scenes stack (image + copy).
// Fully static and legible under prefers-reduced-motion.

interface Activity {
  title: string;
  desc: string;
  pills?: string[];
  image: string;
  imageMobile?: string;
  imageAlt?: string;
  href: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  items: Activity[];
}

const { eyebrow = 'Cosa si fa', title, intro, items } = Astro.props;
const toWebp = (p: string): string => p.replace(/\.(jpe?g|png)$/i, '.webp');
const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<section class="acts-story" data-acts>
  <div class="as__head shell">
    <p class="as__eyebrow">{eyebrow}</p>
    <h2 class="as__title">{title}</h2>
    {intro && <p class="as__intro">{intro}</p>}
  </div>

  <div class="as__track" data-track>
    <div class="as__stage">
      {items.map((a, i) => (
        <article class="scene" data-scene data-i={i}>
          <div class="scene__copy">
            <p class="scene__sig">// CANALE 0{i + 1} · TRASMISSIONE IN ARRIVO</p>
            <p class="scene__num"><b>{pad(i)}</b><span>/ {pad(items.length - 1)}</span></p>
            <h3 class="scene__title" data-final={a.title}>{a.title}</h3>
            <p class="scene__desc" data-final={a.desc}>{a.desc}</p>
            {a.pills && a.pills.length > 0 && (
              <ul class="scene__pills">{a.pills.map((p) => <li>{p}</li>)}</ul>
            )}
            <a class="scene__cta" href={a.href}>Scopri {a.title} <span aria-hidden="true">&rarr;</span></a>
          </div>
          <figure class="scene__media">
            <picture>
              {a.imageMobile && <source media="(max-width: 820px)" type="image/webp" srcset={toWebp(a.imageMobile)} />}
              {a.imageMobile && <source media="(max-width: 820px)" srcset={a.imageMobile} />}
              <source type="image/webp" srcset={toWebp(a.image)} />
              <img src={a.image} alt={a.imageAlt ?? a.title} loading="lazy" decoding="async" />
            </picture>
            <span class="scene__frame" aria-hidden="true"></span>
          </figure>
        </article>
      ))}
      <div class="as__dots" data-dots aria-hidden="true">
        {items.map((_, i) => <button class="as__dot" data-dot={i}><i></i></button>)}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .acts-story { --ink: var(--color-background); --amber: var(--color-accent); border-top: 1px solid var(--color-border); }
  .acts-story .as__head { padding-block: clamp(2rem, 5vw, 3.25rem) 0; }
  .acts-story .as__eyebrow { margin: 0; font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.26em; color: var(--amber); font-size: 0.78rem; display: flex; align-items: center; gap: 0.75rem; }
  .acts-story .as__eyebrow::before { content: ""; width: 34px; height: 2px; background: var(--amber); }
  .acts-story .as__title { margin: 0.5rem 0 0; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; line-height: 1; font-size: clamp(2rem, 5.5vw, 3.4rem); }
  .acts-story .as__intro { margin: 1rem 0 0; max-width: 58ch; color: var(--color-muted); font-size: clamp(1rem, 1.6vw, 1.12rem); line-height: 1.55; }

  .acts-story .as__track { position: relative; height: 400vh; margin-top: clamp(0.5rem, 2vh, 1.25rem); }
  .acts-story .as__stage { position: sticky; top: 0; height: 100svh; overflow: hidden; }

  .acts-story .scene { position: absolute; inset: 0; max-width: 1520px; margin-inline: auto; display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); align-items: start; gap: clamp(1.5rem, 4vw, 3.5rem); padding: clamp(1.75rem, 6vh, 4rem) 1.25rem clamp(1rem, 3vh, 2rem); opacity: 0; pointer-events: none; transition: opacity 0.5s var(--ease-out-expo); }
  @media (min-width: 768px) { .acts-story .scene { padding-inline: 2rem; } }
  .acts-story .scene.on { opacity: 1; pointer-events: auto; }
  .acts-story .scene__copy { max-width: 42rem; }
  .acts-story .scene__sig { margin: 0 0 0.9rem; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.74rem; letter-spacing: 0.14em; color: var(--amber); opacity: 0; }
  .acts-story .scene.on .scene__sig { opacity: 0.9; transition: opacity 0.4s ease; }
  .acts-story .scene__num { margin: 0 0 1rem; font-family: var(--font-display); letter-spacing: 0.16em; color: var(--color-steel); font-size: 0.9rem; display: flex; gap: 0.5rem; align-items: baseline; }
  .acts-story .scene__num b { color: var(--amber); font-size: 1.4rem; }
  .acts-story .scene__title { margin: 0; min-height: 1.1em; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; line-height: 0.92; font-size: clamp(2.4rem, 6vw, 5rem); }
  .acts-story .scene__desc { margin: 1.2rem 0 0; max-width: 52ch; min-height: 4.6em; color: var(--color-foreground); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: clamp(0.9rem, 1.3vw, 1rem); line-height: 1.65; }
  .acts-story .scene__pills { list-style: none; margin: 1.4rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; opacity: 0; }
  .acts-story .scene.on .scene__pills { opacity: 1; transition: opacity 0.4s ease 0.2s; }
  .acts-story .scene__pills li { font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.72rem; padding: 0.4rem 0.8rem; border-radius: 999px; border: 1px solid var(--color-border); color: var(--color-foreground); }
  .acts-story .scene__cta { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.75rem; background: var(--amber); color: var(--color-on-accent); font-family: var(--font-display); text-transform: uppercase; font-weight: 600; letter-spacing: 0.04em; padding: 0.8rem 1.5rem; border-radius: var(--radius-md); text-decoration: none; opacity: 0; transition: background 0.18s; }
  .acts-story .scene.on .scene__cta { opacity: 1; transition: opacity 0.4s ease 0.35s, background 0.18s; }
  .acts-story .scene__cta:hover { background: var(--color-accent-hover); }
  .acts-story .scene__cta:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }

  .acts-story .cursor { display: inline-block; width: 0.55em; height: 1em; background: var(--amber); vertical-align: -0.12em; margin-left: 0.08em; animation: as-cur 1s steps(1) infinite; }
  @keyframes as-cur { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }

  .acts-story .scene__media { position: relative; margin: 0; height: min(74vh, 640px); border-radius: 16px; overflow: hidden; border: 1px solid color-mix(in srgb, var(--amber) 25%, transparent); transform: translateX(40px) scale(1.02); opacity: 0; transition: transform 0.7s var(--ease-out-expo), opacity 0.7s ease; }
  .acts-story .scene.on .scene__media { transform: none; opacity: 1; }
  .acts-story .scene__media picture, .acts-story .scene__media img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .acts-story .scene__media img { object-fit: cover; display: block; }
  .acts-story .scene__frame { position: absolute; inset: 12px; border: 1px solid color-mix(in srgb, var(--amber) 35%, transparent); pointer-events: none; }

  .acts-story .as__dots { position: absolute; left: 50%; bottom: 26px; transform: translateX(-50%); z-index: 6; display: flex; gap: 10px; }
  .acts-story .as__dot { width: 46px; height: 4px; padding: 0; border: 0; background: color-mix(in srgb, var(--color-foreground) 22%, transparent); border-radius: 999px; overflow: hidden; cursor: pointer; }
  .acts-story .as__dot i { display: block; height: 100%; width: 0; background: var(--amber); }
  .acts-story .as__dot.active i { width: 100%; transition: width 0.3s linear; }
  .acts-story .as__dot.done i { width: 100%; }

  /* Mobile: pinned scroll story as a full-bleed image (subject-focused portrait
     crop) with the copy overlaid at the bottom over a dark gradient. */
  @media (max-width: 820px) {
    .acts-story .scene { grid-template-columns: 1fr; max-width: none; padding: 0; }
    .acts-story .scene__media { position: absolute; inset: 0; height: auto; transform: none; opacity: 1; border: 0; border-radius: 0; }
    .acts-story .scene.on .scene__media { transform: none; opacity: 1; }
    .acts-story .scene__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, var(--ink) 36%, color-mix(in srgb, var(--ink) 55%, transparent) 60%, transparent 86%); }
    .acts-story .scene__frame { display: none; }
    .acts-story .scene__copy { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; max-width: none; padding: 1.5rem 1.25rem clamp(3rem, 12vh, 5rem); }
    .acts-story .scene__title { font-size: clamp(2.2rem, 10vw, 3.4rem); text-shadow: 0 2px 18px var(--ink); }
    .acts-story .scene__desc { min-height: 0; max-width: none; color: var(--color-foreground); text-shadow: 0 1px 12px var(--ink); }
    .acts-story .as__dots { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .acts-story .scene, .acts-story .scene__media { transition: none; }
    .acts-story .cursor { animation: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-acts]');
  if (root) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const scenes = Array.from(root.querySelectorAll<HTMLElement>('[data-scene]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const caret = document.createElement('span');
    caret.className = 'cursor';
    let runToken = 0;

    const stream = (scene: HTMLElement) => {
      const my = ++runToken;
      const titleEl = scene.querySelector<HTMLElement>('.scene__title')!;
      const descEl = scene.querySelector<HTMLElement>('.scene__desc')!;
      const tF = titleEl.dataset.final ?? '';
      const dF = descEl.dataset.final ?? '';
      if (reduce) { titleEl.textContent = tF; descEl.textContent = dF; return; }
      titleEl.textContent = ''; descEl.textContent = '';
      titleEl.appendChild(caret);
      let ti = 0;
      const typeTitle = () => {
        if (my !== runToken) return;
        ti++; titleEl.textContent = tF.slice(0, ti); titleEl.appendChild(caret);
        if (ti < tF.length) { setTimeout(typeTitle, 42); return; }
        let di = 0;
        descEl.appendChild(caret);
        const typeDesc = () => {
          if (my !== runToken) return;
          di++; descEl.textContent = dF.slice(0, di); descEl.appendChild(caret);
          if (di < dF.length) setTimeout(typeDesc, 11);
        };
        typeDesc();
      };
      typeTitle();
    };

    let current = -1;
    const setActive = (i: number) => {
      if (i === current) return;
      current = i;
      scenes.forEach((s, k) => s.classList.toggle('on', k === i));
      dots.forEach((d, k) => { d.classList.toggle('active', k === i); d.classList.toggle('done', k < i); });
      stream(scenes[i]);
    };

    let ticking = false;
    const update = () => {
      ticking = false;
      const total = track.offsetHeight - window.innerHeight;
      const scrolled = Math.min(Math.max(-track.getBoundingClientRect().top, 0), total);
      const p = total > 0 ? scrolled / total : 0;
      setActive(Math.min(scenes.length - 1, Math.floor(p * scenes.length)));
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };

    const scrollToScene = (i: number, dur = 0.7) => {
      const total = track.offsetHeight - window.innerHeight;
      const target = Math.round(track.offsetTop + ((i + 0.5) / scenes.length) * total);
      const lenis = (window as any).__lenis;
      if (lenis) lenis.scrollTo(target, { duration: dur });
      else scrollTo({ top: target, behavior: 'smooth' });
    };

    // Same pinned scroll-story on every breakpoint (mobile = full-bleed + overlay).
    // No auto scroll-snap: the section must never force/hijack the scroll.
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    setActive(0);
    update();

    dots.forEach((d, i) => d.addEventListener('click', () => scrollToScene(i, 0.9)));
  }
</script>

---
// "Le attività" — Interactive Scrolling Story with a military "transmission"
// text stream (teletype + cursor, CoD-briefing style). A tall track pins a
// full-viewport stage; scrolling advances the active activity (crossfade).
// No auto scroll-snap: the section never hijacks the scroll. The progress
// dashes use the site-wide Lenis instance (window.__lenis) to jump to a scene.
// Desktop: split copy (left) + framed image (right). Mobile: image on top
// (full-bleed, 4:5 portrait source) + copy below on solid ink, so the subject
// is never covered by text. Fully static and legible under prefers-reduced-motion.

import PhotoFrame from '../molecules/PhotoFrame.astro';

interface Activity {
  title: string;
  desc: string;
  pills?: string[];
  image: string;
  imageMobile?: string;
  imageAlt?: string;
  href: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  items: Activity[];
}

const { eyebrow = 'Cosa si fa', title, intro, items } = Astro.props;
const toWebp = (p: string): string => p.replace(/\.(jpe?g|png)$/i, '.webp');
const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<section class="acts-story" data-acts>
  <div class="as__head shell">
    <p class="as__eyebrow">{eyebrow}</p>
    <h2 class="as__title">{title}</h2>
    {intro && <p class="as__intro">{intro}</p>}
  </div>

  <div class="as__track" data-track>
    <div class="as__stage">
      {items.map((a, i) => (
        <article class="scene" data-scene data-i={i}>
          <div class="scene__copy">
            <p class="scene__sig">// CANALE 0{i + 1} · TRASMISSIONE<span class="scene__sig-x"> IN ARRIVO</span></p>
            <p class="scene__num"><b>{pad(i)}</b><span>/ {pad(items.length - 1)}</span></p>
            <h3 class="scene__title" data-final={a.title}>{a.title}</h3>
            <p class="scene__desc" data-final={a.desc}>{a.desc}</p>
            {a.pills && a.pills.length > 0 && (
              <ul class="scene__pills">{a.pills.map((p) => <li>{p}</li>)}</ul>
            )}
            <a class="scene__cta" href={a.href}>Scopri {a.title} <span aria-hidden="true">&rarr;</span></a>
          </div>
          <figure class="scene__media">
            <picture>
              {a.imageMobile && <source media="(max-width: 820px)" type="image/webp" srcset={toWebp(a.imageMobile)} />}
              {a.imageMobile && <source media="(max-width: 820px)" srcset={a.imageMobile} />}
              <source type="image/webp" srcset={toWebp(a.image)} />
              <img src={a.image} alt={a.imageAlt ?? a.title} loading="lazy" decoding="async" />
            </picture>
            <PhotoFrame class="scene__frame" />
          </figure>
        </article>
      ))}
      <div class="as__dots" data-dots aria-hidden="true">
        {items.map((_, i) => <button class="as__dot" data-dot={i} tabindex="-1"><i></i></button>)}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .acts-story { --ink: var(--color-background); --accent: var(--color-accent); border-top: 1px solid var(--color-border); }
  .acts-story .as__head { padding-block: clamp(2rem, 5vw, 3.25rem) 0; }
  .acts-story .as__eyebrow { margin: 0; font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.26em; color: var(--accent); font-size: 0.78rem; display: flex; align-items: center; gap: 0.75rem; }
  .acts-story .as__eyebrow::before { content: ""; width: 34px; height: 2px; background: var(--accent); }
  .acts-story .as__title { margin: 0.5rem 0 0; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; line-height: 1; font-size: clamp(2rem, 5.5vw, 3.4rem); }
  .acts-story .as__intro { margin: 1rem 0 0; max-width: 58ch; color: var(--color-muted); font-size: clamp(1rem, 1.6vw, 1.12rem); line-height: 1.55; }

  .acts-story .as__track { position: relative; height: 400vh; margin-top: clamp(0.5rem, 2vh, 1.25rem); }
  .acts-story .as__stage { position: sticky; top: 0; height: 100svh; overflow: hidden; }

  .acts-story .scene { position: absolute; inset: 0; max-width: var(--shell-max); margin-inline: auto; display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); align-items: start; gap: clamp(1.5rem, 4vw, 3.5rem); padding: clamp(1.75rem, 6vh, 4rem) 1.25rem clamp(1rem, 3vh, 2rem); opacity: 0; pointer-events: none; transition: opacity var(--duration-slow) var(--ease-out-expo); }
  @media (min-width: 768px) { .acts-story .scene { padding-inline: 2rem; } }
  .acts-story .scene.on { opacity: 1; pointer-events: auto; }
  .acts-story .scene__copy { max-width: 42rem; }
  .acts-story .scene__sig { margin: 0 0 0.9rem; font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.14em; color: var(--accent); opacity: 0; }
  .acts-story .scene.on .scene__sig { opacity: 0.9; transition: opacity var(--duration-slow) var(--ease-out-expo); }
  .acts-story .scene__num { margin: 0 0 1rem; font-family: var(--font-display); letter-spacing: 0.16em; color: var(--color-muted); font-size: 0.9rem; display: flex; gap: 0.5rem; align-items: baseline; }
  .acts-story .scene__num b { color: var(--accent); font-size: 1.4rem; }
  .acts-story .scene__title { margin: 0; min-height: 1.1em; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; line-height: 0.92; font-size: clamp(2.4rem, 6vw, 5rem); }
  .acts-story .scene__desc { margin: 1.2rem 0 0; max-width: 52ch; min-height: 4.6em; color: var(--color-foreground); font-family: var(--font-mono); font-size: clamp(0.9rem, 1.3vw, 1rem); line-height: 1.65; }
  .acts-story .scene__pills { list-style: none; margin: 1.4rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; opacity: 0; }
  .acts-story .scene.on .scene__pills { opacity: 1; transition: opacity var(--duration-slow) var(--ease-out-expo) 0.2s; }
  .acts-story .scene__pills li { font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.72rem; padding: 0.4rem 0.8rem; border-radius: 999px; border: 1px solid var(--color-border); color: var(--color-foreground); }
  .acts-story .scene__cta { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.75rem; background: var(--accent); color: var(--color-on-accent); font-family: var(--font-display); text-transform: uppercase; font-weight: 600; letter-spacing: 0.04em; padding: 0.8rem 1.5rem; border-radius: var(--radius-md); text-decoration: none; opacity: 0; transition: background-color var(--duration-fast) var(--ease-out-expo); }
  .acts-story .scene.on .scene__cta { opacity: 1; transition: opacity var(--duration-slow) var(--ease-out-expo) 0.35s, background-color var(--duration-fast) var(--ease-out-expo); }
  .acts-story .scene__cta:hover { background: var(--color-accent-hover); }
  .acts-story .scene__cta:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .acts-story .cursor { display: inline-block; width: 0.55em; height: 1em; background: var(--accent); vertical-align: -0.12em; margin-left: 0.08em; animation: as-cur 1s steps(1) infinite; }
  @keyframes as-cur { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }

  .acts-story .scene__media { position: relative; margin: 0; height: min(74vh, 640px); border-radius: var(--radius-lg); overflow: hidden; transform: translateX(40px) scale(1.02); opacity: 0; transition: transform calc(var(--duration-slow) * 1.75) var(--ease-out-expo), opacity calc(var(--duration-slow) * 1.75) var(--ease-out-expo); }
  .acts-story .scene.on .scene__media { transform: none; opacity: 1; }
  .acts-story .scene__media picture, .acts-story .scene__media img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .acts-story .scene__media img { object-fit: cover; display: block; }

  .acts-story .as__dots { position: absolute; left: 50%; bottom: 26px; transform: translateX(-50%); z-index: 6; display: flex; gap: 10px; }
  .acts-story .as__dot { width: 46px; height: 4px; padding: 0; border: 0; background: color-mix(in srgb, var(--color-foreground) 22%, transparent); border-radius: 999px; overflow: hidden; cursor: pointer; }
  .acts-story .as__dot i { display: block; height: 100%; background: var(--accent); transform: scaleX(0); transform-origin: left; }
  .acts-story .as__dot.active i { transform: scaleX(1); transition: transform var(--duration-base) linear; }
  .acts-story .as__dot.done i { transform: scaleX(1); }

  /* Mobile: same pinned story, split VERTICALLY — the image takes all the
     space left above (full-bleed, 4:5 portrait source, subject centered) and
     the copy sits BELOW on solid ink, so the subject is never covered by text.
     A short gradient blends the bottom of the image into the copy panel. */
  @media (max-width: 820px) {
    .acts-story .as__track { margin-top: 1rem; }
    .acts-story .scene { grid-template-columns: 1fr; grid-template-rows: minmax(0, 1fr) auto; align-items: stretch; gap: 0; max-width: none; padding: 0; }
    .acts-story .scene__media { grid-row: 1; height: auto; min-height: 0; transform: none; opacity: 1; border-radius: 0; }
    /* Portrait sources keep their subject in the upper-middle: bias the crop
       upwards so short viewports (which show a center band) never cut heads. */
    .acts-story .scene__media img { object-position: 50% 40%; }
    .acts-story .scene.on .scene__media { transform: none; opacity: 1; }
    .acts-story .scene__media::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 34%; background: linear-gradient(0deg, var(--ink) 0%, color-mix(in srgb, var(--ink) 55%, transparent) 50%, transparent 100%); }
    .acts-story .scene__frame { display: none; }
    .acts-story .scene__copy { grid-row: 2; position: relative; z-index: 2; max-width: none; margin-top: -1.75rem; padding: 0 1.25rem calc(1.25rem + env(safe-area-inset-bottom, 0px)); display: grid; grid-template-columns: 1fr auto; align-items: end; column-gap: 1rem; }
    .acts-story .scene__copy > * { grid-column: 1 / -1; }
    .acts-story .scene__sig { grid-column: 1; margin: 0; font-size: 0.66rem; letter-spacing: 0.12em; white-space: nowrap; }
    .acts-story .scene__sig-x { display: none; }
    .acts-story .scene__num { grid-column: 2; margin: 0; font-size: 0.78rem; }
    .acts-story .scene__num b { font-size: 1.05rem; }
    .acts-story .scene__title { margin-top: 0.6rem; font-size: clamp(2.1rem, 9.5vw, 2.9rem); line-height: 0.95; }
    .acts-story .scene__desc { margin-top: 0.8rem; max-width: none; min-height: calc(4 * 1.55em); font-size: 0.875rem; line-height: 1.55; }
    .acts-story .scene__pills { margin-top: 0.9rem; gap: 0.4rem; }
    .acts-story .scene__pills li { font-size: 0.66rem; padding: 0.32rem 0.65rem; }
    .acts-story .scene__cta { margin-top: 1rem; padding: 0.75rem 1.25rem; font-size: 0.95rem; justify-self: start; }
    /* Phones: no progress dashes, too thin to be a useful tap target; the scroll is the progress. */
    .acts-story .as__dots { display: none; }
  }
  /* Short phones: tighten the copy so the image keeps a decent share. */
  @media (max-width: 820px) and (max-height: 700px) {
    .acts-story .scene__title { font-size: clamp(1.9rem, 8.5vw, 2.4rem); }
    .acts-story .scene__desc { min-height: calc(4 * 1.5em); font-size: 0.84rem; line-height: 1.5; }
    .acts-story .scene__pills { margin-top: 0.7rem; }
    .acts-story .scene__cta { margin-top: 0.8rem; padding: 0.65rem 1.1rem; font-size: 0.9rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .acts-story .scene, .acts-story .scene__media { transition: none; }
    .acts-story .cursor { animation: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-acts]');
  if (root) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const scenes = Array.from(root.querySelectorAll<HTMLElement>('[data-scene]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const caret = document.createElement('span');
    caret.className = 'cursor';
    let runToken = 0;

    const stream = (scene: HTMLElement) => {
      const my = ++runToken;
      const titleEl = scene.querySelector<HTMLElement>('.scene__title')!;
      const descEl = scene.querySelector<HTMLElement>('.scene__desc')!;
      const tF = titleEl.dataset.final ?? '';
      const dF = descEl.dataset.final ?? '';
      if (reduce) { titleEl.textContent = tF; descEl.textContent = dF; return; }
      titleEl.textContent = ''; descEl.textContent = '';
      titleEl.appendChild(caret);
      let ti = 0;
      const typeTitle = () => {
        if (my !== runToken) return;
        ti++; titleEl.textContent = tF.slice(0, ti); titleEl.appendChild(caret);
        if (ti < tF.length) { setTimeout(typeTitle, 42); return; }
        let di = 0;
        descEl.appendChild(caret);
        const typeDesc = () => {
          if (my !== runToken) return;
          di++; descEl.textContent = dF.slice(0, di); descEl.appendChild(caret);
          if (di < dF.length) setTimeout(typeDesc, 11);
        };
        typeDesc();
      };
      typeTitle();
    };

    let current = -1;
    const setActive = (i: number) => {
      if (i === current) return;
      current = i;
      scenes.forEach((s, k) => s.classList.toggle('on', k === i));
      dots.forEach((d, k) => { d.classList.toggle('active', k === i); d.classList.toggle('done', k < i); });
      stream(scenes[i]);
    };

    let ticking = false;
    const update = () => {
      ticking = false;
      const total = track.offsetHeight - window.innerHeight;
      const scrolled = Math.min(Math.max(-track.getBoundingClientRect().top, 0), total);
      const p = total > 0 ? scrolled / total : 0;
      setActive(Math.min(scenes.length - 1, Math.floor(p * scenes.length)));
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };

    const scrollToScene = (i: number, dur = 0.7) => {
      const total = track.offsetHeight - window.innerHeight;
      const target = Math.round(track.offsetTop + ((i + 0.5) / scenes.length) * total);
      const lenis = (window as any).__lenis;
      if (lenis) lenis.scrollTo(target, dur > 0 ? { duration: dur } : { immediate: true });
      else scrollTo({ top: target, behavior: dur > 0 && !reduce ? 'smooth' : 'auto' });
    };

    // Same pinned scroll-story on every breakpoint (mobile = full-bleed + overlay).
    // No auto scroll-snap: the section must never force/hijack the scroll.
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    setActive(0);
    update();

    dots.forEach((d, i) => d.addEventListener('click', () => scrollToScene(i, 0.9)));
    // The scenes share one stage and only the active one is visible: when keyboard focus lands in
    // another, jump the story there so the focused link is on screen (2.4.7). A jump, not a glide,
    // or the scroll would pass back through the previous scene on the way.
    scenes.forEach((s, i) => s.addEventListener('focusin', () => {
      if (i === current) return;
      scrollToScene(i, 0);
      setActive(i);
    }));
  }
</script>

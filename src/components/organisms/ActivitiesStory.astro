---
// "Le attività" — Interactive Scrolling Story with a military "transmission"
// stream (teletype + cursor, CoD-briefing style) on the channel line and the
// title; the description, the labels and the link fade in under them. A tall
// track pins a full-viewport stage; scrolling advances the active activity
// (crossfade). The first scene plays its entrance when the story comes into
// view, not at load. No auto scroll-snap: the section never hijacks the scroll.
// The progress dashes use the site-wide Lenis instance (window.__lenis) to jump
// to a scene. Desktop: split copy (left, centred on the photo) + framed image
// (right). Mobile: image on top (full-bleed, 4:5 portrait source) + copy below
// on the band's plane, so the subject is never covered by text. Screens shorter
// than 560px get no pin at all: the activities simply follow one another
// (RESP-07). Fully static and legible under prefers-reduced-motion.

import Button from '../atoms/Button.astro';
import Icon from '../atoms/Icon.astro';
import Picture from '../atoms/Picture.astro';
import PhotoFrame from '../molecules/PhotoFrame.astro';
import SectionHead from '../molecules/SectionHead.astro';
import { has } from '../../lib/fields';

interface Activity {
  title: string;
  desc: string;
  pills?: string[];
  image: string;
  imageMobile?: string;
  imageAlt?: string;
  /** Where the photo's subject sits, from the CMS: "left", "center" or "right"; anything else is the centre. */
  focus?: string;
  /** The link's text, e.g. "Scopri Softair". */
  label?: string;
  href?: string;
}
interface Props {
  title: string;
  intro?: string;
  items: Activity[];
  headingId?: string;
}

const { title, intro, items, headingId = 'acts-title' } = Astro.props;
const hasTitle = has(title);
// An activity without its title or its photo has nothing to show (CMS-10).
const list = (items ?? []).filter((a) => has(a?.title) && has(a?.image));
// Portrait screens below desktop get the vertical crop; a landscape phone keeps the wide photo.
const portraitMedia = '(max-width: 820px) and (orientation: portrait)';
---

{list.length > 0 && (
  <section class="acts band" aria-labelledby={hasTitle ? headingId : undefined} data-acts>
    <div class="shell">
      <SectionHead title={title} text={intro} id={headingId} />
    </div>

    <div class="acts__track" data-track style={`--n: ${list.length}`}>
      {list.map((_, i) => <span class="acts__probe" style={`--i: ${i}`} data-probe={i} aria-hidden="true"></span>)}
      <div class="acts__stage" data-stage>
        {list.map((a, i) => (
          <article class="acts__scene" data-scene>
            <div class="acts__copy">
              <p class="acts__sig" aria-hidden="true">
                <span data-type={`// CANALE 0${i + 1} · TRASMISSIONE`}>// CANALE 0{i + 1} · TRASMISSIONE</span><span class="acts__sig-x"> IN ARRIVO</span>
              </p>
              {/* Named by its label while the visible copy is retyped (A11Y-11). */}
              <h3 class="acts__name" aria-label={a.title}>
                <span aria-hidden="true" data-type={a.title}>{a.title}</span>
              </h3>
              {has(a.desc) && <p class="acts__desc">{a.desc}</p>}
              {a.pills && a.pills.length > 0 && (
                <ul class="acts__pills">{a.pills.map((p) => <li>{p}</li>)}</ul>
              )}
              {has(a.label) && has(a.href) && (
                <Button href={a.href} variant="secondary" class="acts__cta">
                  {a.label}<Icon name="arrowRight" size={18} />
                </Button>
              )}
            </div>
            <figure class:list={['acts__media', (a.focus === 'left' || a.focus === 'right') && `acts__media--${a.focus}`, has(a.imageMobile) && 'acts__media--crop']}>
              <Picture
                src={a.image}
                srcMobile={a.imageMobile}
                alt={has(a.imageAlt) ? a.imageAlt : a.title}
                mobileMedia={portraitMedia}
                sizes="(min-width: 821px) 60vw, 100vw"
              />
              <PhotoFrame class="acts__frame" />
            </figure>
          </article>
        ))}
        <div class="acts__dots" aria-hidden="true">
          {list.map((_, i) => <button class="acts__dot" data-dot={i} tabindex="-1"><i></i></button>)}
        </div>
      </div>
    </div>
  </section>
)}

<style is:global>
  .acts {
    --accent: var(--color-accent);
    padding-block: clamp(4rem, 9vw, 7rem) clamp(1.5rem, 4vw, 3rem);
  }

  /* The pinned length: one viewport per activity. The probes split the pinned scroll into one
     slice per scene, so an observer, not a scroll listener, says which scene is on (CODE-10). */
  .acts__track { position: relative; height: calc(var(--n, 4) * 100svh); margin-top: clamp(1rem, 3vh, 2rem); }
  .acts__probe {
    position: absolute;
    left: 0;
    width: 1px;
    top: calc(var(--i) * (100% - 100svh) / var(--n));
    height: calc((100% - 100svh) / var(--n));
    pointer-events: none;
    visibility: hidden;
  }
  .acts__stage { position: sticky; top: 0; height: 100svh; overflow: hidden; }

  .acts__scene {
    position: absolute;
    inset: 0;
    max-width: var(--shell-max);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    align-content: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding: clamp(1rem, 4vh, 2.5rem) var(--shell-gutter) clamp(3rem, 7vh, 4.5rem);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-slow) var(--ease-out-expo);
  }
  .acts__scene.is-on { opacity: 1; pointer-events: auto; }
  .acts__copy { max-width: 42rem; }

  .acts__sig {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    color: var(--accent);
    opacity: 0;
  }
  .acts__scene.is-on .acts__sig { opacity: 0.9; transition: opacity var(--duration-slow) var(--ease-out-expo); }

  .acts__name {
    margin: 0;
    min-height: 1em;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 0.95;
    font-size: clamp(2.4rem, 6vw, 5rem);
  }
  .acts__desc {
    margin: 1.2rem 0 0;
    max-width: 46ch;
    color: var(--color-muted);
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  /* What follows the stream: it fades up in order once the scene is on. */
  .acts__desc,
  .acts__pills,
  .acts__cta { opacity: 0; transform: translate3d(0, 0.75rem, 0); }
  .acts__scene.is-on :is(.acts__desc, .acts__pills, .acts__cta) {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--duration-slow) var(--ease-out-expo) var(--delay, 0s),
      transform calc(var(--duration-slow) * 1.5) var(--ease-out-expo) var(--delay, 0s),
      color var(--duration-fast) var(--ease-out-expo),
      border-color var(--duration-fast) var(--ease-out-expo);
  }
  .acts__desc { --delay: 0.15s; }
  .acts__pills { --delay: 0.25s; }
  .acts__cta { --delay: 0.35s; }
  /* Keyboard focus landing in a scene skips its entrance: the focused link shows at once (2.4.7). */
  .acts__scene:has(:focus-visible),
  .acts__scene.is-on:has(:focus-visible) :is(.acts__desc, .acts__pills, .acts__cta) { transition: none; }

  .acts__pills { list-style: none; margin: 1.4rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .acts__pills li {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-foreground);
  }
  .acts__cta { min-height: 48px; margin-top: 1.75rem; padding-inline: 1.4rem; }
  .acts__scene.is-on .acts__cta:active { transform: translateY(1px) scale(0.98); }

  .acts__cursor { display: inline-block; width: 0.55em; height: 1em; background: var(--accent); vertical-align: -0.12em; margin-left: 0.08em; animation: acts-cur 1s steps(1) infinite; }
  @keyframes acts-cur { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }

  .acts__media {
    --acts-x: 50%;
    position: relative;
    margin: 0;
    height: min(72svh, 640px);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transform: translateX(40px) scale(1.02);
    opacity: 0;
    transition:
      transform calc(var(--duration-slow) * 1.75) var(--ease-out-expo),
      opacity calc(var(--duration-slow) * 1.75) var(--ease-out-expo);
  }
  .acts__scene.is-on .acts__media { transform: none; opacity: 1; }
  .acts__media picture,
  .acts__media img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .acts__media img { object-fit: cover; object-position: var(--acts-x) 50%; display: block; }
  /* The subject chosen in the CMS stays in the frame when the photo is wider than its box. */
  .acts__media--left { --acts-x: 0%; }
  .acts__media--right { --acts-x: 100%; }
  /* A portrait phone gets the vertical crop, already composed on its subject: the focus is for the
     wide photo only, as in PageHero. */
  @media (max-width: 820px) and (orientation: portrait) {
    .acts__media--crop { --acts-x: 50%; }
  }

  /* Progress dashes: a 4px bar in a 44px-tall hit area (RESP-04), the padding left unpainted. */
  .acts__dots { position: absolute; left: 50%; bottom: 6px; transform: translateX(-50%); z-index: 6; display: flex; gap: 10px; }
  .acts__dot {
    width: 46px;
    height: 44px;
    padding: 20px 0;
    border: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-foreground) 22%, transparent) content-box;
    transition: background-color var(--duration-fast) var(--ease-out-expo);
  }
  .acts__dot:hover { background-color: color-mix(in srgb, var(--color-foreground) 40%, transparent); }
  .acts__dot i { display: block; height: 100%; border-radius: inherit; background: var(--accent); transform: scaleX(0); transform-origin: left; }
  .acts__dot.is-active i { transform: scaleX(1); transition: transform var(--duration-base) var(--ease-out-expo); }
  .acts__dot.is-done i { transform: scaleX(1); }

  /* Mobile: same pinned story, split VERTICALLY — the image takes all the
     space left above (full-bleed, 4:5 portrait source, subject centered) and
     the copy sits BELOW on the band's plane, so the subject is never covered by
     text. A short gradient blends the bottom of the image into the copy panel. */
  @media (max-width: 820px) {
    .acts__scene { grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(0, 1fr) auto; align-items: stretch; align-content: stretch; gap: 0; max-width: none; padding: 0; }
    .acts__media { grid-row: 1; height: auto; min-height: 0; transform: none; opacity: 1; border-radius: 0; }
    /* Portrait sources keep their subject in the upper-middle: bias the crop
       upwards so short viewports (which show a center band) never cut heads. */
    .acts__media img { object-position: var(--acts-x) 40%; }
    .acts__scene.is-on .acts__media { transform: none; opacity: 1; }
    .acts__media::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 34%; background: linear-gradient(0deg, var(--plane) 0%, color-mix(in srgb, var(--plane) 55%, transparent) 50%, transparent 100%); }
    .acts__frame { display: none; }
    /* The bottom 4.5rem is the band reserved for the fixed WhatsApp and «Torna su» chips (44px,
       20px in from the corners, plus 8px of air): the copy ends above it, so the link never sits
       under a chip. */
    .acts__copy { grid-row: 2; position: relative; z-index: 2; max-width: none; margin-top: -1.75rem; padding: 0 var(--shell-gutter) calc(4.5rem + env(safe-area-inset-bottom, 0px)); }
    .acts__sig { margin: 0; font-size: 0.7rem; letter-spacing: 0.12em; white-space: nowrap; }
    .acts__sig-x { display: none; }
    .acts__name { margin-top: 0.6rem; font-size: clamp(2.1rem, 9.5vw, 2.9rem); }
    .acts__desc { margin-top: 0.75rem; max-width: none; min-height: calc(4 * 1.55em); font-size: 1rem; line-height: 1.55; }
    .acts__pills { margin-top: 0.9rem; gap: 0.4rem; }
    .acts__pills li { font-size: 0.7rem; padding: 0.32rem 0.65rem; }
    .acts__cta { margin-top: 1rem; min-height: 44px; }
    /* Phones: no progress dashes; the scroll is the progress. */
    .acts__dots { display: none; }
  }
  /* Short phones: tighten the copy so the image keeps a decent share. */
  @media (max-width: 820px) and (max-height: 700px) {
    .acts__name { font-size: clamp(1.9rem, 8.5vw, 2.4rem); }
    .acts__desc { margin-top: 0.6rem; min-height: calc(4 * 1.5em); line-height: 1.5; }
    .acts__pills { margin-top: 0.7rem; }
    .acts__cta { margin-top: 0.8rem; }
  }

  /* Too short to pin (RESP-07): no track, no stage, the activities one after the other, each a
     photo beside its copy. After the mobile rules on purpose. */
  @media (max-height: 559px) {
    .acts__track { height: auto; margin-top: clamp(1.5rem, 4vw, 2.5rem); }
    .acts__probe,
    .acts__dots { display: none; }
    .acts__stage { position: static; height: auto; overflow: visible; }
    .acts__scene,
    .acts__scene.is-on {
      position: relative;
      inset: auto;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      grid-template-rows: auto;
      align-items: center;
      gap: clamp(1.25rem, 4vw, 2.5rem);
      max-width: var(--shell-max);
      padding: clamp(1.5rem, 4vw, 2.5rem) var(--shell-gutter);
      opacity: 1;
      pointer-events: auto;
    }
    .acts__copy { grid-row: auto; margin-top: 0; padding: 0; }
    .acts__media,
    .acts__scene.is-on .acts__media { grid-row: auto; height: auto; aspect-ratio: 4 / 3; border-radius: var(--radius-lg); transform: none; opacity: 1; }
    .acts__media::after { display: none; }
    .acts__frame { display: block; }
    .acts__sig,
    .acts__scene.is-on .acts__sig { opacity: 0.9; }
    .acts__desc { min-height: 0; }
    .acts__desc,
    .acts__pills,
    .acts__cta { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .acts__scene,
    .acts__media,
    .acts__scene.is-on :is(.acts__desc, .acts__pills, .acts__cta) { transition: none; }
    .acts__cursor { animation: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-acts]');
  if (root) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const scenes = Array.from(root.querySelectorAll<HTMLElement>('[data-scene]'));
    const probes = Array.from(root.querySelectorAll<HTMLElement>('[data-probe]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Same breakpoint as the CSS that drops the pin on short screens.
    const tall = matchMedia('(min-height: 560px)');

    const caret = document.createElement('span');
    caret.className = 'acts__cursor';
    let runToken = 0;

    const fill = (scene: HTMLElement) =>
      scene.querySelectorAll<HTMLElement>('[data-type]').forEach((el) => { el.textContent = el.dataset.type ?? ''; });

    // Types the channel line, then the title; the rest of the copy fades in by itself (CSS).
    const stream = (scene: HTMLElement) => {
      const my = ++runToken;
      if (reduce) { fill(scene); return; }
      const lines = Array.from(scene.querySelectorAll<HTMLElement>('[data-type]'));
      lines.forEach((el) => { el.textContent = ''; });
      const typeLine = (k: number) => {
        const el = lines[k];
        if (!el) { caret.remove(); return; }
        const full = el.dataset.type ?? '';
        let n = 0;
        const step = () => {
          if (my !== runToken) return;
          n++;
          el.textContent = full.slice(0, n);
          el.appendChild(caret);
          if (n < full.length) setTimeout(step, k === 0 ? 14 : 42);
          else setTimeout(() => typeLine(k + 1), 120);
        };
        step();
      };
      typeLine(0);
    };

    // Until the story first comes into view the scene on is only noted, not shown, so the first
    // one plays its entrance in front of the visitor rather than off screen at load.
    let seen = false;
    let current = -1;
    const show = (i: number) => {
      scenes.forEach((s, k) => s.classList.toggle('is-on', k === i));
      dots.forEach((d, k) => { d.classList.toggle('is-active', k === i); d.classList.toggle('is-done', k < i); });
      stream(scenes[i]);
    };
    const setActive = (i: number) => {
      if (i === current) return;
      current = i;
      if (seen) show(i);
    };
    const arrive = () => {
      if (seen) return;
      seen = true;
      arrival.disconnect();
      if (tall.matches && current >= 0) show(current);
    };
    const arrival = new IntersectionObserver(([e]) => { if (e.isIntersecting) arrive(); });
    arrival.observe(stage);

    // Which probe crosses the top edge of the viewport is the scene on. Between two probes, or
    // outside the track, the scene stays as it was.
    const crossing = new Set<number>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const i = Number((e.target as HTMLElement).dataset.probe);
          if (e.isIntersecting) crossing.add(i);
          else crossing.delete(i);
        });
        if (crossing.size) setActive(Math.max(...crossing));
      },
      { rootMargin: '0px 0px -99% 0px' }
    );

    // Unpinned (short screens) every scene is on, written out in full.
    const mode = () => {
      if (tall.matches) {
        probes.forEach((p) => io.observe(p));
        const was = current < 0 ? 0 : current;
        current = -1;
        scenes.forEach((s) => s.classList.remove('is-on'));
        setActive(was);
      } else {
        io.disconnect();
        crossing.clear();
        runToken++;
        caret.remove();
        scenes.forEach((s) => { s.classList.add('is-on'); fill(s); });
      }
    };
    tall.addEventListener('change', mode);
    mode();

    const scrollToScene = (i: number, dur = 0.7) => {
      const total = track.offsetHeight - innerHeight;
      const target = Math.round(track.getBoundingClientRect().top + scrollY + ((i + 0.5) / scenes.length) * total);
      const lenis = (window as any).__lenis;
      if (lenis) lenis.scrollTo(target, dur > 0 ? { duration: dur } : { immediate: true });
      else scrollTo({ top: target, behavior: dur > 0 && !reduce ? 'smooth' : 'auto' });
    };

    dots.forEach((d, i) => d.addEventListener('click', () => scrollToScene(i, 0.9)));
    // The scenes share one stage and only the active one is visible: when keyboard focus lands in
    // another, jump the story there so the focused link is on screen (2.4.7). A jump, not a glide,
    // or the scroll would pass back through the previous scene on the way.
    scenes.forEach((s, i) => s.addEventListener('focusin', () => {
      if (!tall.matches) return;
      if (!seen) { current = -1; arrive(); }
      if (i === current) return;
      scrollToScene(i, 0);
      setActive(i);
    }));
  }
</script>

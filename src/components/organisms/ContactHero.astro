---
// The contact page's opening. No photo: the answer is the data itself, so under the title the ways
// to reach the arena sit on one ruled strip, the phone first as the page's one accent action (it
// books), then email, WhatsApp when it is set, the hours and the address; the socials close it.
// Contact data comes from settings.json only, the captions from the page's own file, and a value
// emptied in the CMS takes its cell with it (CMS-10). The inner pages' HUD frame runs here too.
// The title and the lede are the LCP, so they never animate (DES-08); the strip rises in after them.

import Icon from '../atoms/Icon.astro';
import Breadcrumb from '../molecules/Breadcrumb.astro';
import HudFrame from '../molecules/HudFrame.astro';
import settings from '../../data/settings.json';
import { has } from '../../lib/fields';
import { telHref, waHref } from '../../lib/phone';

interface Crumb {
  label: string;
  href?: string;
}
interface Labels {
  phone?: string;
  email?: string;
  whatsapp?: string;
  hours?: string;
  address?: string;
  social?: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  /** Small readout in the HUD frame, from 641px wide. */
  hudTag?: string;
  crumbs?: Crumb[];
  /** Captions over each contact value. */
  labels?: Labels;
  headingId?: string;
}

const { eyebrow, title, subtitle, hudTag, crumbs = [], labels = {}, headingId = 'reach-title' } = Astro.props;
const { phone, whatsapp, email, openingHours, address } = settings;

const tel = telHref(phone);
const wa = waHref(whatsapp);
// The same channels, in the same order, as the footer.
const social: Partial<Record<'instagram' | 'facebook' | 'youtube' | 'tiktok', string>> = settings.social ?? {};
const socials = (
  [
    { key: 'instagram', label: 'Instagram' },
    { key: 'facebook', label: 'Facebook' },
    { key: 'youtube', label: 'YouTube' },
    { key: 'tiktok', label: 'TikTok' },
  ] as const
).filter((s) => has(social[s.key]));
// A short title keeps the display size; a long one steps down so it holds in two or three lines.
const isLong = title.length > 14;
// Nothing filled in «Impostazioni generali»: no empty list (CMS-10).
const hasContacts = !!tel || !!wa || has(email) || has(openingHours) || has(address);
const socialId = `${headingId}-social`;
---

<section class="reach band" aria-labelledby={headingId}>
  <span class="reach__light" aria-hidden="true"></span>
  <HudFrame tag={hudTag} />

  <div class="reach__body shell">
    {crumbs.length > 0 && <Breadcrumb items={crumbs} class="reach__crumbs" />}

    <div class="reach__head">
      {has(eyebrow) && <p class="reach__eyebrow">{eyebrow}</p>}
      <h1 class:list={['reach__title', isLong && 'reach__title--long']} id={headingId}>{title}</h1>
    </div>
    {has(subtitle) && <p class="reach__lede">{subtitle}</p>}

    {hasContacts && (
      <ul class="reach__list" role="list">
        {tel && (
          <li class="reach__item reach__item--call" style="--i: 0">
            <a class="reach__call" href={tel}>
              <span class="reach__chip"><Icon name="phone" size={22} /></span>
              <span class="reach__call-body">
                {/* The space keeps caption and number apart in the link's name («Telefono 375…»). */}
                {has(labels.phone) && <Fragment><span class="reach__cap reach__cap--on-accent">{labels.phone}</span>{' '}</Fragment>}
                <span class="reach__num">{phone}</span>
              </span>
            </a>
          </li>
        )}
        {has(email) && (
          <li class="reach__item" style="--i: 1">
            {has(labels.email) && <span class="reach__cap"><Icon name="mail" size={16} />{labels.email}</span>}
            <a class="reach__link" href={`mailto:${email}`}>{email}</a>
          </li>
        )}
        {wa && (
          <li class="reach__item" style="--i: 2">
            {has(labels.whatsapp) && <span class="reach__cap"><Icon name="whatsapp" size={16} />{labels.whatsapp}</span>}
            <a class="reach__link" href={wa} target="_blank" rel="noopener">
              {whatsapp}<span class="sr-only"> (si apre in una nuova scheda)</span>
            </a>
          </li>
        )}
        {has(openingHours) && (
          <li class="reach__item" style="--i: 3">
            {has(labels.hours) && <span class="reach__cap"><Icon name="clock" size={16} />{labels.hours}</span>}
            <p class="reach__value">{openingHours}</p>
          </li>
        )}
        {has(address) && (
          <li class="reach__item" style="--i: 4">
            {has(labels.address) && <span class="reach__cap"><Icon name="mapPin" size={16} />{labels.address}</span>}
            <p class="reach__value">{address}</p>
          </li>
        )}
      </ul>
    )}

    {socials.length > 0 && (
      <div class="reach__social">
        {has(labels.social) && <p class="reach__cap" id={socialId}>{labels.social}</p>}
        <ul
          class="reach__social-list"
          role="list"
          aria-labelledby={has(labels.social) ? socialId : undefined}
          aria-label={has(labels.social) ? undefined : 'Social'}
        >
          {socials.map((s) => (
            <li>
              <a class="reach__social-link" href={social[s.key]} target="_blank" rel="noopener">
                <Icon name={s.key} size={18} />{s.label}<span class="sr-only"> (si apre in una nuova scheda)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<style is:global>
  .reach {
    --accent: var(--color-accent);
    /* Room for the floating header (logo 48px + 20px padding each side), as in PageHero. The HUD
       readout sits on the breadcrumb's row, right-aligned with the page column. */
    --reach-top: 5.75rem;
    --hud-tag-top: calc(var(--reach-top) + 0.55rem);
    --hud-tag-right: calc(max(0px, (100% - var(--shell-max)) / 2) + var(--shell-gutter));
    --hud-tag-bottom: auto;
    isolation: isolate;
    overflow: hidden;
  }
  /* A soft, neutral light behind the title: depth on a page with no photo, not a halo. */
  .reach__light {
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(55% 75% at 12% 28%, color-mix(in srgb, var(--color-foreground) 6%, transparent), transparent 70%);
  }
  /* The scan runs under the copy; the corners and the readout sit above it. */
  .reach .hud__scan { z-index: 0; }
  .reach .hud__corners,
  .reach .hud__tag { z-index: 2; }

  .reach__body {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "crumbs" "head" "lede" "list" "social";
    padding-block: var(--reach-top) clamp(3.5rem, 8vw, 5.5rem);
  }
  /* The trail's first label lines up with the title: its link pads its text by 0.375rem. */
  .reach__crumbs {
    grid-area: crumbs;
    justify-self: start;
    max-width: 100%;
    margin-inline-start: -0.375rem;
  }

  /* --- Copy --- */
  .reach__head {
    grid-area: head;
    margin-top: clamp(1.25rem, 4vw, 2.5rem);
  }
  .reach__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(0.75rem, 1.4vw, 0.85rem);
    line-height: 1.3;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .reach__eyebrow::before {
    content: "";
    flex: none;
    width: 30px;
    height: 2px;
    background: var(--accent);
  }
  /* Measured in em, not ch, so the fallback face wraps where Oswald will (PERF-03). */
  .reach__title {
    margin: 0;
    max-width: 8.8em;
    font-weight: 700;
    font-size: clamp(3.25rem, 1.5rem + 7vw, 8rem);
    line-height: 0.94;
    letter-spacing: 0.005em;
    text-wrap: balance;
  }
  .reach__title--long {
    max-width: 12.1em;
    font-size: clamp(2.4rem, 1.2rem + 4.6vw, 5.25rem);
    line-height: 0.98;
  }
  /* The inner pages' accent rule under the headline, on a pseudo-element so the H1 never moves.
     Hero choreography, longer than the UI duration tokens on purpose. */
  .reach__title::after {
    content: "";
    display: block;
    width: clamp(64px, 18vw, 160px);
    height: 5px;
    margin-top: 0.45rem;
    background: var(--accent);
    transform-origin: left;
    animation: reach-wipe 0.7s var(--ease-out-expo) 0.35s both;
  }
  @keyframes reach-wipe { from { transform: scaleX(0); } }

  .reach__lede {
    grid-area: lede;
    margin: 1.4rem 0 0;
    max-width: 30em;
    font-size: clamp(1.05rem, 0.95rem + 0.45vw, 1.3rem);
    line-height: 1.55;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  /* --- The strip: one ruled list, the call first. --- */
  .reach__list {
    grid-area: list;
    list-style: none;
    margin: clamp(2rem, 5vw, 3.75rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .reach__item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
    padding-block: 1.05rem;
    border-bottom: 1px solid var(--color-border);
    animation: reach-rise calc(var(--duration-slow) * 2) var(--ease-out-expo) calc(0.25s + var(--i, 0) * 70ms) both;
  }
  .reach__item--call {
    padding-block: 0 1.25rem;
  }

  .reach__cap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8rem;
    line-height: 1.3;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .reach__cap svg { flex: none; color: var(--accent); }

  /* The call: the site's accent action shape (radius-md), labelled with the number itself. */
  .reach__call {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 4.5rem;
    padding: 0.5rem 1.5rem 0.5rem 0.5rem;
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--color-on-accent);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out-expo),
      transform var(--duration-fast) var(--ease-out-expo);
  }
  .reach__call:hover { background: var(--color-accent-hover); }
  .reach__call:active { transform: translateY(1px) scale(0.98); }
  .reach .reach__call:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: var(--radius-md); }
  .reach__chip {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-sm);
    background: var(--color-on-accent);
    color: var(--accent);
  }
  .reach__call-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .reach__cap--on-accent { color: var(--color-on-accent); }
  .reach__num {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.45rem, 1.2rem + 0.8vw, 1.85rem);
    line-height: 1.1;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .reach__link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    max-width: 100%;
    min-height: 44px;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    font-weight: 500;
    color: var(--color-foreground);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 50%, transparent);
    text-underline-offset: 5px;
    transition:
      color var(--duration-fast) var(--ease-out-expo),
      text-decoration-color var(--duration-fast) var(--ease-out-expo);
  }
  .reach__link:hover { color: var(--color-accent-hover); text-decoration-color: var(--accent); }
  .reach__link:active { transform: translateY(1px); }
  .reach__value {
    margin: 0;
    max-width: 30ch;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    line-height: 1.45;
    color: var(--color-foreground);
    font-variant-numeric: tabular-nums;
    text-wrap: pretty;
  }

  /* --- Socials --- */
  .reach__social {
    grid-area: social;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.25rem;
    animation: reach-rise calc(var(--duration-slow) * 2) var(--ease-out-expo) 0.6s both;
  }
  .reach__social-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }
  .reach__social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    padding-inline: 0.9rem 1.05rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-foreground);
    font-size: 0.95rem;
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-out-expo),
      color var(--duration-fast) var(--ease-out-expo),
      transform var(--duration-fast) var(--ease-out-expo);
  }
  .reach__social-link svg { flex: none; color: var(--accent); }
  .reach__social-link:hover { border-color: var(--accent); color: var(--color-accent-hover); }
  .reach__social-link:active { transform: translateY(1px) scale(0.98); }
  .reach .reach__social-link:focus-visible { outline-offset: 3px; border-radius: 999px; }

  @keyframes reach-rise {
    from { opacity: 0; transform: translate3d(0, 1.25rem, 0); }
  }

  /* Tablets: caption and value side by side on each row; the call keeps its natural width. */
  @media (min-width: 600px) {
    .reach__item:not(.reach__item--call) {
      display: grid;
      grid-template-columns: 9.5rem minmax(0, 1fr);
      align-items: baseline;
      column-gap: 1.5rem;
    }
    .reach__item--call { align-items: flex-start; }
    .reach__item--call .reach__call { padding-inline-end: 2rem; }
    .reach__item:not(.reach__item--call) > .reach__cap { align-self: center; }
  }

  /* Desktop: title and lede side by side, the strip in ruled cells below them, two by two until
     there is room for one row. */
  @media (min-width: 1024px) {
    .reach__body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: "crumbs crumbs" "head lede" "list list" "social social";
      column-gap: clamp(2rem, 5vw, 6rem);
      align-items: end;
    }
    /* Bottom-aligned with the title's last line, above its accent rule. */
    .reach__lede { margin: 0; padding-bottom: 1.1rem; }

    .reach__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-top: 1px solid var(--color-border);
    }
    .reach__item,
    .reach__item:not(.reach__item--call) {
      display: flex;
      flex-direction: column;
      /* Top-aligned, so every caption sits on one line across the cells. */
      justify-content: flex-start;
      align-items: stretch;
      gap: 0.5rem;
      padding: 1.5rem 2rem;
    }
    .reach__item:not(.reach__item--call) > .reach__cap { align-self: auto; }
    .reach__item:nth-child(odd) { padding-left: 0; }
    .reach__item:nth-child(even) { border-left: 1px solid var(--color-border); }
    /* An odd last cell takes the whole row: no empty cell. */
    .reach__item:last-child:nth-child(odd) { grid-column: 1 / -1; }
    .reach__social { margin-top: 1.5rem; }
  }
  /* One row: the call as wide as its number, the other cells sharing what is left. */
  @media (min-width: 1280px) {
    .reach__list {
      grid-template-columns: max-content;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
    }
    .reach__item:nth-child(n) { padding-left: clamp(1.25rem, 2vw, 2rem); border-left: 0; }
    .reach__item:first-child { padding-left: 0; }
    .reach__item + .reach__item { border-left: 1px solid var(--color-border); }
    .reach__item:last-child:nth-child(odd) { grid-column: auto; }
    .reach__item--call .reach__call { padding-inline-end: 1.75rem; }
  }

  /* Landscape phones: a smaller title, so the call is in the first screen. */
  @media (max-height: 500px) and (orientation: landscape) {
    .reach { --reach-top: 4.75rem; }
    .reach .hud__corner--tl,
    .reach .hud__corner--tr { display: none; }
    .reach__head { margin-top: 0.75rem; }
    .reach__eyebrow { margin-bottom: 0.6rem; }
    .reach__title,
    .reach__title--long { font-size: clamp(2rem, 11vh, 2.75rem); max-width: none; }
    .reach__lede { margin-top: 0.75rem; font-size: 1rem; }
    .reach__list { margin-top: 1.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .reach__title::after,
    .reach__item,
    .reach__social { animation: none; }
  }
</style>

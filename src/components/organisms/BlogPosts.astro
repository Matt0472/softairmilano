---
// A run of blog articles as cards: the blog's list and the «Altri articoli» at the foot of every
// article. Three cards a row from desktop, two on tablets, one on phones; the cards of a row share
// their rows (BlogCard), so titles, summaries and buttons line up. The last row is never left with
// a gap: one or two cards short of a full row, the last cards widen to share it. Past one page,
// numbered pages follow the grid.

import Icon from '../atoms/Icon.astro';
import BlogCard from '../molecules/BlogCard.astro';
import SectionHead from '../molecules/SectionHead.astro';
import { has } from '../../lib/fields';
import type { Post } from '../../lib/blog';

interface Pager {
  current: number;
  last: number;
  /** The address of a page, from 1. */
  href: (page: number) => string;
}
interface Props {
  title?: string;
  posts: Post[];
  readMore?: string;
  pager?: Pager;
  headingId?: string;
}

const { title, posts, readMore, pager, headingId = 'posts-title' } = Astro.props;
const hasTitle = has(title);
const pages = pager && pager.last > 1 ? Array.from({ length: pager.last }, (_, i) => i + 1) : [];
---

{posts.length > 0 && (
  <section class="posts band" aria-labelledby={hasTitle ? headingId : undefined}>
    <div class="shell">
      {hasTitle && <SectionHead title={title!} id={headingId} />}
      <div class:list={['posts__grid', hasTitle && 'posts__grid--titled']} data-post-grid>
        {posts.map((post) => (
          <BlogCard post={post} readMore={readMore} headingLevel={hasTitle ? 3 : 2} />
        ))}
      </div>

      {pager && pages.length > 0 && (
        <nav class="pager" aria-label="Pagine del blog">
          {pager.current > 1 && (
            <a class="pager__step" href={pager.href(pager.current - 1)} aria-label="Pagina precedente">
              <Icon name="chevronRight" size={18} class="pager__back" />
            </a>
          )}
          <ol class="pager__list" role="list">
            {pages.map((n) => (
              <li>
                <a class="pager__page" href={pager.href(n)} aria-current={n === pager.current ? 'page' : undefined}>{n}</a>
              </li>
            ))}
          </ol>
          {pager.current < pager.last && (
            <a class="pager__step" href={pager.href(pager.current + 1)} aria-label="Pagina successiva">
              <Icon name="chevronRight" size={18} />
            </a>
          )}
        </nav>
      )}
    </div>
  </section>
)}

<style is:global>
  .posts {
    padding-block: clamp(4rem, 9vw, 7rem) clamp(4.5rem, 10vw, 8rem);
  }
  .posts__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .posts__grid--titled { margin-top: clamp(2rem, 5vw, 3.25rem); }

  /* Tablets: two a row; an odd last card takes the whole row. */
  @media (min-width: 640px) {
    .posts__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .posts__grid > .post { grid-column: span 2; }
    .posts__grid > .post:nth-child(odd):last-child { grid-column: span 4; }
  }
  /* Desktop: three a row. One card short, the last two share their row; two short, the last
     four go two by two over the last two rows; a single card takes half the width. */
  @media (min-width: 1024px) {
    .posts__grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .posts__grid > .post,
    .posts__grid > .post:nth-child(odd):last-child { grid-column: span 2; }
    .posts__grid > .post:first-child:nth-last-child(3n + 2) ~ .post:nth-last-child(-n + 2),
    .posts__grid > .post:first-child:nth-last-child(2),
    .posts__grid > .post:first-child:nth-last-child(3n + 4) ~ .post:nth-last-child(-n + 4),
    .posts__grid > .post:first-child:nth-last-child(4),
    .posts__grid > .post:first-child:last-child { grid-column: span 3; }
  }

  /* --- Numbered pages --- */
  .pager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  .pager__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pager__page,
  .pager__step {
    display: inline-grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-foreground);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out-expo),
      border-color var(--duration-fast) var(--ease-out-expo);
  }
  .pager__page:hover,
  .pager__step:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .pager__page:active,
  .pager__step:active { transform: translateY(1px); }
  .pager__page[aria-current='page'] { border-color: var(--color-accent); color: var(--color-accent); }
  .pager__back { transform: scaleX(-1); }
</style>

---
// «Seguici sui nostri canali social» beside a blog article, under «Esperienze consigliate»: the
// site's social profiles (src/lib/social.ts) as round icon links, the footer's pattern: each opens
// a new tab and says so to a screen reader. Without a title or without a profile, nothing shows.

import Icon from '../atoms/Icon.astro';
import Overline from '../atoms/Overline.astro';
import { has } from '../../lib/fields';
import { socialLinks } from '../../lib/social';

interface Props {
  title?: string;
  headingId?: string;
  class?: string;
}

const { title, headingId = 'follow-title', class: className } = Astro.props;
const socials = socialLinks();
---

{has(title) && socials.length > 0 && (
  <aside class:list={['follow', className]} aria-labelledby={headingId}>
    <Overline as="h2" id={headingId}>{title}</Overline>
    <ul class="follow__list" role="list">
      {socials.map((s) => (
        <li>
          <a class="follow__link" href={s.href} target="_blank" rel="noopener">
            <Icon name={s.key} size={18} />
            <span class="sr-only">{s.label} (si apre in una nuova scheda)</span>
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}

<style is:global>
  .follow {
    display: grid;
    gap: 1rem;
  }
  .follow__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* A 44px round target (RESP-04). */
  .follow__link {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-muted);
    transition:
      border-color var(--duration-fast) var(--ease-out-expo),
      color var(--duration-fast) var(--ease-out-expo),
      transform var(--duration-fast) var(--ease-out-expo);
  }
  .follow__link:active { transform: translateY(1px); }
  /* The ring follows the circle, not the site's square link ring. */
  .follow__link:focus-visible {
    outline-offset: 3px;
    border-radius: 50%;
  }
  @media (hover: hover) {
    .follow__link:hover { border-color: var(--color-accent); color: var(--color-accent); }
  }

  @media (prefers-reduced-motion: reduce) {
    .follow__link:active { transform: none; }
  }
</style>

---
// "Dentro l'azione": a clip in a cinema frame, with the camera readout (REC · CAM 01), the
// controls and the channel's YouTube chip always on it. Native self-hosted <video> on Cloudflare R2
// (MEDIA-07), muted and looping: it plays whenever the frame is on screen (with reduced motion only
// after play, unless `playWithReducedMotion`: the home's known debt, A11Y-07) and pauses when it
// leaves; only the sound waits for a tap, and a clip without audio has no sound button.
// Two formats. 'wide' (the home): the clip runs across the page under the title and text, and a
// vertical 4:5 cut, when set, plays on portrait phones. 'portrait' (a clip shot upright): 4:5 on
// every screen, beside the copy where the screen is wide enough and under it elsewhere.

import Icon from '../atoms/Icon.astro';
import Picture from '../atoms/Picture.astro';
import SectionHead from '../molecules/SectionHead.astro';
import settings from '../../data/settings.json';
import { has } from '../../lib/fields';

interface Props {
  title: string;
  text?: string;
  /** Wide format: the wide cut, ~2.54:1. Portrait format: the 4:5 cut, for phones too when there is no `videoSrcMobile`. (R2 .mp4) */
  videoSrc: string;
  /** Wide format: a 4:5 cut for portrait phones. Portrait format: the 4:5 cut for phones. (R2 .mp4) */
  videoSrcMobile?: string;
  /** A still of `videoSrc`, shown until the clip plays. */
  poster?: string;
  /** A still of `videoSrcMobile`. */
  posterMobile?: string;
  /** What the clip shows, for screen readers; empty uses the title. */
  videoAlt?: string;
  /** Text of the YouTube chip; empty uses the channel handle from its address. */
  youtubeLabel?: string;
  /** 'wide' (default) or 'portrait': a clip shot upright, 4:5 on every screen. */
  format?: 'wide' | 'portrait';
  /** False for a clip without an audio track: no sound button, always muted. */
  sound?: boolean;
  /** Whether the clip starts by itself when the visitor asks for reduced motion: true only for
      the home's, the recorded exception (A11Y-07); false waits for the play button. */
  playWithReducedMotion?: boolean;
  headingId?: string;
}

const {
  title,
  text,
  videoSrc,
  videoSrcMobile,
  poster,
  posterMobile,
  videoAlt,
  youtubeLabel,
  format = 'wide',
  sound,
  playWithReducedMotion = false,
  headingId = 'action-title',
} = Astro.props;

const vertical = format === 'portrait';
// Where the phone files take over: the wide format's 4:5 cut only on portrait phones (a landscape
// phone keeps the wide frame); the portrait format's two cuts share a ratio, so on every phone.
const mobileMedia = vertical ? '(max-width: 767px)' : '(max-width: 767px) and (orientation: portrait)';
const hasTitle = has(title);
// Only an explicit «no audio» silences the clip: a missing or empty CMS value keeps the sound button.
const hasSound = sound !== false;
const phoneCut = has(videoSrcMobile);
// A 4:5 frame on portrait phones, from either format.
const portrait = vertical || phoneCut;
// The phone's still belongs to the phone's cut: without it the phone plays `videoSrc` and shows its still.
const stillMobile = phoneCut && has(posterMobile) ? posterMobile : undefined;
// The portrait frame's rendered width (PERF-04), measured against the layout below; the wide frame
// spans the page, the Picture's default.
const stillSizes = vertical
  ? '(orientation: landscape) and (min-width: 640px) and (max-width: 1023px) min(50vw, (100vh - 6rem) * 0.8), (max-width: 767px) calc(100vw - 2.5rem), (max-width: 1023px) calc(100vw - 4rem), min(48vw, 46rem)'
  : undefined;
const youtubeUrl = settings.social?.youtube?.trim() ?? '';
const youtubeHandle = youtubeUrl.split('/').filter(Boolean).pop() ?? '';
const youtubeText = has(youtubeLabel) ? youtubeLabel : youtubeHandle.startsWith('@') ? youtubeHandle : 'YouTube';
---

{has(videoSrc) && (
  <section
    class:list={['action band', portrait && 'action--portrait', vertical && 'action--vertical', !hasSound && 'action--silent']}
    aria-labelledby={hasTitle ? headingId : undefined}
    data-action
    data-hold-reduced={playWithReducedMotion ? undefined : ''}
  >
    <div class="shell" data-reveal>
      <SectionHead title={title} text={text} id={headingId} align={vertical ? 'start' : 'center'} />
    </div>

    <div class="action__fit" data-reveal style="--i: 1">
      <div class="action__box" data-box>
        <div class="action__frame">
          {has(poster) && (
            <Picture src={poster} srcMobile={stillMobile} alt="" mobileMedia={mobileMedia} sizes={stillSizes} class="action__poster" />
          )}
          <video
            class="action__video"
            muted
            loop
            playsinline
            preload="none"
            aria-label={has(videoAlt) ? videoAlt : hasTitle ? title : undefined}
            data-video
          >
            {phoneCut && <source src={videoSrcMobile} type="video/mp4" media={mobileMedia} />}
            <source src={videoSrc} type="video/mp4" />
          </video>
          <div class="action__hud" aria-hidden="true">
            <span class="corners action__corners"></span>
            <span class="action__rec"><span class="action__dot"></span>REC · CAM 01</span>
          </div>
        </div>

        {youtubeUrl && (
          <a
            class="action__yt"
            href={youtubeUrl}
            target="_blank"
            rel="noopener"
            aria-label={`${youtubeText}: canale YouTube di ${settings.siteName} (si apre in una nuova scheda)`}
          >
            <Icon name="youtube" size={20} />
            <span>{youtubeText}</span>
          </a>
        )}

        <div class="action__controls">
          <button class="action__btn" type="button" aria-label="Avvia il video" data-play>
            <Icon name="pause" size={20} class="action__ico action__ico--pause" />
            <Icon name="play" size={20} class="action__ico action__ico--play" />
          </button>
          {hasSound && (
            <button class="action__btn" type="button" aria-label="Attiva l'audio" data-sound>
              <Icon name="speakerOff" size={20} class="action__ico action__ico--muted" />
              <Icon name="speaker" size={20} class="action__ico action__ico--sound" />
            </button>
          )}
        </div>
      </div>
    </div>
  </section>
)}

<style is:global>
  .action {
    --accent: var(--color-accent);
    /* Small text and controls over the clip sit on this chip, so their contrast never depends on
       the frame behind them (A11Y-02). */
    --chip: color-mix(in srgb, var(--color-background) 82%, transparent);
    /* The wide frame: the picture of the wide cut (1920×756). A taller file is cover-cropped. */
    --ratio: 2.54;
    /* The readout's corners sit this far inside the frame; the REC chip and the controls nest
       inside them. */
    --hud-inset: clamp(0.75rem, 1.6vw, 1.25rem);
    --hud-pad: calc(var(--hud-inset) + 0.75rem);
    /* The buttons' size (A11Y-09): the chip matches their height and keeps clear of them. */
    --btn: 44px;
    /* The controls' row: play and sound, or play alone on a clip without audio. */
    --controls: calc(2 * var(--btn) + 0.5rem);
    padding-block: clamp(4rem, 9vw, 7rem) clamp(4.5rem, 10vw, 8rem);
  }
  .action--silent { --controls: var(--btn); }
  @media (max-width: 767px) and (orientation: portrait) {
    .action--portrait { --ratio: 0.8; }
  }
  /* A clip shot upright keeps its 4:5 frame on every screen. */
  .action--vertical { --ratio: 0.8; }

  /* The frame runs wider than the text column: the page width less its gutters. */
  .action__fit {
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
    padding-inline: var(--shell-gutter);
  }
  .action__box {
    position: relative;
    width: 100%;
    /* On a short, wide screen the frame narrows until the whole of it fits the screen. */
    max-width: calc((100svh - 6rem) * var(--ratio));
    margin-inline: auto;
    aspect-ratio: var(--ratio);
    /* The chip and the controls rearrange on the frame's own width (container queries below). */
    container-type: inline-size;
  }

  /* Under the copy, a portrait frame narrowed by a short screen lines up with the copy's left edge. */
  .action--vertical .action__box { margin-inline: 0; }

  /* Wide enough (a desktop, a landscape tablet or phone): the copy on the left and the 4:5 frame on
     the right, half the content width and never taller than the screen. The section takes the
     .shell's bounds itself, so its plane still runs edge to edge (DES-03). */
  @media (min-width: 1024px), (min-width: 640px) and (orientation: landscape) {
    .action--vertical {
      display: grid;
      grid-template-columns: minmax(0, 1fr) min(50%, (100svh - 6rem) * var(--ratio));
      column-gap: clamp(2.5rem, 6vw, 7rem);
      align-items: center;
      padding-inline: max(var(--shell-gutter), (100% - var(--shell-max)) / 2 + var(--shell-gutter));
    }
    .action--vertical > .shell { padding-inline: 0; }
    .action--vertical .action__fit { margin-top: 0; padding-inline: 0; }
  }

  .action__frame {
    position: absolute;
    inset: 0;
  }
  /* The poster lies under the video, which paints nothing until its first frame. */
  .action__frame > picture,
  .action__poster,
  .action__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
  .action__poster { background: var(--color-surface-2); }

  /* Camera readout: four L-shaped corners in one layer, and the REC chip. */
  .action__hud {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .action__corners {
    --arm: clamp(1rem, 2vw, 1.75rem);
    inset: var(--hud-inset);
    color: var(--accent);
  }
  .action__rec {
    position: absolute;
    top: var(--hud-pad);
    left: var(--hud-pad);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 11px;
    border-radius: 999px;
    background: var(--chip);
    font-family: var(--font-display);
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: 0.18em;
    white-space: nowrap;
    color: var(--color-accent-hover);
  }
  /* The light of the readout: the only glow the HUD allows itself. */
  .action__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px 1px color-mix(in srgb, var(--accent) 80%, transparent);
  }
  .action.is-playing .action__dot {
    animation: action-blink calc(var(--duration-slow) * 6) var(--ease-out-expo) infinite;
  }
  @keyframes action-blink { 50% { opacity: 0.25; } }

  /* Controls: over the frame's foot, on the right. */
  .action__controls {
    position: absolute;
    z-index: 2;
    right: var(--hud-pad);
    bottom: var(--hud-pad);
    display: flex;
    gap: 0.5rem;
  }
  .action__btn {
    display: grid;
    place-items: center;
    width: var(--btn);
    height: var(--btn);
    padding: 0;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 22%, transparent);
    background: var(--chip);
    color: var(--color-foreground);
    transition:
      color var(--duration-fast) var(--ease-out-expo),
      border-color var(--duration-fast) var(--ease-out-expo),
      transform var(--duration-fast) var(--ease-out-expo);
  }
  .action__btn:hover { color: var(--accent); border-color: var(--accent); }
  .action__btn:active { transform: scale(0.94); }
  /* The ring sits between two dark lines (the shadow under the outline), so it reads on any
     frame of the clip, light or dark (A11Y-02). */
  .action__btn:focus-visible,
  .action__yt:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    box-shadow: 0 0 0 5px var(--color-background);
  }
  /* The glyph shows the action the button takes: pause while playing, play while stopped. */
  .action__ico--play,
  .action__ico--sound,
  .action:not(.is-playing) .action__ico--pause,
  .action:not(.is-muted) .action__ico--muted { display: none; }
  .action:not(.is-playing) .action__ico--play,
  .action:not(.is-muted) .action__ico--sound { display: block; }
  /* The play triangle's mass sits left of its box: nudge it to the optical centre. */
  .action__ico--play { translate: 1px 0; }

  /* The channel chip: same chip and states as the buttons, at their height, mirrored on the left.
     Monochrome logo, accent on hover, like the social tiles (DES-04). */
  .action__yt {
    position: absolute;
    z-index: 2;
    left: var(--hud-pad);
    bottom: var(--hud-pad);
    display: flex;
    align-items: center;
    gap: 8px;
    height: var(--btn);
    /* Never under the controls: their row and a gap of its own. */
    max-width: calc(100% - 2 * var(--hud-pad) - var(--controls) - 0.75rem);
    padding: 0 16px 0 13px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 22%, transparent);
    background: var(--chip);
    color: var(--color-foreground);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out-expo),
      border-color var(--duration-fast) var(--ease-out-expo);
  }
  .action__yt > svg { flex: none; }
  .action__yt > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .action__yt:hover { color: var(--accent); border-color: var(--accent); }
  /* Narrow frames (the 4:5 cut on a phone): the buttons stack in their corner and the chip
     tightens, so the whole handle reads beside them. */
  @container (max-width: 380px) {
    .action__yt { gap: 6px; padding: 0 12px 0 10px; font-size: 12px; }
    .action--portrait .action__controls { flex-direction: column; }
    .action--portrait .action__yt { max-width: calc(100% - 2 * var(--hud-pad) - var(--btn) - 0.75rem); }
  }
  /* The 4:5 frame on a 320px phone. */
  @container (max-width: 280px) {
    .action__yt { gap: 5px; padding: 0 10px 0 9px; font-size: 11px; }
  }

  /* Portrait phones without the vertical cut: the wide frame is a thin strip, so the controls
     hang under it instead of covering it, and on the narrowest the REC chip bows out. */
  @media (max-width: 767px) and (orientation: portrait) {
    .action:not(.action--portrait) .action__box { margin-bottom: calc(var(--btn) + 0.75rem); }
    .action:not(.action--portrait) .action__controls { top: calc(100% + 0.75rem); right: 0; bottom: auto; }
    .action:not(.action--portrait) .action__yt { top: calc(100% + 0.75rem); left: 0; bottom: auto; max-width: calc(100% - var(--controls) - 0.75rem); }
  }
  @media (max-width: 399px) {
    .action:not(.action--portrait) .action__rec { display: none; }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-action]').forEach((root) => {
    const box = root.querySelector<HTMLElement>('[data-box]');
    const video = root.querySelector<HTMLVideoElement>('[data-video]');
    const playBtn = root.querySelector<HTMLButtonElement>('[data-play]');
    // Absent on a clip without audio.
    const soundBtn = root.querySelector<HTMLButtonElement>('[data-sound]');
    if (!box || !video || !playBtn) return;

    // A clip held with reduced motion counts as paused by the visitor until they press play.
    let userPaused = reduce && root.hasAttribute('data-hold-reduced');

    const sync = () => {
      const playing = !video.paused;
      root.classList.toggle('is-playing', playing);
      root.classList.toggle('is-muted', video.muted);
      playBtn.setAttribute('aria-label', playing ? 'Metti in pausa il video' : 'Avvia il video');
      soundBtn?.setAttribute('aria-label', video.muted ? "Attiva l'audio" : "Disattiva l'audio");
    };
    ['play', 'pause', 'volumechange'].forEach((ev) => video.addEventListener(ev, sync));
    sync();

    const play = () => void video.play().catch(() => {});

    // Fetch and play while the frame is on screen. Leaving pauses without counting as the
    // visitor's pause, so it resumes on the way back.
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) {
        if (!userPaused) play();
      } else if (!video.paused) {
        video.pause();
      }
    }, { threshold: 0.15 }).observe(box);

    playBtn.addEventListener('click', () => {
      if (video.paused) { userPaused = false; play(); }
      else { userPaused = true; video.pause(); }
    });
    soundBtn?.addEventListener('click', () => {
      video.muted = !video.muted;
      if (!video.muted && video.paused) { userPaused = false; play(); }
    });
  });
</script>

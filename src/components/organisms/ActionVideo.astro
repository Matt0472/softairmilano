---
// "Dentro l'azione": the home's video, opening as you scroll. Title and text sit above; the clip
// starts as a pill under them and widens to the full page width while the stage is pinned, then
// the camera readout (REC · CAM 01), the controls and the channel's YouTube chip lock on.
// Scroll-driven CSS on transform and opacity only. Native self-hosted <video> on Cloudflare R2
// (MEDIA-07), muted and looping: it plays whenever it is on screen, even with reduced motion and
// before the pause button shows (the user's call, known debt against A11Y-07); only the sound
// waits for a tap. A vertical 4:5 cut, when set, plays on portrait phones and pins there too.
// Static in full, frame open, with reduced motion, on short screens (RESP-07) and wherever
// scroll-driven animations or style queries are missing.

import Icon from '../atoms/Icon.astro';
import Picture from '../atoms/Picture.astro';
import SectionHead from '../molecules/SectionHead.astro';
import settings from '../../data/settings.json';
import { has } from '../../lib/fields';

interface Props {
  title: string;
  text?: string;
  /** Wide cut (R2 .mp4), ~2.54:1. */
  videoSrc: string;
  /** Vertical 4:5 cut for portrait phones (R2 .mp4). */
  videoSrcMobile?: string;
  /** A still of the wide cut, shown until the clip plays. */
  poster?: string;
  /** A still of the vertical cut. */
  posterMobile?: string;
  /** What the clip shows, for screen readers; empty uses the title. */
  videoAlt?: string;
  /** Text of the YouTube chip; empty uses the channel handle from its address. */
  youtubeLabel?: string;
  headingId?: string;
}

const { title, text, videoSrc, videoSrcMobile, poster, posterMobile, videoAlt, youtubeLabel, headingId = 'action-title' } = Astro.props;

const portraitMedia = '(max-width: 767px) and (orientation: portrait)';
const hasTitle = has(title);
const portrait = has(videoSrcMobile);
// Without the vertical cut a portrait phone shows the wide frame, so it gets the wide still too.
const stillMobile = portrait && has(posterMobile) ? posterMobile : undefined;
const youtubeUrl = settings.social?.youtube?.trim() ?? '';
const youtubeHandle = youtubeUrl.split('/').filter(Boolean).pop() ?? '';
const youtubeText = has(youtubeLabel) ? youtubeLabel : youtubeHandle.startsWith('@') ? youtubeHandle : 'YouTube';
---

{has(videoSrc) && (
  <section
    class:list={['action band', portrait && 'action--portrait']}
    aria-labelledby={hasTitle ? headingId : undefined}
    data-action
  >
    <div class="action__track" data-track>
      <span class="action__probe" aria-hidden="true" data-probe></span>
      <div class="action__stage">
        <div class="shell">
          <SectionHead title={title} text={text} id={headingId} align="center" />
        </div>

        <div class="action__fit">
          <div class="action__box" data-box>
            <div class="action__frame">
              {has(poster) && (
                <Picture src={poster} srcMobile={stillMobile} alt="" mobileMedia={portraitMedia} class="action__poster" />
              )}
              <video
                class="action__video"
                muted
                loop
                playsinline
                preload="none"
                aria-label={has(videoAlt) ? videoAlt : hasTitle ? title : undefined}
                data-video
              >
                {portrait && <source src={videoSrcMobile} type="video/mp4" media={portraitMedia} />}
                <source src={videoSrc} type="video/mp4" />
              </video>
              <span class="action__cap action__cap--tl" aria-hidden="true"></span>
              <span class="action__cap action__cap--tr" aria-hidden="true"></span>
              <span class="action__cap action__cap--bl" aria-hidden="true"></span>
              <span class="action__cap action__cap--br" aria-hidden="true"></span>
              <div class="action__hud" aria-hidden="true">
                <span class="corners action__corners"></span>
                <span class="action__rec"><span class="action__dot"></span>REC · CAM 01</span>
              </div>
            </div>

            {youtubeUrl && (
              <a
                class="action__yt"
                href={youtubeUrl}
                target="_blank"
                rel="noopener"
                aria-label={`${youtubeText}: canale YouTube di ${settings.siteName} (si apre in una nuova scheda)`}
              >
                <Icon name="youtube" size={20} />
                <span>{youtubeText}</span>
              </a>
            )}

            <div class="action__controls">
              <button class="action__btn" type="button" aria-label="Avvia il video" data-play>
                <Icon name="pause" size={20} class="action__ico action__ico--pause" />
                <Icon name="play" size={20} class="action__ico action__ico--play" />
              </button>
              <button class="action__btn" type="button" aria-label="Attiva l'audio" data-sound>
                <Icon name="speakerOff" size={20} class="action__ico action__ico--muted" />
                <Icon name="speaker" size={20} class="action__ico action__ico--sound" />
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<style is:global>
  .action {
    --accent: var(--color-accent);
    /* Small text and controls over the clip sit on this chip, so their contrast never depends on
       the frame behind them (A11Y-02). */
    --chip: color-mix(in srgb, var(--color-background) 82%, transparent);
    /* The wide frame: the picture of the wide cut (1920×756). A taller file is cover-cropped. */
    --ratio: 2.54;
    /* How small the pill starts, as a share of the open frame. */
    --s0: 0.34;
    /* The readout's corners sit this far inside the frame; the REC chip and the controls nest
       inside them. */
    --hud-inset: clamp(0.75rem, 1.6vw, 1.25rem);
    --hud-pad: calc(var(--hud-inset) + 0.75rem);
    /* The buttons' size (A11Y-09): the chip matches their height and keeps clear of them. */
    --btn: 44px;
    padding-bottom: clamp(4.5rem, 10vw, 8rem);
  }
  @media (max-width: 767px) and (orientation: portrait) {
    .action--portrait { --ratio: 0.8; --s0: 0.5; }
  }

  .action__stage { padding-top: clamp(4rem, 9vw, 7rem); }
  .action__fit {
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
    padding-inline: var(--shell-gutter);
  }
  .action__box {
    position: relative;
    width: 100%;
    margin-inline: auto;
    aspect-ratio: var(--ratio);
    /* The caps size themselves on the frame's short side (cq units). */
    container-type: size;
  }

  /* Not clipped: the video rounds its own corners, so the caps can overhang its edges. The pill
     hangs from the top, just under the heading, and grows down. */
  .action__frame {
    position: absolute;
    inset: 0;
    transform-origin: 50% 0;
  }
  /* The poster lies under the video, which paints nothing until its first frame. */
  .action__frame > picture,
  .action__poster,
  .action__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
  .action__poster { background: var(--color-surface-2); }

  /* Round ends of the pill: a square as deep as half the frame's short side, painted in the band
     colour outside a quarter circle. At full size they make the frame a pill; shrunk to the
     frame's own radius they vanish into it. They overhang the frame by --bleed, so no
     anti-aliased sliver of video shows along the pill's edge. Only shown while the stage is pinned. */
  .action__cap {
    --cap: min(50cqw, 50cqh);
    --bleed: 2px;
    --b: calc(100% - var(--bleed));
    position: absolute;
    z-index: 2;
    display: none;
    width: calc(var(--cap) + var(--bleed));
    height: calc(var(--cap) + var(--bleed));
    pointer-events: none;
  }
  .action__cap--tl { top: calc(var(--bleed) * -1); left: calc(var(--bleed) * -1); transform-origin: var(--bleed) var(--bleed); background: radial-gradient(circle var(--cap) at 100% 100%, transparent calc(100% - 1px), var(--plane)); }
  .action__cap--tr { top: calc(var(--bleed) * -1); right: calc(var(--bleed) * -1); transform-origin: var(--b) var(--bleed); background: radial-gradient(circle var(--cap) at 0 100%, transparent calc(100% - 1px), var(--plane)); }
  .action__cap--bl { bottom: calc(var(--bleed) * -1); left: calc(var(--bleed) * -1); transform-origin: var(--bleed) var(--b); background: radial-gradient(circle var(--cap) at 100% 0, transparent calc(100% - 1px), var(--plane)); }
  .action__cap--br { bottom: calc(var(--bleed) * -1); right: calc(var(--bleed) * -1); transform-origin: var(--b) var(--b); background: radial-gradient(circle var(--cap) at 0 0, transparent calc(100% - 1px), var(--plane)); }

  /* Camera readout: four L-shaped corners in one layer, and the REC chip. */
  .action__hud {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }
  .action__corners {
    --arm: clamp(1rem, 2vw, 1.75rem);
    inset: var(--hud-inset);
    color: var(--accent);
  }
  .action__rec {
    position: absolute;
    top: var(--hud-pad);
    left: var(--hud-pad);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 11px;
    border-radius: 999px;
    background: var(--chip);
    font-family: var(--font-display);
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: 0.18em;
    white-space: nowrap;
    color: var(--color-accent-hover);
  }
  /* The light of the readout: the only glow the HUD allows itself. */
  .action__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px 1px color-mix(in srgb, var(--accent) 80%, transparent);
  }
  .action.is-playing .action__dot {
    animation: action-blink calc(var(--duration-slow) * 6) var(--ease-out-expo) infinite;
  }
  @keyframes action-blink { 50% { opacity: 0.25; } }

  /* Controls: outside the scaled frame, so they keep their size; over its foot, on the right. */
  .action__controls {
    position: absolute;
    z-index: 4;
    right: var(--hud-pad);
    bottom: var(--hud-pad);
    display: flex;
    gap: 0.5rem;
  }
  .action__btn {
    display: grid;
    place-items: center;
    width: var(--btn);
    height: var(--btn);
    padding: 0;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 22%, transparent);
    background: var(--chip);
    color: var(--color-foreground);
    transition:
      color var(--duration-fast) var(--ease-out-expo),
      border-color var(--duration-fast) var(--ease-out-expo),
      transform var(--duration-fast) var(--ease-out-expo);
  }
  .action__btn:hover { color: var(--accent); border-color: var(--accent); }
  .action__btn:active { transform: scale(0.94); }
  /* The ring sits between two dark lines (the shadow under the outline), so it reads on any
     frame of the clip, light or dark (A11Y-02). */
  .action__btn:focus-visible,
  .action__yt:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    box-shadow: 0 0 0 5px var(--color-background);
  }
  /* The glyph shows the action the button takes: pause while playing, play while stopped. */
  .action__ico--play,
  .action__ico--sound,
  .action:not(.is-playing) .action__ico--pause,
  .action:not(.is-muted) .action__ico--muted { display: none; }
  .action:not(.is-playing) .action__ico--play,
  .action:not(.is-muted) .action__ico--sound { display: block; }
  /* The play triangle's mass sits left of its box: nudge it to the optical centre. */
  .action__ico--play { translate: 1px 0; }

  /* The channel chip: same chip and states as the buttons, at their height, mirrored on the left.
     Monochrome logo, accent on hover, like the social tiles (DES-04). */
  .action__yt {
    position: absolute;
    z-index: 4;
    left: var(--hud-pad);
    bottom: var(--hud-pad);
    display: flex;
    align-items: center;
    gap: 8px;
    height: var(--btn);
    /* Never under the controls: two buttons, their gap and a gap of its own. */
    max-width: calc(100% - 2 * var(--hud-pad) - 2 * var(--btn) - 1.25rem);
    padding: 0 16px 0 13px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 22%, transparent);
    background: var(--chip);
    color: var(--color-foreground);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out-expo),
      border-color var(--duration-fast) var(--ease-out-expo);
  }
  .action__yt > svg { flex: none; }
  .action__yt > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .action__yt:hover { color: var(--accent); border-color: var(--accent); }
  /* Narrow frames (the 4:5 cut on a phone): the buttons stack in their corner and the chip
     tightens, so the whole handle reads beside them. */
  @container (max-width: 380px) {
    .action__yt { gap: 6px; padding: 0 12px 0 10px; font-size: 12px; }
    .action--portrait .action__controls { flex-direction: column; }
    .action--portrait .action__yt { max-width: calc(100% - 2 * var(--hud-pad) - var(--btn) - 0.75rem); }
  }
  /* The 4:5 frame on a 320px phone. */
  @container (max-width: 280px) {
    .action__yt { gap: 5px; padding: 0 10px 0 9px; font-size: 11px; }
  }

  /* Portrait phones without the vertical cut: the wide frame is a thin strip, so the controls
     hang under it instead of covering it, and on the narrowest the REC chip bows out. */
  @media (max-width: 767px) and (orientation: portrait) {
    .action:not(.action--portrait) .action__box { margin-bottom: calc(var(--btn) + 0.75rem); }
    .action:not(.action--portrait) .action__controls { top: calc(100% + 0.75rem); right: 0; bottom: auto; }
    .action:not(.action--portrait) .action__yt { top: calc(100% + 0.75rem); left: 0; bottom: auto; max-width: calc(100% - 2 * var(--btn) - 1.25rem); }
  }
  @media (max-width: 399px) {
    .action:not(.action--portrait) .action__rec { display: none; }
  }

  .action__probe { display: none; }

  /*
    Pinned stage (tall enough screens, motion allowed, scroll-driven animations): the track gives
    the scroll its length, the stage stays put and the frame grows to fill what the heading leaves.
    The flag is set per orientation, the layout keyed on it with a style query, so the rules are
    written once. The ranges run on the track: the pill grows from just before the pin to past its
    middle, then the readout and the controls lock on and the frame holds open until it leaves.
    Linear on purpose: the scroll is the clock, and Lenis already eases it.
    Longhand properties only (CODE-19).
  */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-height: 560px) and (orientation: landscape) {
      .action { --pin: 1; }
    }
    @media (prefers-reduced-motion: no-preference) and (min-height: 560px) and (max-width: 767px) and (orientation: portrait) {
      .action--portrait { --pin: 1; }
    }

    @container style(--pin: 1) {
      /* Inset 0: the timeline spans the whole viewport, not the root's scroll-padding, so the
         ranges below and the probe share one geometry. */
      .action__track {
        position: relative;
        height: 230svh;
        view-timeline: --action block;
        view-timeline-inset: 0;
      }
      .action__stage {
        position: sticky;
        top: 0;
        height: 100svh;
        display: flex;
        flex-direction: column;
        padding-block: clamp(3rem, 10svh, 6rem) clamp(1.5rem, 5svh, 3rem);
      }
      .action__fit {
        flex: 1;
        min-height: 0;
        container-type: size;
        display: grid;
        place-items: center;
      }
      .action__box { width: min(100cqw, 100cqh * var(--ratio)); }
      /* Portrait phones: the 4:5 frame takes the stage's whole height, so its foot (and the
         controls) stays clear of the fixed back-to-top button (44px, 20px off the edge). */
      @media (max-width: 767px) and (orientation: portrait) {
        .action__stage { padding-bottom: 4.5rem; }
      }
      /* Short phones (RESP-07): less air above the heading, so the frame keeps its size. */
      @media (max-width: 767px) and (orientation: portrait) and (max-height: 700px) {
        .action__stage { padding-top: 2.5rem; }
        .action__fit { margin-top: 1.25rem; }
      }

      .action__frame,
      .action__cap,
      .action__hud,
      .action__corners,
      .action__controls,
      .action__yt {
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --action;
      }
      .action__frame { animation-name: action-open; }
      .action__cap { display: block; animation-name: action-cap; }
      .action__frame,
      .action__cap { animation-range: entry 80% contain 55%; }
      .action__hud { animation-name: action-lock; }
      .action__corners { animation-name: action-corners; }
      .action__controls { animation-name: action-controls; transform-origin: 100% 100%; }
      .action__yt { animation-name: action-controls; transform-origin: 0 100%; }
      /* The lock range: its end (contain 60%) is where the probe below starts. */
      .action__hud,
      .action__corners,
      .action__controls,
      .action__yt { animation-range: contain 48% contain 60%; }
      /* A keyboard user reaching the controls early sees them (the script also opens the frame). */
      .action__controls:focus-within,
      .action__yt:focus-visible { opacity: 1 !important; transform: none !important; }

      /* From the end of the lock range to the end of the track: the scroll position where the
         controls are fully in, where the keyboard jump lands. `contain p%` is the track's top
         plus p of (its height − the viewport). */
      .action__probe {
        display: block;
        position: absolute;
        left: 0;
        bottom: 0;
        width: 1px;
        top: calc((100% - 100svh) * 0.6);
        pointer-events: none;
        visibility: hidden;
      }
    }
  }
  @keyframes action-open { from { transform: scale(var(--s0)); } }
  /* The caps stay full (a pill) for most of the growth, then square up to the frame's radius. */
  @keyframes action-cap {
    0%, 55% { transform: none; }
    100% { transform: scale(var(--cap-end, 0.06)); }
  }
  @keyframes action-lock { from { opacity: 0; } }
  /* Scaled to nothing until the reveal starts, so the hidden buttons cannot be hit by a stray
     click; then they settle in with the readout. */
  @keyframes action-controls {
    0% { opacity: 0; transform: scale(0); }
    1% { opacity: 0; transform: scale(0.9); }
  }
  @keyframes action-corners { from { transform: scale(1.04); } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-action]');
  const video = root?.querySelector<HTMLVideoElement>('[data-video]');
  const playBtn = root?.querySelector<HTMLButtonElement>('[data-play]');
  const soundBtn = root?.querySelector<HTMLButtonElement>('[data-sound]');

  if (root && video && playBtn && soundBtn) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const box = root.querySelector<HTMLElement>('[data-box]')!;
    const probe = root.querySelector<HTMLElement>('[data-probe]')!;
    let userPaused = false;

    const sync = () => {
      const playing = !video.paused;
      root.classList.toggle('is-playing', playing);
      root.classList.toggle('is-muted', video.muted);
      playBtn.setAttribute('aria-label', playing ? 'Metti in pausa il video' : 'Avvia il video');
      soundBtn.setAttribute('aria-label', video.muted ? "Attiva l'audio" : "Disattiva l'audio");
    };
    ['play', 'pause', 'volumechange'].forEach((ev) => video.addEventListener(ev, sync));
    sync();

    const play = () => void video.play().catch(() => {});
    // The CSS pins the stage (and makes the track tall) only where the story runs.
    const pinned = () => track.offsetHeight > innerHeight * 1.5;

    // Fetch and play while the frame is on screen, pill or open. Leaving pauses without counting
    // as the visitor's pause, so it resumes on the way back.
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) {
        if (!userPaused) play();
      } else if (!video.paused) {
        video.pause();
      }
    }, { threshold: 0.15 }).observe(box);

    playBtn.addEventListener('click', () => {
      if (video.paused) { userPaused = false; play(); }
      else { userPaused = true; video.pause(); }
    });
    soundBtn.addEventListener('click', () => {
      video.muted = !video.muted;
      if (!video.muted && video.paused) { userPaused = false; play(); }
    });

    // The caps end at the video's own radius: their last scale is that radius over their size,
    // a ratio CSS cannot divide out. Measured on resize only.
    const fitCaps = () => {
      const cap = Math.min(box.clientWidth, box.clientHeight) / 2;
      const radius = parseFloat(getComputedStyle(video).borderTopLeftRadius) || 0;
      if (cap > 0) root.style.setProperty('--cap-end', String(Math.min(1, radius / cap)));
    };
    new ResizeObserver(fitCaps).observe(box);

    // Tabbing into the chip or the controls before the frame has opened jumps the scroll to where
    // they have locked on (the probe), so the focused control is not floating beside a pill. A
    // jump, not a glide. Keyboard focus only: a click lands on controls that are already there.
    // They are the box's only focusable children (the video has no native controls).
    box.addEventListener('focusin', (e) => {
      if (!pinned() || !(e.target as HTMLElement).matches(':focus-visible')) return;
      const open = Math.ceil(probe.getBoundingClientRect().top + scrollY) + 2;
      if (scrollY >= open) return;
      const lenis = (window as any).__lenis;
      if (lenis) lenis.scrollTo(open, { immediate: true });
      else scrollTo({ top: open });
    });
  }
</script>

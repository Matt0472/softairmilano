---
import navigation from '../../data/navigation.json';
import settings from '../../data/settings.json';
import Icon from '../atoms/Icon.astro';
import type { NavItem } from '../../lib/nav';
import { telHref } from '../../lib/phone';

// Same rule as the header: an entry with neither a link nor sub-items has nothing to show.
const items = (navigation.items as NavItem[])
  .map((it) => ({ ...it, children: it.children?.filter((c) => c.label && c.href) }))
  .filter((it) => it.label && (it.href || it.children?.length));
const { siteName } = settings;
const social: Partial<Record<'instagram' | 'facebook' | 'youtube' | 'tiktok', string>> = settings.social ?? {};
const socials = [
  { key: 'instagram', label: 'Instagram' },
  { key: 'facebook', label: 'Facebook' },
  { key: 'youtube', label: 'YouTube' },
  { key: 'tiktok', label: 'TikTok' },
] as const;
const ranger: { title?: string; label?: string; text?: string } = settings.footerRanger ?? {};
const tel = telHref(settings.phone);
const year = new Date().getFullYear();

// Every footer link is a 44px row (RESP-04); the rows replace the list gaps.
const linkClass = 'flex min-h-11 w-fit min-w-11 items-center text-sm text-foreground transition-colors hover:text-accent';
---

<footer class="mt-24 border-t border-border bg-surface">
  {/* From xl the menu splits in two columns, so its track is a little wider than the others. */}
  <div class="shell grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4 xl:grid-cols-[1fr_1.25fr_1fr_1fr]">
    <div class="min-w-0">
      <a href="/" class="inline-block" aria-label={`${siteName} — home`}>
        <img src="/logo/logo-white-120.webp" alt={siteName} width="121" height="120" class="h-14 w-auto" />
      </a>
      {settings.footerTagline && <p class="mt-3 max-w-xs text-sm text-muted">{settings.footerTagline}</p>}

      {/* Pulled left by the icon's inset, so the glyph lines up with the text above. */}
      <div class="mt-3 -ml-3 flex items-center">
        {socials.filter((s) => social[s.key]).map((s) => (
          <a
            href={social[s.key]}
            target="_blank"
            rel="noopener"
            aria-label={s.label}
            class="inline-flex size-11 items-center justify-center text-muted transition-colors hover:text-accent"
          >
            <Icon name={s.key} size={20} />
          </a>
        ))}
      </div>
    </div>

    <div class="min-w-0">
      <h3 class="text-xs uppercase tracking-wider text-muted">Menu</h3>
      <ul class="mt-1 columns-2 gap-x-6 lg:columns-1 xl:columns-2">
        {
          items.map((it) =>
            it.children?.length ? (
              <li class="break-inside-avoid">
                <span class="flex min-h-11 items-center text-sm text-muted">{it.label}</span>
                <ul class="border-l border-border pl-3">
                  {it.children.map((c) => (
                    <li>
                      <a href={c.href} class={linkClass}>{c.label}</a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="break-inside-avoid">
                <a href={it.href} class={linkClass}>{it.label}</a>
              </li>
            )
          )
        }
      </ul>
    </div>

    <div class="min-w-0">
      <h3 class="text-xs uppercase tracking-wider text-muted">Contatti</h3>
      <ul class="mt-1 text-sm">
        {settings.email && <li><a href={`mailto:${settings.email}`} class:list={[linkClass, 'wrap-anywhere']}>{settings.email}</a></li>}
        {tel && <li><a href={tel} class={linkClass}>{settings.phone}</a></li>}
        {settings.address && <li class="py-3 text-muted wrap-anywhere">{settings.address}</li>}
      </ul>
    </div>

    {settings.rangerUrl && ranger.label && (
      <div class="min-w-0">
        {ranger.title && <h3 class="text-xs uppercase tracking-wider text-muted">{ranger.title}</h3>}
        <a
          href={settings.rangerUrl}
          target="_blank"
          rel="noopener"
          class="mt-1 inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-foreground transition-colors hover:text-accent"
        >
          {ranger.label}
          <Icon name="arrowUpRight" size={16} />
          <span class="sr-only">(si apre in una nuova scheda)</span>
        </a>
        {ranger.text && <p class="text-sm text-muted">{ranger.text}</p>}
      </div>
    )}
  </div>

  <div class="border-t border-border">
    {/* The right padding keeps the last legal link clear of the fixed back-to-top button (44px, 20px from the edge). */}
    <div class="shell grid gap-x-4 py-3 text-xs text-muted md:grid-cols-3 md:items-center md:pr-20">
      <span class="flex min-h-11 items-center md:justify-self-start">© {year} {siteName}</span>
      <span class="inline-flex items-center gap-1 md:justify-self-center">
        Made with
        <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" class="text-accent" role="img" aria-label="cuore">
          <path d="M12 21s-6.7-4.35-9.5-8.28C.9 10.3 1.6 6.9 4.3 5.6c1.9-.9 4.1-.3 5.3 1.3L12 9l2.4-2.1c1.2-1.6 3.4-2.2 5.3-1.3 2.7 1.3 3.4 4.7 1.8 7.12C18.7 16.65 12 21 12 21z"></path>
        </svg>
        by
        <a
          href="https://mapped-dev.it"
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-11 items-center font-medium text-foreground transition-colors hover:text-accent"
        >
          Mattia Pedone
        </a>
      </span>

      <nav class="flex gap-3 md:justify-self-end" aria-label="Note legali">
        <a href="/privacy" class="inline-flex min-h-11 min-w-11 items-center justify-center transition-colors hover:text-foreground">Privacy</a>
        <a href="/cookie" class="inline-flex min-h-11 min-w-11 items-center justify-center transition-colors hover:text-foreground">Cookie</a>
        <a href="/termini" class="inline-flex min-h-11 min-w-11 items-center justify-center transition-colors hover:text-foreground">Termini</a>
      </nav>
    </div>
  </div>
</footer>

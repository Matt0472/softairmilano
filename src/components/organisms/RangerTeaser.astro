---
// The outdoor arena, Ranger Softair Milano: a sister site, so the whole section is one link to it
// and opens a new tab. No button: the domain with its arrow says where the click goes, and the
// section answers hover and focus as a whole. It speaks the Ranger palette, here only (DES-12):
// a warm earth veil over the photo, sand body copy, amber for the domain and one rule. The kicker
// names the other arena above the title, so neither a reader nor a search engine takes the wood
// for this one (SEO-08).
// The link is the domain line, stretched over the section, so its name stays short and clear; a
// transform on the copy or the inner shell would shrink that stretched area, so only the title and
// the text make an entrance and the press moves the photo, never the link's ancestors.

import Icon from '../atoms/Icon.astro';
import Picture from '../atoms/Picture.astro';
import { has } from '../../lib/fields';
import { keepShortWords } from '../../lib/typography';

interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  href?: string;
  image?: string;
  imageMobile?: string;
  imageAlt?: string;
  headingId?: string;
}

const { eyebrow, title, text, href, image, imageMobile, imageAlt = '', headingId = 'ranger-title' } = Astro.props;

// "Ranger Softair Milano · arena all'aperto": a wrapped kicker never starts its line on the dot.
const keepDots = (s: string) => s.replace(/\s+·\s+/g, '\u00A0· ');

// "https://www.rangersoftairmilano.it/" → "rangersoftairmilano.it": the cue names the destination.
let domain = '';
try {
  domain = has(href) ? new URL(href).hostname.replace(/^www\./, '') : '';
} catch {
  domain = '';
}
---

{has(title) && domain && (
  <section class:list={['rgr', !has(image) && 'rgr--plain']} aria-labelledby={headingId}>
    {has(image) && (
      <div class="rgr__media">
        <Picture src={image} srcMobile={imageMobile} mobileMedia="(max-width: 599px)" alt={imageAlt} sizes="100vw" class="rgr__img" />
      </div>
    )}
    <div class="shell rgr__inner">
      <div class="rgr__copy">
        <span class="rgr__rule" aria-hidden="true"></span>
        {has(eyebrow) && <p class="rgr__kicker" data-reveal>{keepDots(eyebrow)}</p>}
        <h2 class="rgr__title" id={headingId} data-reveal>{keepShortWords(title)}</h2>
        {has(text) && <p class="rgr__text" data-reveal style="--i: 1">{text}</p>}
        <a class="rgr__link" href={href} target="_blank" rel="noopener">
          <span class="rgr__domain">{domain}</span>
          <Icon name="arrowUpRight" size={20} class="rgr__arrow" />
          <span class="sr-only"> (si apre in una nuova scheda)</span>
        </a>
      </div>
    </div>
  </section>
)}

<style is:global>
  .rgr {
    --accent: var(--color-accent);
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--color-ranger-earth);
    color: var(--color-foreground);
  }

  .rgr__media,
  .rgr__media picture,
  .rgr__img {
    width: 100%;
    height: 100%;
  }
  .rgr__media picture { display: block; }
  .rgr__img {
    display: block;
    object-fit: cover;
    /* The scene sits a little above centre: keep the helmet in every crop. */
    object-position: 50% 35%;
    transition: transform calc(var(--duration-slow) * 3) var(--ease-out-expo);
  }

  /* Phones and tablets: the photo on top dissolves into the earth below, and the copy sits on it.
     Portrait phones get the vertical photo; landscape phones and tablets the wide one. */
  .rgr__media {
    position: relative;
    z-index: -1;
    aspect-ratio: 16 / 9;
    -webkit-mask-image: linear-gradient(to bottom, black 50%, transparent 98%);
    mask-image: linear-gradient(to bottom, black 50%, transparent 98%);
  }
  @media (max-width: 599px) {
    .rgr__media { aspect-ratio: 4 / 5; }
  }
  /* The copy rides up onto the photo's floor, so the floor deepens toward the earth it dissolves into:
     the kicker, the smallest type, stays at 4.5:1 over the lit ground of the wide photo (A11Y-02). */
  @media (max-width: 1023px) {
    .rgr__media::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(0deg, color-mix(in srgb, var(--color-ranger-earth) 70%, transparent) 0%, color-mix(in srgb, var(--color-ranger-earth) 45%, transparent) 40%, transparent 70%);
    }
  }
  .rgr__inner {
    margin-top: clamp(-9rem, -22vw, -4rem);
    padding-bottom: clamp(3.5rem, 9vw, 5rem);
  }
  .rgr--plain .rgr__inner { margin-top: 0; padding-top: clamp(3.5rem, 9vw, 5rem); }

  .rgr__copy { max-width: 36rem; }
  .rgr__rule {
    display: block;
    width: 3.5rem;
    height: 2px;
    margin-bottom: 1.25rem;
    background: var(--color-ranger-amber);
    transform-origin: left center;
    transition: transform calc(var(--duration-slow) * 1.5) var(--ease-out-expo);
  }
  .rgr__kicker {
    margin: 0 0 0.85rem;
    color: var(--color-ranger-sand);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-wrap: balance;
    text-shadow: 0 1px 12px color-mix(in srgb, var(--color-ranger-earth) 85%, transparent);
  }
  .rgr__title {
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4.4vw, 3.6rem);
    line-height: 1.12;
    letter-spacing: 0.01em;
    text-wrap: balance;
    text-shadow: 0 2px 18px color-mix(in srgb, var(--color-ranger-earth) 80%, transparent);
  }
  .rgr__text {
    margin: 1.1rem 0 0;
    max-width: 46ch;
    color: var(--color-ranger-sand);
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    line-height: 1.6;
    text-wrap: pretty;
    text-shadow: 0 1px 12px color-mix(in srgb, var(--color-ranger-earth) 85%, transparent);
  }

  /* The domain line: amber, the only amber text, with an underline that draws in on hover. */
  .rgr__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    margin-top: 1.6rem;
    color: var(--color-ranger-amber);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .rgr__domain {
    position: relative;
    padding-bottom: 2px;
    transition: transform var(--duration-fast) var(--ease-out-expo);
  }
  .rgr__domain::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--duration-slow) var(--ease-out-expo);
  }
  .rgr__arrow { transition: transform var(--duration-slow) var(--ease-out-expo); }
  /* Stretched over the whole section: one target, one name. */
  .rgr__link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  /* The ring goes round the section (the real target), inside its edges since it runs full bleed.
     A dark line on either side of the cyan keeps it at 3:1 over the sunlit foliage too (A11Y-02). */
  .rgr__link:focus-visible { outline: none; }
  .rgr::after {
    content: "";
    position: absolute;
    z-index: 2;
    inset: 4px;
    border: 2px solid var(--accent);
    box-shadow:
      0 0 0 2px var(--color-ranger-earth),
      inset 0 0 0 2px var(--color-ranger-earth);
    pointer-events: none;
    opacity: 0;
  }
  .rgr:has(.rgr__link:focus-visible)::after { opacity: 1; }

  .rgr:has(.rgr__link:focus-visible) .rgr__img { transform: scale(1.03); }
  .rgr:has(.rgr__link:focus-visible) .rgr__domain::after { transform: scaleX(1); }
  .rgr:has(.rgr__link:focus-visible) .rgr__arrow { transform: translate(3px, -3px); }
  .rgr:has(.rgr__link:focus-visible) .rgr__rule { transform: scaleX(1.6); }
  @media (hover: hover) {
    .rgr:hover .rgr__img { transform: scale(1.03); }
    .rgr:hover .rgr__domain::after { transform: scaleX(1); }
    .rgr:hover .rgr__arrow { transform: translate(3px, -3px); }
    .rgr:hover .rgr__rule { transform: scaleX(1.6); }
  }
  /* Press: the photo settles back a touch and the domain dips, as a button would. */
  .rgr:active .rgr__img { transform: scale(1.015); }
  .rgr:active .rgr__domain { transform: translateY(1px); }

  /* Desktop: the photo fills the section and the copy rides on the dark trunk at its left. */
  @media (min-width: 1024px) {
    .rgr { min-height: clamp(30rem, 42vw, 46rem); display: flex; }
    .rgr__media {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
    /* The veil: warm earth from the left and a little from the floor, clear over the players. */
    .rgr__media::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(90deg, color-mix(in srgb, var(--color-ranger-earth) 85%, transparent) 0%, color-mix(in srgb, var(--color-ranger-earth) 62%, transparent) 36%, color-mix(in srgb, var(--color-ranger-earth) 25%, transparent) 50%, transparent 64%),
        linear-gradient(0deg, color-mix(in srgb, var(--color-ranger-earth) 45%, transparent) 0%, transparent 32%);
    }
    .rgr__inner {
      display: flex;
      align-items: center;
      margin-top: 0;
      padding-block: clamp(4rem, 7vw, 6rem);
    }
    .rgr__copy { max-width: min(36rem, 44%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .rgr:hover .rgr__img,
    .rgr:active .rgr__img,
    .rgr:has(.rgr__link:focus-visible) .rgr__img { transform: none; }
  }
</style>

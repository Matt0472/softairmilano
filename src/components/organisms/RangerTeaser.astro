---
// The outdoor arena, Ranger Softair Milano: a sister site, so the section is one card in the page
// column, and the whole card is one link to it that opens a new tab. No button: the domain with
// its arrow says where the click goes, and the card answers hover and focus as a whole. It speaks
// the Ranger palette, here only (DES-12): its photo under a warm earth veil, sand body copy, amber
// for the domain and one rule. The kicker names the other arena above the title, so neither a
// reader nor a search engine takes the wood for this one (SEO-08).
// The link is the domain line, stretched over the card, so its name stays short and clear. The
// card itself makes the entrance: a transform on the copy would shrink that stretched area to it.

import Icon from '../atoms/Icon.astro';
import Picture from '../atoms/Picture.astro';
import { has } from '../../lib/fields';
import { keepShortWords } from '../../lib/typography';

interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  href?: string;
  image?: string;
  imageMobile?: string;
  imageAlt?: string;
  headingId?: string;
}

const { eyebrow, title, text, href, image, imageMobile, imageAlt = '', headingId = 'ranger-title' } = Astro.props;

// "Ranger Softair Milano · arena all'aperto": a wrapped kicker never starts its line on the dot.
const keepDots = (s: string) => s.replace(/\s+·\s+/g, '\u00a0· ');

// "https://www.rangersoftairmilano.it/" → "rangersoftairmilano.it": the cue names the destination.
let domain = '';
try {
  domain = has(href) ? new URL(href).hostname.replace(/^www\./, '') : '';
} catch {
  domain = '';
}

// Rendered width of the photo (PERF-04): the card fills the page column (shell max 1520px).
const sizes = '(max-width: 767px) calc(100vw - 2.5rem), (max-width: 1520px) calc(100vw - 4rem), 1456px';
---

{has(title) && domain && (
  <section class="rgr band" aria-labelledby={headingId}>
    <div class="shell">
      <div class:list={['rgr__card', !has(image) && 'rgr__card--plain']} data-reveal>
        {has(image) && (
          <div class="rgr__media">
            <Picture src={image} srcMobile={imageMobile} mobileMedia="(max-width: 599px)" alt={imageAlt} sizes={sizes} class="rgr__img" />
          </div>
        )}
        <div class="rgr__copy">
          <span class="rgr__rule" aria-hidden="true"></span>
          {has(eyebrow) && <p class="rgr__kicker">{keepDots(eyebrow)}</p>}
          <h2 class="rgr__title" id={headingId}>{keepShortWords(title)}</h2>
          {has(text) && <p class="rgr__text">{text}</p>}
          <a class="rgr__link" href={href} target="_blank" rel="noopener">
            <span class="rgr__domain">{domain}</span>
            <Icon name="arrowUpRight" size={20} class="rgr__arrow" />
            <span class="sr-only"> (si apre in una nuova scheda)</span>
          </a>
        </div>
      </div>
    </div>
  </section>
)}

<style is:global>
  .rgr {
    --accent: var(--color-accent);
    padding-block: clamp(3.5rem, 7vw, 5.5rem) clamp(4rem, 8vw, 6.5rem);
  }

  .rgr__card {
    position: relative;
    isolation: isolate;
    overflow: clip;
    border-radius: var(--radius-lg);
    background: var(--color-ranger-earth);
    color: var(--color-foreground);
  }
  /* The card's edge: a faint sand hairline drawn over the photo, not a border around it. */
  .rgr__card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-ranger-sand) 12%, transparent);
    pointer-events: none;
  }

  .rgr__media,
  .rgr__media picture,
  .rgr__img {
    width: 100%;
    height: 100%;
  }
  .rgr__media picture { display: block; }
  .rgr__img {
    display: block;
    object-fit: cover;
    /* The scene sits a little above centre: keep the helmet in every crop. */
    object-position: 50% 30%;
    transition: transform calc(var(--duration-slow) * 3) var(--ease-out-expo);
  }

  /* Phones and tablets: the photo heads the card and dissolves into the earth below it, and the
     copy rides up onto its floor. Portrait phones get the vertical photo, cut to its upper part
     where the players are; landscape phones and tablets the wide one. */
  .rgr__media {
    position: relative;
    z-index: -1;
    aspect-ratio: 12 / 5;
    -webkit-mask-image: linear-gradient(to bottom, black 50%, transparent 98%);
    mask-image: linear-gradient(to bottom, black 50%, transparent 98%);
  }
  @media (max-width: 599px) {
    .rgr__media { aspect-ratio: 3 / 2; }
    .rgr__img { object-position: 50% 15%; }
  }
  /* The copy rides up onto the photo's floor, so the floor deepens toward the earth it dissolves into:
     the kicker, the smallest type, stays at 4.5:1 over the lit ground of the photo (A11Y-02). */
  @media (max-width: 1023px) {
    .rgr__media::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(0deg, color-mix(in srgb, var(--color-ranger-earth) 70%, transparent) 0%, color-mix(in srgb, var(--color-ranger-earth) 45%, transparent) 40%, transparent 70%);
    }
  }

  .rgr__copy {
    max-width: 40rem;
    margin-top: clamp(-4rem, -9vw, -2.5rem);
    padding: 0 clamp(1.25rem, 5vw, 2.5rem) clamp(1.5rem, 5vw, 2.5rem);
  }
  .rgr__card--plain .rgr__copy { margin-top: 0; padding-top: clamp(1.75rem, 5vw, 2.5rem); }

  .rgr__rule {
    display: block;
    width: 3rem;
    height: 2px;
    margin-bottom: 1rem;
    background: var(--color-ranger-amber);
    transform-origin: left center;
    transition: transform calc(var(--duration-slow) * 1.5) var(--ease-out-expo);
  }
  .rgr__kicker {
    margin: 0 0 0.7rem;
    color: var(--color-ranger-sand);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-wrap: balance;
    text-shadow: 0 1px 12px color-mix(in srgb, var(--color-ranger-earth) 85%, transparent);
  }
  .rgr__title {
    margin: 0;
    max-width: 20ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 3vw, 2.6rem);
    line-height: 1.12;
    letter-spacing: 0.01em;
    text-wrap: balance;
    text-shadow: 0 2px 18px color-mix(in srgb, var(--color-ranger-earth) 80%, transparent);
  }
  .rgr__text {
    margin: 0.9rem 0 0;
    max-width: 52ch;
    color: var(--color-ranger-sand);
    font-size: 1rem;
    line-height: 1.6;
    text-wrap: pretty;
    text-shadow: 0 1px 12px color-mix(in srgb, var(--color-ranger-earth) 85%, transparent);
  }

  /* The domain line: amber, the only amber text, with an underline that draws in on hover. */
  .rgr__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    margin-top: 1.1rem;
    color: var(--color-ranger-amber);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .rgr__domain {
    position: relative;
    padding-bottom: 2px;
    transition: transform var(--duration-fast) var(--ease-out-expo);
  }
  .rgr__domain::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--duration-slow) var(--ease-out-expo);
  }
  .rgr__arrow { transition: transform var(--duration-slow) var(--ease-out-expo); }
  /* Stretched over the whole card: one target, one name. */
  .rgr__link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  /* The ring goes round the card (the real target), on the band just outside its edge. */
  .rgr__link:focus-visible { outline: none; }
  .rgr__card:has(.rgr__link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .rgr__card:has(.rgr__link:focus-visible) .rgr__img { transform: scale(1.03); }
  .rgr__card:has(.rgr__link:focus-visible) .rgr__domain::after { transform: scaleX(1); }
  .rgr__card:has(.rgr__link:focus-visible) .rgr__arrow { transform: translate(3px, -3px); }
  .rgr__card:has(.rgr__link:focus-visible) .rgr__rule { transform: scaleX(1.6); }
  @media (hover: hover) {
    .rgr__card:hover .rgr__img { transform: scale(1.03); }
    .rgr__card:hover .rgr__domain::after { transform: scaleX(1); }
    .rgr__card:hover .rgr__arrow { transform: translate(3px, -3px); }
    .rgr__card:hover .rgr__rule { transform: scaleX(1.6); }
  }
  /* Press: the photo settles back a touch and the domain dips, as a button would. */
  .rgr__card:active .rgr__img { transform: scale(1.015); }
  .rgr__card:active .rgr__domain { transform: translateY(1px); }

  /* Desktop: the photo fills the card and the copy rides on the dark trunk at its left. */
  @media (min-width: 1024px) {
    .rgr__card {
      display: flex;
      align-items: center;
      min-height: clamp(24rem, 30vw, 28rem);
    }
    .rgr__media {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
    /* The veil: warm earth from the left and a little from the floor, clear over the players. */
    .rgr__media::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(90deg, color-mix(in srgb, var(--color-ranger-earth) 85%, transparent) 0%, color-mix(in srgb, var(--color-ranger-earth) 62%, transparent) 36%, color-mix(in srgb, var(--color-ranger-earth) 25%, transparent) 50%, transparent 64%),
        linear-gradient(0deg, color-mix(in srgb, var(--color-ranger-earth) 45%, transparent) 0%, transparent 32%);
    }
    .rgr__copy {
      max-width: min(36rem, 46%);
      margin-top: 0;
      padding: clamp(2.5rem, 4vw, 3.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rgr__card:hover .rgr__img,
    .rgr__card:active .rgr__img,
    .rgr__card:has(.rgr__link:focus-visible) .rgr__img { transform: none; }
  }
</style>

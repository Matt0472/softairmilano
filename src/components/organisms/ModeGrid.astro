---
// Mission select ("Le missioni", "I percorsi"): one file per mode on a single
// plate, divided by hairlines and framed by four HUD corners that lock on as it
// scrolls in. A file opens on its mark: the mission emblem, picked in the CMS,
// in a sight that traces it in, and/or its number when the order matters
// (courses that unlock in turn). The same emblem, oversized and faint, is the
// file's texture. Pointing at a file locks the sight onto its objective; the
// files are not links, so nothing promises a click. A file may carry a readout
// of figures (stages, targets), pinned to its foot so the readouts line up
// across a row; each figure reads as one phrase ("16 bersagli ravvicinati"),
// like the hero facts. The plate always fills its rows: a short last row widens
// its files instead of leaving a gap.

import type { ComponentProps } from 'astro/types';
import Icon from '../atoms/Icon.astro';
import SectionHead from '../molecules/SectionHead.astro';

type IconName = ComponentProps<typeof Icon>['name'];

interface Stat {
  value: string;
  label: string;
}
interface Mode {
  title: string;
  text: string;
  icon?: string;
  stats?: Stat[];
}
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  /** Number the files 01, 02… Only where the order means something (courses that unlock in turn). */
  numbered?: boolean;
  items: Mode[];
  headingId?: string;
}

// The emblems the CMS offers (modes.items.icon and the course's features.items.icon in .pages.yml):
// any other value draws none.
const EMBLEMS: IconName[] = ['flag', 'crosshair', 'crown', 'shieldUser', 'bomb', 'castle', 'target', 'users', 'timer', 'map', 'trophy', 'tag', 'award'];

const { eyebrow, title, text, numbered = false, items, headingId = 'modes-title' } = Astro.props;
const list = (items ?? [])
  .filter((m) => m?.title?.trim())
  .map((m) => ({
    ...m,
    emblem: EMBLEMS.find((e) => e === m.icon),
    stats: (m.stats ?? []).filter((s) => s?.value?.trim() && s?.label?.trim()),
  }));
const hasTitle = !!title?.trim();
const pad = (n: number) => String(n + 1).padStart(2, '0');

// Desktop: three files per row on a 6-column grid. A remainder of two shares the
// last row; a remainder of one turns the last two rows into pairs (4 = 2 + 2).
const count = list.length;
const tail = count === 1 ? 1 : count % 3 === 1 ? 4 : count % 3;
const spanFor = (i: number) => (count === 1 ? 6 : i >= count - tail ? 3 : 2);
// Stagger by position in the row, so each row rises left to right.
const colFor = (i: number) => (i < count - tail ? i % 3 : (i - (count - tail)) % 2);
---

{list.length > 0 && (
  <section class:list={['modes band', !numbered && 'modes--plain']} aria-labelledby={hasTitle ? headingId : undefined}>
    <div class="shell">
      <SectionHead eyebrow={eyebrow} title={title} text={text} id={headingId} class="modes__head" />

      <div class="modes__plate" data-inview>
        <span class="corners modes__frame" aria-hidden="true"></span>
        <ol class="modes__grid" role="list">
          {list.map((m, i) => (
            <li class="modes__file" style={`--span: ${spanFor(i)}`}>
              {m.emblem && <Icon name={m.emblem} size={184} class="modes__ghost" />}
              <div class="modes__body" data-reveal style={`--i: ${colFor(i)}`}>
                {(numbered || m.emblem) && (
                  <div class="modes__mark" aria-hidden="true">
                    {numbered && <span class="modes__num" data-num={pad(i)}>{pad(i)}</span>}
                    {m.emblem && (
                      <span class="modes__sight">
                        <span class="corners modes__sight-rest"></span>
                        <Icon name={m.emblem} size={52} class="modes__emblem" />
                        <span class="corners modes__sight-lock"></span>
                      </span>
                    )}
                  </div>
                )}
                <h3 class="modes__title">{m.title}</h3>
                {m.text?.trim() && <p class="modes__text">{m.text}</p>}
                {m.stats.length > 0 && (
                  <ul class="modes__stats" role="list">
                    {m.stats.map((s) => (
                      <li class="modes__stat">
                        <span class="modes__value">{s.value}</span> <span class="modes__label">{s.label}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
)}

<style is:global>
  .modes {
    --accent: var(--color-accent);
    /* Inner padding of a file; the desktop intro offsets by it to line up with the file copy. */
    --pad-x: clamp(1.25rem, 2.4vw, 2.5rem);
    padding-block: clamp(4rem, 9vw, 7rem) clamp(4.5rem, 10vw, 8rem);
  }

  .modes__plate {
    position: relative;
    margin-top: clamp(2.5rem, 5vw, 3.75rem);
  }

  /* Four L-shaped corners in one layer. The plate has no outer border: the corners
     are its edge, the hairlines inside are the only rules. */
  .modes__frame {
    --arm: clamp(0.9rem, 1.6vw, 1.4rem);
    z-index: 1;
    color: var(--accent);
  }

  /* The hairlines are the plate showing through 1px gaps between opaque files, so
     they follow any span. The colour stops 1px short of the outer edge, where a
     plate on a half pixel would otherwise show a sliver. Only the file copy fades
     in, never the file itself, or the plate colour would flash through it. */
  .modes__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    background: linear-gradient(var(--color-border), var(--color-border)) center / calc(100% - 2px) calc(100% - 2px) no-repeat;
  }
  .modes__file {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    background: var(--plane);
    container-type: inline-size;
  }
  /* The lift a pointed file takes: a layer one step up, faded in, so only opacity moves. */
  .modes__file::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--lift);
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out-expo);
  }

  .modes__body {
    position: relative;
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto auto 1fr;
    grid-template-areas: "mark" "title" "text" "stats";
    padding: clamp(1.75rem, 3vw, 2.75rem) var(--pad-x);
  }

  .modes__mark {
    grid-area: mark;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: clamp(1.25rem, 2.4vw, 1.9rem);
  }

  /* Outlined figure: the file number, decorative (the list carries the order). */
  .modes__num {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.75rem, 4.4vw, 4rem);
    line-height: 0.85;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    color: transparent;
    -webkit-text-stroke: 1.25px var(--accent);
    position: relative;
  }
  /* The lit number: a filled copy laid over the outline, faded in, so only opacity moves. */
  .modes__num::after {
    content: attr(data-num);
    position: absolute;
    inset: 0;
    color: color-mix(in srgb, var(--accent) 22%, transparent);
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out-expo);
  }

  /* The emblem's sight: steel corners at rest; the accent pair closes in on a pointed file. */
  .modes__sight {
    --arm: 10px;
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 5.25rem;
    height: 5.25rem;
    color: var(--accent);
  }
  .modes__sight-rest { color: var(--color-steel); }
  .modes__sight-lock {
    opacity: 0;
    transform: scale(1.35);
    transition:
      opacity var(--duration-base) var(--ease-out-expo),
      transform var(--duration-slow) var(--ease-out-expo);
  }
  /* Thinner than the 24px grid's stroke 2, so the line art stays fine at this size. */
  .modes__emblem { stroke-width: 1.25; }

  /* The emblem again, oversized and faint, bleeding off the file's top corner, across from the
     sight and clear of the copy. */
  .modes__ghost {
    position: absolute;
    top: -1.75rem;
    right: -1.75rem;
    z-index: -1;
    /* Scales with a narrow file (tablets, 1024), so it never crowds the sight. */
    width: min(11.5rem, 42cqi);
    height: min(11.5rem, 42cqi);
    stroke-width: 0.2;
    color: color-mix(in srgb, var(--accent) 15%, transparent);
    opacity: 0.6;
    transition:
      opacity var(--duration-slow) var(--ease-out-expo),
      transform calc(var(--duration-slow) * 2) var(--ease-out-expo);
  }

  .modes__title {
    grid-area: title;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.45rem, 2.3vw, 2rem);
    line-height: 1.12;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }
  .modes__text {
    grid-area: text;
    margin: 0.7rem 0 0;
    max-width: 42ch;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .modes__stats {
    grid-area: stats;
    align-self: end;
    list-style: none;
    margin: clamp(1.75rem, 3vw, 2.25rem) 0 0;
    padding: 0;
    display: grid;
    /* One value column per file, every value starting on its left edge. Its floor fits "12+" at the
       largest size, so the labels also line up across the files of a row; a wider value widens only
       its own file's column. */
    grid-template-columns: minmax(2.25rem, max-content) minmax(0, 1fr);
    column-gap: 0.9rem;
  }
  .modes__stat {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    padding-block: 0.65rem;
    border-top: 1px solid var(--color-border);
  }
  .modes__value {
    justify-self: start;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.35rem, 2vw, 1.6rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--color-foreground);
  }
  .modes__label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.35;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* A file wide enough (a whole row on tablets, a half row on wide desktops) sets
     its readout beside the copy instead of below it. */
  @container (min-width: 40rem) {
    .modes__body:has(.modes__stats) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto auto 1fr;
      grid-template-areas: "mark stats" "title stats" "text stats";
      column-gap: calc(var(--pad-x) * 2);
    }
    .modes__stats { margin-top: 0; }
  }

  /* Pointing at a file: it lifts a step, the sight locks onto the emblem (or the
     number lights up) and the texture drifts. Pointer only: the files are not
     controls, so there is no focus or press state to give them. */
  @media (hover: hover) {
    .modes__file:hover::before { opacity: 1; }
    .modes__file:hover .modes__sight-lock { opacity: 1; transform: none; }
    .modes__file:hover .modes__num::after { opacity: 1; }
    .modes__file:hover .modes__ghost { opacity: 1; transform: translate(-0.6rem, 0.6rem); }
  }

  @media (max-width: 599px) {
    .modes__body {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-rows: auto auto 1fr;
      grid-template-areas: "mark title" "text text" "stats stats";
      column-gap: 1rem;
      padding: 1.6rem 1.1rem 1.75rem;
    }
    .modes__mark { margin: 0; align-self: center; }
    /* Oswald's figures are proportional ("01" is narrower than "06"): a fixed
       column keeps every title on the same line. */
    .modes__num { min-width: 1.15em; font-size: 2.6rem; }
    .modes__title { align-self: center; }
    .modes__text { margin-top: 0.85rem; }
    .modes__ghost { display: none; }
  }

  /* Without numbers the title opens the file, or sits beside the emblem. */
  .modes--plain .modes__body:not(:has(.modes__mark)) {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto 1fr;
    grid-template-areas: "title" "text" "stats";
  }
  @container (min-width: 40rem) {
    .modes--plain .modes__body:not(:has(.modes__mark)):has(.modes__stats) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto 1fr;
      grid-template-areas: "title stats" "text stats";
    }
  }
  /* Phones: a mission list, the emblem beside its name and objective. */
  @media (max-width: 599px) {
    .modes--plain .modes__body:has(.modes__mark) {
      grid-template-rows: auto auto 1fr;
      grid-template-areas: "mark title" "mark text" "stats stats";
      column-gap: 1.1rem;
      padding-block: 1.4rem 1.5rem;
    }
    .modes--plain .modes__mark { align-self: start; }
    .modes--plain .modes__sight { --arm: 8px; width: 3.25rem; height: 3.25rem; }
    .modes--plain .modes__emblem { width: 34px; height: 34px; }
    .modes--plain .modes__title { align-self: end; margin-top: 0.15rem; }
    .modes--plain .modes__text { margin-top: 0.35rem; }
  }
  /* The narrowest phones: beside the emblem the text would run 24 characters a line, so it
     takes the full width under the emblem and the name. */
  @media (max-width: 359px) {
    .modes--plain .modes__body:has(.modes__mark) { grid-template-areas: "mark title" "text text" "stats stats"; }
    .modes--plain .modes__text { margin-top: 0.75rem; }
  }

  @media (min-width: 600px) {
    .modes__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .modes__file:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }

  @media (min-width: 1024px) {
    .modes__grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .modes__file,
    .modes__file:last-child:nth-child(odd) { grid-column: span var(--span, 2); }

    .modes__head:has(.shead__text) {
      max-width: none;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: 1fr auto;
    }
    .modes__head:has(.shead__text) .shead__eyebrow { grid-column: 1 / span 2; grid-row: 1; align-self: end; }
    .modes__head:has(.shead__text) .shead__title { grid-column: 1 / span 2; grid-row: 2; }
    .modes__head .shead__text {
      grid-column: 3;
      grid-row: 1 / span 2;
      align-self: end;
      margin: 0;
      padding-left: var(--pad-x);
    }
  }

  /* Entrance (only when armed below the fold): the corners lock onto the plate
     while the files rise into it and each emblem traces itself, row by row. */
  .modes__plate.is-armed .modes__frame {
    opacity: 0;
    transform: scale(1.04);
  }
  .modes__plate.is-armed.is-in .modes__frame {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--duration-slow) var(--ease-out-expo),
      transform calc(var(--duration-slow) * 2) var(--ease-out-expo);
  }
  .modes__plate.is-armed .modes__emblem > * {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .modes__plate.is-armed.is-in .modes__emblem > * {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset calc(var(--duration-slow) * 3.5) var(--ease-out-expo);
    transition-delay: calc(var(--i, 0) * 90ms + 250ms);
  }

  /* Static in full: the entrance is already there, and pointing at a file only lights it
     (the lift, the sight, the texture), nothing moves. */
  @media (prefers-reduced-motion: reduce) {
    .modes__plate.is-armed .modes__frame { opacity: 1; transform: none; }
    .modes__plate.is-armed .modes__emblem > * { stroke-dashoffset: 0; }
    .modes__sight-lock,
    .modes__file:hover .modes__ghost { transform: none; }
  }
</style>

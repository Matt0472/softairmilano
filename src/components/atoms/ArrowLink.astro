---
// A standalone text link with a trailing arrow ("Vai alla modulistica"): the label underlined in
// the accent, the arrow nudging forward on hover. For links that sit on their own under a block
// of text; links inside running text stay plain.

import Icon from './Icon.astro';

interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a class:list={['arrow-link', className]} href={href}>
  <slot /><Icon name="arrowRight" size={18} />
</a>

<style is:global>
  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    font-weight: 600;
    color: var(--color-foreground);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 50%, transparent);
    text-underline-offset: 5px;
    transition:
      color var(--duration-fast) var(--ease-out-expo),
      text-decoration-color var(--duration-fast) var(--ease-out-expo);
  }
  .arrow-link svg {
    flex: none;
    color: var(--color-accent);
    transition: transform var(--duration-base) var(--ease-out-expo);
  }
  .arrow-link:hover { color: var(--color-accent-hover); text-decoration-color: var(--color-accent); }
  .arrow-link:hover svg { transform: translateX(3px); }
  .arrow-link:active { transform: translateY(1px); }
</style>

---
// The small tracked label that names a group in an article's side columns: the contents, the
// recommended activities, the social channels. One style for all of them, so the columns read as
// one family. A heading where the group is a section of the page, a plain label where it only
// names a landmark (the contents: the article's outline stays the client's sections).

interface Props {
  as?: 'h2' | 'p';
  id?: string;
  class?: string;
}

const { as: Tag = 'p', id, class: className } = Astro.props;
---

<Tag class:list={['overline', className]} id={id}><slot /></Tag>

<style is:global>
  .overline {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
</style>

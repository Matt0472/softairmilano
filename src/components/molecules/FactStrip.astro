---
// Key facts at a glance ("6–25 giocatori", "8+ anni"…), read as one phrase each
// by assistive tech and by AI crawlers. Sits at the foot of the page hero.
// The figures roll in like an odometer: each digit is a reel of CSS generated
// content, so the DOM text stays the real value for screen readers and crawlers.
// Pure CSS and transform only: no JS, no layout shift, static under reduced motion.

interface Fact {
  value: string;
  label: string;
}
interface Props {
  facts: Fact[];
  class?: string;
}

const { facts, class: className } = Astro.props;
---

<ul class:list={['facts', className]} role="list" style={`--n: ${facts.length}`}>
  {facts.map((f, i) => (
    <li class="facts__item" style={`--i: ${i}`}>
      <span class="facts__value">
        <span class="sr-only">{f.value}</span>
        <span class="facts__roll" aria-hidden="true">
          {[...f.value].map((ch, j) =>
            /\d/.test(ch) ? (
              <span class="facts__digit" style={`--d: ${ch}; --j: ${j}`}><span class="facts__reel" /></span>
            ) : (
              <span class="facts__glyph" data-g={ch} />
            )
          )}
        </span>
      </span>
      <span class="facts__label">{f.label}</span>
    </li>
  ))}
</ul>

<style is:global>
  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr));
    border-top: 1px solid color-mix(in srgb, var(--color-foreground) 16%, transparent);
  }
  .facts__item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: clamp(0.9rem, 2vw, 1.35rem) 0.75rem 0 0;
  }
  .facts__item + .facts__item {
    padding-left: clamp(0.75rem, 2vw, 1.5rem);
    border-left: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
  }
  /* Accent tick on the rule above each fact. */
  .facts__item::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 22px;
    height: 2px;
    background: var(--color-accent);
  }
  .facts__item + .facts__item::before { left: clamp(0.75rem, 2vw, 1.5rem); }
  /* The tick draws in just ahead of its figure. The entrance runs longer than the
     UI duration tokens on purpose: the figures should read as composing, not flashing. */
  .facts__item::before {
    transform-origin: left;
    animation: facts-tick 0.9s var(--ease-out-expo) both;
    animation-delay: calc(0.35s + var(--i, 0) * 0.12s);
  }
  @keyframes facts-tick { from { transform: scaleX(0); } }

  .facts__value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.2rem, 3.4vw, 2.5rem);
    line-height: 1;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-foreground);
    text-shadow: 0 1px 12px color-mix(in srgb, var(--color-background) 80%, transparent);
  }
  /* Odometer: one reel per digit, 0–9 twice, stopping on the digit after a full turn. The row is
     a little taller than the 1em line so Oswald's digits are never clipped; the negative margin
     keeps the value's box exactly as tall as plain text. */
  .facts__roll {
    --row: 1.15em;
    display: inline-flex;
    align-items: flex-start;
    line-height: var(--row);
    margin-block: calc((1em - var(--row)) / 2);
  }
  .facts__digit {
    display: inline-block;
    width: 1ch;
    height: var(--row);
    overflow: hidden;
  }
  .facts__reel {
    display: block;
    transform: translateY(calc(var(--row) * -1 * (10 + var(--d, 0))));
    animation: facts-roll 1.5s var(--ease-out-expo) both;
    animation-delay: calc(0.45s + var(--i, 0) * 0.12s + var(--j, 0) * 0.05s);
  }
  .facts__reel::before {
    content: "0\A 1\A 2\A 3\A 4\A 5\A 6\A 7\A 8\A 9\A 0\A 1\A 2\A 3\A 4\A 5\A 6\A 7\A 8\A 9";
    display: block;
    white-space: pre;
    text-align: center;
  }
  @keyframes facts-roll { from { transform: translateY(0); } }
  .facts__glyph::before { content: attr(data-g); white-space: pre; }

  @media (prefers-reduced-motion: reduce) {
    .facts__reel,
    .facts__item::before { animation: none; }
  }

  .facts__label {
    font-size: clamp(0.68rem, 1.1vw, 0.8rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.3;
    color: var(--color-muted);
  }

  /* Phones in portrait: 2 × 2, each fact on its own rule. Four across only fit from
     ~560px ("1.500 m²" and "di battaglia" need the room). */
  @media (max-width: 559px) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      border-top: 0;
    }
    .facts__item,
    .facts__item + .facts__item {
      padding: 0.8rem 0 0;
      border-left: 0;
      border-top: 1px solid color-mix(in srgb, var(--color-foreground) 16%, transparent);
    }
    .facts__item + .facts__item::before { left: 0; }
    .facts__value { font-size: clamp(1.4rem, 7vw, 1.75rem); }
  }
</style>

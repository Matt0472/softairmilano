---
// Floating WhatsApp link, bottom left, opposite «Torna su», on every screen: it comes in with that
// button once the page has scrolled, and stays. Global (rendered in BaseLayout): a tap opens a chat
// with the business number and a message already typed, both from settings.json (whatsapp,
// whatsappButton); without the number, or with the switch off, nothing renders. A secondary contact
// that never rivals Prenota (DES-05): the glyph alone on the back-to-top button's chip, in the
// site's accent rather than WhatsApp green (DES-04). A new tab, like the other WhatsApp links: on a
// computer it opens WhatsApp Web without leaving the site; on a phone it hands over to the app.
import Icon from '../atoms/Icon.astro';
import settings from '../../data/settings.json';
import { has } from '../../lib/fields';
import { waHref } from '../../lib/phone';

const { whatsapp, whatsappButton: button } = settings;
const chat = waHref(whatsapp);
const message = button?.message;
const href = chat && has(message) ? `${chat}?text=${encodeURIComponent(message.trim())}` : chat;
const label = has(button?.label) ? button.label.trim() : 'WhatsApp';
const show = Boolean(chat) && button?.show === true;
---

{
  show && (
    <Fragment>
      <a
        id="wa-chat"
        href={href}
        target="_blank"
        rel="noopener"
        class="wa-chat fixed bottom-5 left-5 z-40 grid h-11 w-11 place-items-center rounded-full border border-border bg-surface/90 text-accent shadow-md backdrop-blur hover:border-accent hover:bg-accent hover:text-on-accent active:translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        data-visible="false"
      >
        <Icon name="whatsapp" size={20} />
        <span class="sr-only">{label} (si apre in una nuova scheda)</span>
      </a>
      <span id="wa-chat-sentinel" class="wa-chat__sentinel" aria-hidden="true" />
    </Fragment>
  )
}

<style>
  /* Hidden until wanted, and only opacity/transform animate. It stays in the tab order (where the
     page has no other WhatsApp link, as on the legal pages, it is the only way to it): keyboard
     focus always brings it into view (A11Y-05). */
  .wa-chat {
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition:
      opacity var(--duration-base) var(--ease-out-expo),
      transform var(--duration-base) var(--ease-out-expo),
      color var(--duration-fast) var(--ease-out-expo),
      background-color var(--duration-fast) var(--ease-out-expo),
      border-color var(--duration-fast) var(--ease-out-expo);
  }
  .wa-chat[data-visible='true'],
  .wa-chat:focus-visible {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }
  /* The same band as «Torna su» (ScrollToTop): the first 600px of the document. Once none of it is
     in view, both buttons come in together. */
  .wa-chat__sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 600px;
    pointer-events: none;
  }
</style>

<script>
  const link = document.getElementById('wa-chat');
  const sentinel = document.getElementById('wa-chat-sentinel');
  if (link && sentinel) {
    // Every reason to step aside; the button shows only when none holds.
    const away = { top: true, consent: false, menu: false, typing: false };
    const sync = () => {
      link.dataset.visible = String(!Object.values(away).some(Boolean));
    };

    // Observers and events rather than a scroll listener: no work per frame, no layout read at load.
    // The latest entry: two may queue up while the page restores its scroll on load.
    new IntersectionObserver((entries) => {
      away.top = entries[entries.length - 1].isIntersecting;
      sync();
    }).observe(sentinel);

    // vanilla-cookieconsent marks the root while the banner or the preferences are open.
    const root = document.documentElement;
    const syncConsent = () => {
      away.consent = root.classList.contains('show--consent') || root.classList.contains('show--preferences');
      sync();
    };
    addEventListener('cc:onModalShow', syncConsent);
    addEventListener('cc:onModalHide', syncConsent);
    syncConsent();

    // The mobile menu (Header) covers the page while open.
    const menu = document.getElementById('mobile-menu');
    if (menu) {
      new MutationObserver(() => {
        away.menu = menu.dataset.open === 'true';
        sync();
      }).observe(menu, { attributes: true, attributeFilter: ['data-open'] });
    }

    // While a text field has focus (on a phone, the keyboard is up) the button would sit on the form.
    const typesText = (el: EventTarget | null) =>
      el instanceof HTMLElement && el.matches('textarea, input:not([type="checkbox"], [type="radio"], [type="button"], [type="submit"])');
    document.addEventListener('focusin', (e) => {
      away.typing = typesText(e.target);
      sync();
    });
    document.addEventListener('focusout', (e) => {
      away.typing = typesText(e.relatedTarget);
      sync();
    });
  }
</script>

---
// Floating "back to top" control. Global (rendered in BaseLayout); appears
// after scrolling down, returns to the top. Decorative control, no CMS content.
import Icon from '../atoms/Icon.astro';
---

<button
  id="scroll-top"
  type="button"
  aria-label="Torna su"
  class="scroll-top fixed bottom-5 right-5 z-40 grid h-11 w-11 place-items-center rounded-full border border-border bg-surface/90 text-accent shadow-md backdrop-blur transition-colors hover:border-accent hover:bg-accent hover:text-on-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
  data-visible="false"
>
  <Icon name="arrowUp" size={20} />
</button>
<span id="scroll-top-sentinel" class="scroll-top__sentinel" aria-hidden="true"></span>

<style>
  /* Hidden until scrolled; only opacity/transform animate (compositor-friendly). While hidden it is
     also visibility: hidden, so Tab and screen readers never reach a control nobody can see. */
  .scroll-top {
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity var(--duration-base) var(--ease-out-expo),
      transform var(--duration-base) var(--ease-out-expo),
      visibility 0s linear var(--duration-base);
  }
  .scroll-top[data-visible='true'] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity var(--duration-base) var(--ease-out-expo),
      transform var(--duration-base) var(--ease-out-expo),
      visibility 0s;
  }
  /* Marks 600px down the document: once it has scrolled above the viewport, the button shows. */
  .scroll-top__sentinel {
    position: absolute;
    top: 600px;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }
</style>

<script>
  const btn = document.getElementById('scroll-top');
  const sentinel = document.getElementById('scroll-top-sentinel');
  if (btn && sentinel) {
    // An observer rather than a scroll listener: no work per frame, no layout read at load.
    new IntersectionObserver(([entry]) => {
      btn.dataset.visible = String(!entry.isIntersecting && entry.boundingClientRect.top < 0);
    }).observe(sentinel);

    btn.addEventListener('click', (e) => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // Lenis owns the scroll position: a native smooth scrollTo gets overridden by its next frame
      // (hence the occasional "needs two clicks"). Go through Lenis when it is active.
      const lenis = (window as any).__lenis;
      if (lenis && !reduce) lenis.scrollTo(0, { duration: 1.1 });
      else window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      // From the keyboard (detail 0), focus follows to the top of the page: the button is about to hide.
      if (e.detail === 0) document.querySelector<HTMLElement>('.skip-link')?.focus({ preventScroll: true });
    });
  }
</script>

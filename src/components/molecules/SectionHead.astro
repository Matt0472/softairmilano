---
// Section heading shared by the page organisms: optional eyebrow, H2 and intro,
// with the same scale and rhythm as the home sections. `id` names the section
// through aria-labelledby, so the parent drops that reference when the title is empty.

interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  id?: string;
  align?: 'start' | 'center';
  class?: string;
}

const { eyebrow, title, text, id, align = 'start', class: className } = Astro.props;
---

<div class:list={['shead', align === 'center' && 'shead--center', className]}>
  {eyebrow && <p class="shead__eyebrow">{eyebrow}</p>}
  {title?.trim() && <h2 class="shead__title" id={id}>{title}</h2>}
  {text && <p class="shead__text">{text}</p>}
</div>

<style is:global>
  .shead { max-width: 52rem; }
  .shead--center { margin-inline: auto; text-align: center; }

  .shead__eyebrow {
    margin: 0 0 0.9rem;
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-accent);
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .shead__eyebrow::before {
    content: "";
    width: 30px;
    height: 2px;
    background: var(--color-accent);
  }
  .shead--center .shead__eyebrow { justify-content: center; }

  .shead__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(2rem, 5.5vw, 3.4rem);
    /* Accented capitals (PIÙ, È) rise 1.08em: anything tighter than 1.12 lets them touch the line above. */
    line-height: 1.12;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }

  .shead__text {
    margin: 1.1rem 0 0;
    max-width: 58ch;
    color: var(--color-muted);
    font-size: clamp(1rem, 1.6vw, 1.12rem);
    line-height: 1.6;
    text-wrap: pretty;
  }
  .shead--center .shead__text { margin-inline: auto; }
</style>

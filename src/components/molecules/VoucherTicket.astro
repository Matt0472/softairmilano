---
// The gift voucher, drawn in CSS: a face (the site's name, the voucher's title, a short readout)
// and a stub (logo, barcode) split by a perforation, notched at both ends. A picture of the gift,
// so it says nothing the copy around it does not: hidden from assistive technology. Everything in
// it scales with the width its parent gives it (cqi), so it reads the same on a phone and on a
// wide screen. `entrance` makes it arrive once, with a light across its face, where it opens a
// page; elsewhere it stands still and the section's own reveal brings it in.

import { has } from '../../lib/fields';

interface Props {
  title: string;
  /** Readout at the foot of the face: each part split by «·» goes on its own line. */
  note?: string;
  /** Small line at the top of the face (the site's name). */
  brand?: string;
  entrance?: boolean;
  class?: string;
}

const { title, note, brand, entrance = false, class: className } = Astro.props;

// So a narrow ticket never breaks a part mid-phrase.
const lines = (note ?? '').split('·').map((l) => l.trim()).filter(has);
---

<div class:list={['ticket-box', className]} aria-hidden="true">
  <div class:list={['ticket', entrance && 'ticket--enter']}>
    <div class="ticket__face">
      {has(brand) && <p class="ticket__brand">{brand}</p>}
      <p class="ticket__title">{title}</p>
      {lines.length > 0 && (
        <p class="ticket__note">{lines.map((l) => <span class="ticket__line">{l}</span>)}</p>
      )}
    </div>
    <div class="ticket__stub">
      <img class="ticket__logo" src="/logo/logo-white-120.webp" alt="" width="121" height="120" loading="lazy" decoding="async" />
      <span class="ticket__code"></span>
    </div>
  </div>
</div>

<style is:global>
  /* The box the ticket scales to: its width is the parent's to set. */
  .ticket-box { container-type: inline-size; }

  /* The parent may tilt it its own way through --ticket-tilt. */
  .ticket {
    --stub: 30%;
    --notch: 4cqi;
    --tilt: var(--ticket-tilt, -3deg);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--stub);
    aspect-ratio: 1.85 / 1;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--color-surface-2), var(--color-surface));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-foreground) 12%, transparent);
    transform: rotate(var(--tilt));
    /* Each half is masked by its own circle at the perforation, so the two notches are real
       cut-outs over whatever is behind. A mask reads only alpha. */
    mask:
      radial-gradient(circle at calc(100% - var(--stub)) 0, transparent var(--notch), black calc(var(--notch) + 0.5px)) top / 100% 51% no-repeat,
      radial-gradient(circle at calc(100% - var(--stub)) 100%, transparent var(--notch), black calc(var(--notch) + 0.5px)) bottom / 100% 51% no-repeat;
  }
  /* Arrives once, then a single light runs across its face: the gift being handed over. */
  .ticket--enter { animation: ticket-in 1.1s var(--ease-out-expo) 0.25s both; }
  @keyframes ticket-in {
    from { opacity: 0; transform: translate3d(0, 1.5rem, 0) rotate(calc(var(--tilt) - 5deg)); }
  }
  .ticket--enter::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(105deg, transparent 38%, color-mix(in srgb, var(--color-foreground) 9%, transparent) 50%, transparent 62%);
    transform: translateX(-100%);
    animation: ticket-sheen 1.6s var(--ease-out-expo) 1.1s both;
  }
  @keyframes ticket-sheen { to { transform: translateX(100%); } }

  .ticket__face {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
    padding: 6.5cqi 6cqi;
    /* Fine hatching, like the security print of a printed voucher. */
    background: repeating-linear-gradient(-45deg, color-mix(in srgb, var(--color-foreground) 3.5%, transparent) 0 1px, transparent 1px 9px);
  }
  .ticket__brand,
  .ticket__note {
    margin: 0;
    font-family: var(--font-mono);
    font-size: max(0.625rem, 2.4cqi);
    line-height: 1.3;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .ticket__brand {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-accent-hover);
  }
  .ticket__brand::before { content: "// "; }
  .ticket__note { color: var(--color-muted); }
  .ticket__line {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ticket__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 11cqi;
    line-height: 0.92;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .ticket__stub {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 6.5cqi 4.5cqi;
    background: color-mix(in srgb, var(--color-accent) 7%, transparent);
  }
  /* The perforation, between the two notches. */
  .ticket__stub::before {
    content: "";
    position: absolute;
    left: -1px;
    top: calc(var(--notch) + 2cqi);
    bottom: calc(var(--notch) + 2cqi);
    width: 2px;
    background: repeating-linear-gradient(to bottom, color-mix(in srgb, var(--color-foreground) 30%, transparent) 0 1.6cqi, transparent 1.6cqi 3cqi);
  }
  /* The file's last pixel column is faintly opaque: clipped, or the tilt shows it as a line. */
  .ticket__logo {
    width: 14cqi;
    height: auto;
    opacity: 0.92;
    clip-path: inset(0 1.5% 0 0);
  }
  /* A narrow ticket (phones) stands a little taller, so the title and the readout keep their air. */
  @container (max-width: 26rem) {
    .ticket { aspect-ratio: 1.65 / 1; }
  }
  /* A barcode: bars of four widths in one repeating tile. */
  .ticket__code {
    width: 100%;
    height: 8cqi;
    color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
    background: linear-gradient(90deg,
      currentColor 0 2px, transparent 0 4px, currentColor 0 5px, transparent 0 8px,
      currentColor 0 11px, transparent 0 12px, currentColor 0 13px, transparent 0 16px,
      currentColor 0 17px, transparent 0 20px) 0 0 / 20px 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .ticket--enter,
    .ticket--enter::after { animation: none; }
    .ticket--enter::after { display: none; }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/atoms/Button.astro';
import Card from '../components/molecules/Card.astro';
import Hero from '../components/organisms/Hero.astro';
import VideoSection from '../components/organisms/VideoSection.astro';
import ArenaIntro from '../components/organisms/ArenaIntro.astro';
import Unboxing3D from '../components/organisms/Unboxing3D.astro';
import ActivitiesStory from '../components/organisms/ActivitiesStory.astro';
import home from '../data/home.json';
import settings from '../data/settings.json';

const { title, hero, unboxing, video, arena, intro, activities, occasions, rangerTeaser, finalCta } = home;
---

<BaseLayout title={title}>
  <!-- HERO -->
  <Hero {...hero} />

  <!-- "APRI LA PARTITA" — 3D unboxing, scroll-driven (models load lazily) -->
  <Unboxing3D {...unboxing} />

  <!-- L'ARENA IN BREVE -->
  <ArenaIntro {...arena} />

  <!-- VIDEO -->
  <VideoSection {...video} />

  <!-- ATTIVITÀ (scrolling story, streaming militare) -->
  <ActivitiesStory title="Le attività" intro={intro} items={activities} />

  <!-- OCCASIONI — TEMP "(DA COMPLETARE)" markers below flag sections still to be redesigned -->
  <section class="border-t border-border">
    <div class="shell py-16 md:py-20">
      <h2 class="font-display text-2xl uppercase md:text-3xl">Occasioni <span class="text-base font-sans font-normal normal-case text-muted">(DA COMPLETARE)</span></h2>
      <p class="mt-2 max-w-2xl text-muted">
        Non solo partite: il posto giusto per gruppi, feste e formazione.
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {occasions.map((o) => <Card title={o.title} description={o.desc} href={o.href} />)}
      </div>
    </div>
  </section>

  <!-- RIMANDO ARENA OUTDOOR (RANGER) -->
  <section class="shell py-8 md:py-12">
    <div class="flex flex-col gap-6 rounded-lg border border-border bg-surface p-8 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="font-display text-2xl uppercase">{rangerTeaser.title} <span class="text-base font-sans font-normal normal-case text-muted">(DA COMPLETARE)</span></h2>
        <p class="mt-2 max-w-xl text-muted">{rangerTeaser.text}</p>
      </div>
      <div class="shrink-0">
        <Button href={settings.rangerUrl} variant="secondary" target="_blank" rel="noopener">
          {rangerTeaser.label}
        </Button>
      </div>
    </div>
  </section>

  <!-- CTA FINALE -->
  <section class="shell py-20 text-center">
    <h2 class="font-display text-3xl uppercase md:text-4xl">{finalCta.title} <span class="text-base font-sans font-normal normal-case text-muted">(DA COMPLETARE)</span></h2>
    <p class="mt-3 text-muted">{finalCta.subtitle}</p>
    <div class="mt-6 flex justify-center">
      <Button href={finalCta.href} variant="primary">{finalCta.label}</Button>
    </div>
  </section>
</BaseLayout>

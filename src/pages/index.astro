---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/atoms/Button.astro';
import Card from '../components/molecules/Card.astro';
import home from '../data/home.json';
import settings from '../data/settings.json';

const { title, hero, intro, activities, occasions, rangerTeaser, finalCta } = home;
---

<BaseLayout title={title}>
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-border">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 -z-10"
      style="background: radial-gradient(120% 130% at 85% 0%, #232a33 0%, var(--color-surface) 45%, var(--color-background) 100%);"
    >
    </div>
    <div class="shell max-w-3xl py-20 md:py-28">
      <p class="font-display text-sm uppercase tracking-[0.22em] text-accent">
        {hero.eyebrow}
      </p>
      <h1 class="mt-4 text-balance font-display text-4xl font-bold uppercase leading-[1.05] md:text-6xl">
        {hero.title}
      </h1>
      <p class="mt-5 max-w-xl text-lg text-muted">{hero.subtitle}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={hero.ctaPrimary.href} variant="primary">{hero.ctaPrimary.label}</Button>
        <Button href={hero.ctaSecondary.href} variant="secondary">{hero.ctaSecondary.label}</Button>
      </div>
    </div>
  </section>

  <!-- ATTIVITÀ -->
  <section class="shell py-16 md:py-20">
    <h2 class="font-display text-2xl uppercase md:text-3xl">Le attività</h2>
    <p class="mt-2 max-w-2xl text-muted">{intro}</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {activities.map((a) => <Card title={a.title} description={a.desc} href={a.href} />)}
    </div>
  </section>

  <!-- OCCASIONI -->
  <section class="border-t border-border">
    <div class="shell py-16 md:py-20">
      <h2 class="font-display text-2xl uppercase md:text-3xl">Occasioni</h2>
      <p class="mt-2 max-w-2xl text-muted">
        Non solo partite: il posto giusto per gruppi, feste e formazione.
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {occasions.map((o) => <Card title={o.title} description={o.desc} href={o.href} />)}
      </div>
    </div>
  </section>

  <!-- RIMANDO ARENA OUTDOOR (RANGER) -->
  <section class="shell py-8 md:py-12">
    <div class="flex flex-col gap-6 rounded-lg border border-border bg-surface p-8 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="font-display text-2xl uppercase">{rangerTeaser.title}</h2>
        <p class="mt-2 max-w-xl text-muted">{rangerTeaser.text}</p>
      </div>
      <div class="shrink-0">
        <Button href={settings.rangerUrl} variant="secondary" target="_blank" rel="noopener">
          {rangerTeaser.label}
        </Button>
      </div>
    </div>
  </section>

  <!-- CTA FINALE -->
  <section class="shell py-20 text-center">
    <h2 class="font-display text-3xl uppercase md:text-4xl">{finalCta.title}</h2>
    <p class="mt-3 text-muted">{finalCta.subtitle}</p>
    <div class="mt-6 flex justify-center">
      <Button href={finalCta.href} variant="primary">{finalCta.label}</Button>
    </div>
  </section>
</BaseLayout>

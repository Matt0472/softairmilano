---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/organisms/Hero.astro';
import ActionVideo from '../components/organisms/ActionVideo.astro';
import ArenaIntro from '../components/organisms/ArenaIntro.astro';
import ActivitiesStory from '../components/organisms/ActivitiesStory.astro';
import Reviews from '../components/organisms/Reviews.astro';
import OccasionMosaic from '../components/organisms/OccasionMosaic.astro';
import CourseTeaser from '../components/organisms/CourseTeaser.astro';
import TeaserBanner from '../components/organisms/TeaserBanner.astro';
import SocialChannels from '../components/organisms/SocialChannels.astro';
import RangerTeaser from '../components/organisms/RangerTeaser.astro';
import FinalCta from '../components/organisms/FinalCta.astro';
import Reveal from '../components/molecules/Reveal.astro';
import home from '../data/home.json';
import settings from '../data/settings.json';
import { has } from '../lib/fields';

const { seo, hero, video, arena, intro, activitiesTitle, activities, reviews, occasions, course, paintballTeaser, social, rangerTeaser } = home;

---

<BaseLayout title={seo?.title} description={seo?.description} image={seo?.image} imageAlt={seo?.imageAlt}>
  <Hero {...hero} />

  {/* Dentro l'azione: the video that opens as the page scrolls. */}
  <ActionVideo {...video} />

  <ArenaIntro {...arena} />

  <ActivitiesStory title={activitiesTitle} intro={intro} items={activities} />

  {/* Right after the activities, where someone looking for paintball is still choosing. A section after
      the activities renders only when the client filled it in (CMS-10). */}
  {paintballTeaser && has(paintballTeaser.title) && has(paintballTeaser.label) && has(paintballTeaser.href) && (
    <TeaserBanner {...paintballTeaser} headingId="paintball-teaser-title" />
  )}

  {reviews && has(reviews.title) && <Reviews title={reviews.title} page="home" />}

  {occasions && has(occasions.title) && !!occasions.items?.length && <OccasionMosaic {...occasions} />}

  {course && has(course.title) && <CourseTeaser {...course} />}

  {social && has(social.title) && <SocialChannels title={social.title} text={social.text} />}

  {/* The outdoor arena (Ranger): the whole section links to its own site. */}
  {rangerTeaser && has(rangerTeaser.title) && <RangerTeaser {...rangerTeaser} href={settings.rangerUrl} />}

  {/* #prenota: every Prenota on the page lands here. The same block closes every page. */}
  <FinalCta {...settings.finalCta} />

  <Reveal />
</BaseLayout>

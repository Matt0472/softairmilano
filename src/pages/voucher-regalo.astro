---
// Gift vouchers (/voucher-regalo, the same address as the old site): someone buys a game for
// friends or family, who then book their own date within the validity. A text-only opening with
// the voucher drawn beside the title, the two vouchers side by side, how the gift becomes a game,
// and the purchase (#acquista), which the opening's button leads to. Buying online goes through
// TicketingHub, loaded only when the visitor asks for it (CODE-09); until its embed is wired the
// purchase area offers the phone and the email. Copy and prices come from voucher.json, contacts
// and the TicketingHub id from settings.json; a section emptied in the CMS disappears (CMS-10).

import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/atoms/Button.astro';
import Icon from '../components/atoms/Icon.astro';
import Breadcrumb from '../components/molecules/Breadcrumb.astro';
import HudFrame from '../components/molecules/HudFrame.astro';
import IncludedList from '../components/molecules/IncludedList.astro';
import Reveal from '../components/molecules/Reveal.astro';
import SectionHead from '../components/molecules/SectionHead.astro';
import StepTimeline from '../components/organisms/StepTimeline.astro';
import FaqAccordion from '../components/organisms/FaqAccordion.astro';
import FinalCta from '../components/organisms/FinalCta.astro';
import page from '../data/voucher.json';
import navigation from '../data/navigation.json';
import settings from '../data/settings.json';
import { has } from '../lib/fields';
import { breadcrumbLd, faqLd } from '../lib/jsonld';
import { flattenNav, type NavItem } from '../lib/nav';
import { telHref } from '../lib/phone';

const { seo, hero, types, steps, purchase, faq } = page;

const path = '/voucher-regalo';
// The page name in the trail is its menu label (single source for both).
const pageName = flattenNav(navigation.items as NavItem[]).find((it) => it.href === path)?.label || hero.title;
const crumbs = [
  { label: 'Home', href: '/' },
  { label: pageName, href: path },
];

const cta = has(hero.cta?.label) && has(hero.cta?.href) ? hero.cta : undefined;
// The voucher's readout: each part of the note («Valido 6 mesi · Data a scelta») on its own line, so
// a narrow ticket never breaks it mid-phrase.
const ticketLines = (hero.ticketNote ?? '').split('·').map((l) => l.trim()).filter(has);

// Keep "3 €" on one line: a figure never wraps away from its unit.
const keep = (s: string) => s.replace(/(\d) €/g, '$1 €');

// A voucher shows once it has a name and a price; its parts drop out one by one when emptied.
const cards = (types?.items ?? [])
  .filter((c) => has(c?.title) && has(c?.price))
  .map((c) => ({ ...c, included: (c.included ?? []).filter(has) }));
const hasTypes = has(types?.title) && cards.length > 0;

const stepItems = (steps?.items ?? []).filter((s) => has(s?.title));
const rules = (steps?.rules ?? []).filter(has);
const rulesLink = has(steps?.rulesLink?.label) && has(steps?.rulesLink?.href) ? steps.rulesLink : undefined;

// --- Purchase ---
const tel = telHref(settings.phone);
const email = has(settings.email) ? settings.email.trim() : '';
const mailHref = email
  ? `mailto:${email}${has(purchase?.emailSubject) ? `?subject=${encodeURIComponent(purchase.emailSubject.trim())}` : ''}`
  : '';

// TODO(TicketingHub): the address of the voucher widget's embed script, from the snippet
// TicketingHub provides. Until it is set the purchase area shows only the phone and the email,
// whatever the CMS holds, so an id typed in early never shows a button that does nothing.
const embedSrc: string = '';
const voucherId = settings.ticketinghubVoucherId;
const shop = has(embedSrc) && has(voucherId) && has(purchase?.button) ? { src: embedSrc, id: voucherId.trim() } : undefined;
const purchaseText = shop ? purchase?.onlineText : purchase?.offlineText;
const hasPurchase = has(purchase?.title) && (!!shop || !!tel || !!email);

const faqItems = (faq?.items ?? []).filter((f) => has(f.q) && has(f.a));
const faqData = faqLd(faqItems);
const jsonLd = [breadcrumbLd(crumbs, Astro.site), ...(faqData ? [faqData] : [])];
---

<BaseLayout title={seo.title} description={seo.description} image={seo.image} imageAlt={seo.imageAlt} jsonLd={jsonLd}>
  <section class="gift band" aria-labelledby="gift-title">
    <HudFrame tag={hero.hudTag} />

    <div class="gift__inner shell">
      <Breadcrumb items={crumbs} class="gift__crumbs" />

      <div class="gift__copy">
        {has(hero.eyebrow) && <p class="gift__eyebrow">{hero.eyebrow}</p>}
        <h1 class="gift__title" id="gift-title">{hero.title}</h1>
        {has(hero.subtitle) && <p class="gift__lede">{hero.subtitle}</p>}
        {cta && (
          <div class="gift__cta">
            <Button href={cta.href} variant="primary" class="gift__btn">{cta.label}</Button>
          </div>
        )}
      </div>

      {/* The voucher itself, drawn in CSS: a picture of the gift, so it says nothing the copy
          does not (decorative, hidden from assistive technology). */}
      <div class="gift__art" aria-hidden="true">
        <div class="ticket">
          <div class="ticket__face">
            {has(settings.siteName) && <p class="ticket__brand">{settings.siteName}</p>}
            <p class="ticket__title">{hero.title}</p>
            {ticketLines.length > 0 && (
              <p class="ticket__note">{ticketLines.map((l) => <span class="ticket__line">{l}</span>)}</p>
            )}
          </div>
          <div class="ticket__stub">
            <img class="ticket__logo" src="/logo/logo-white-120.webp" alt="" width="121" height="120" loading="lazy" decoding="async" />
            <span class="ticket__code"></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {hasTypes && (
    <section class="vtypes band" aria-labelledby="vtypes-title">
      <div class="shell">
        <div data-reveal>
          <SectionHead title={types.title} text={types.text} id="vtypes-title" />
        </div>

        <div class="vtypes__list" style={`--n: ${cards.length}`}>
          {cards.map((c, i) => (
            <article class="vcard" aria-labelledby={`vcard-${i}-title`} data-reveal style={`--i: ${i + 1}`}>
              <div class="vcard__top">
                <div class="vcard__head">
                  <h3 class="vcard__title" id={`vcard-${i}-title`}>{c.title}</h3>
                  {has(c.audience) && <p class="vcard__for">{c.audience}</p>}
                </div>
                <p class="vcard__price">
                  <span class="vcard__num">{c.price}</span>
                  {has(c.unit) && <span class="vcard__unit">{c.unit}</span>}
                </p>
              </div>
              {/* The perforation: the line a voucher is torn along, notched at both edges. */}
              <div class="vcard__body">
                {c.included.length > 0 && (
                  <Fragment>
                    {has(types.includedTitle) && <p class="vcard__incl-title" id={`vcard-${i}-incl`}>{types.includedTitle}</p>}
                    <ul class="vcard__incl" role="list" aria-labelledby={has(types.includedTitle) ? `vcard-${i}-incl` : undefined}>
                      {c.included.map((it) => (
                        <li class="vcard__item">
                          <span class="vcard__check" aria-hidden="true"><Icon name="check" size={14} /></span>
                          {it}
                        </li>
                      ))}
                    </ul>
                  </Fragment>
                )}
              </div>
              {has(c.note) && <p class="vcard__note">{keep(c.note)}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {has(steps?.title) && stepItems.length > 0 && (
    <StepTimeline title={steps.title} text={steps.text} steps={stepItems} id="come-funziona">
      {rules.length > 0 && (
        <div class="vrules">
          <IncludedList title={steps.rulesTitle} items={rules} layout="row" />
          {rulesLink && (
            <a class="vrules__link" href={rulesLink.href}>
              {rulesLink.label}<Icon name="arrowRight" size={18} />
            </a>
          )}
        </div>
      )}
    </StepTimeline>
  )}

  {hasPurchase && (
    <section class="buy band" id="acquista" aria-labelledby="buy-title">
      <div class="shell">
        <div class="buy__panel" data-reveal>
          <span class="corners buy__corners" aria-hidden="true"></span>

          <div class="buy__copy">
            <h2 class="buy__title" id="buy-title">{purchase.title}</h2>
            {has(purchaseText) && <p class="buy__text">{purchaseText}</p>}
          </div>

          <div class="buy__actions">
            {shop && (
              <div class="buy__shop" data-voucher-shop data-src={shop.src} data-id={shop.id}>
                <div class="buy__launch" data-shop-idle>
                  <Button type="button" variant="primary" class="buy__open" data-shop-load>
                    <span class="buy__open-idle">{purchase.button}</span>
                    {/* Status labels while the purchase loads, or if it cannot (CMS-02). */}
                    <span class="buy__open-busy">Caricamento in corso</span>
                    <span class="buy__spin" aria-hidden="true"></span>
                  </Button>
                  {has(purchase.note) && <p class="buy__note">{purchase.note}</p>}
                  <p class="buy__error" data-shop-error hidden>L'acquisto online non si è caricato: chiamaci o scrivici.</p>
                </div>
                {/* TODO(TicketingHub): the element the voucher widget renders into, as the embed
                    snippet sets it out. Its height is reserved while it loads (PERF-03). */}
                <div class="buy__mount" data-shop-mount hidden></div>
              </div>
            )}

            {(tel || email) && (
              <ul class:list={['buy__contacts', shop && 'buy__contacts--alt']} role="list">
                {tel && (
                  <li>
                    <a class="buy__call" href={tel}>
                      <span class="buy__chip"><Icon name="phone" size={22} /></span>
                      <span class="buy__call-body">
                        {/* The space keeps caption and number apart in the link's name («Chiama 375…»). */}
                        {has(purchase.callLabel) && <Fragment><span class="buy__cap">{purchase.callLabel}</span>{' '}</Fragment>}
                        <span class="buy__num">{settings.phone}</span>
                      </span>
                    </a>
                  </li>
                )}
                {email && (
                  <li>
                    <a class="buy__mail" href={mailHref}>
                      <span class="buy__chip buy__chip--line"><Icon name="mail" size={22} /></span>
                      <span class="buy__call-body">
                        {has(purchase.emailLabel) && <Fragment><span class="buy__cap">{purchase.emailLabel}</span>{' '}</Fragment>}
                        <span class="buy__addr">{email}</span>
                      </span>
                    </a>
                  </li>
                )}
              </ul>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  {faq && has(faq.title) && faqItems.length > 0 && <FaqAccordion title={faq.title} items={faqItems} />}

  {/* #prenota: the closing section of every page, where the header's Prenota lands. */}
  <FinalCta {...settings.finalCta} />

  <Reveal />
</BaseLayout>

<style is:global>
  /* ============ Opening ============ */
  .gift {
    --accent: var(--color-accent);
    /* Room for the floating header (logo 48px + 20px padding each side), as in the other text-only
       openings; the HUD readout sits on the breadcrumb's row, right-aligned with the page column. */
    --gift-top: 5.75rem;
    --hud-tag-top: calc(var(--gift-top) + 0.55rem);
    --hud-tag-right: calc(max(0px, (100% - var(--shell-max)) / 2) + var(--shell-gutter));
    --hud-tag-bottom: auto;
    isolation: isolate;
    overflow: hidden;
  }
  /* A soft, neutral light behind the title, as on the contact page: depth, not a halo. */
  .gift::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(55% 60% at 12% 18%, color-mix(in srgb, var(--color-foreground) 6%, transparent), transparent 70%);
  }
  .gift .hud__scan { z-index: 0; }
  .gift .hud__corners,
  .gift .hud__tag { z-index: 2; }
  /* Below desktop the header's logo and Menu pill fill the top corners: the frame's top pair drops
     under them. */
  @media (max-width: 1023px) {
    .gift .hud__corners { top: 5.5rem; }
  }

  .gift__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "crumbs" "copy" "art";
    /* The bottom clears the frame's lower corners (18px inset + 34px). */
    padding-block: var(--gift-top) clamp(4.5rem, 9vw, 6rem);
  }
  /* The trail's first label lines up with the headline: the link's own padding hangs outside. */
  .gift__crumbs {
    grid-area: crumbs;
    justify-self: start;
    max-width: 100%;
    margin-left: -0.375rem;
  }

  .gift__copy {
    grid-area: copy;
    margin-top: clamp(1.25rem, 4vw, 2.5rem);
  }
  .gift__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(0.75rem, 1.4vw, 0.85rem);
    line-height: 1.3;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .gift__eyebrow::before {
    content: "";
    flex: none;
    width: 30px;
    height: 2px;
    background: var(--accent);
  }
  /* The page's largest text and its LCP: it never gets an entrance (DES-08). In em, not ch, so the
     fallback face wraps where Oswald will (PERF-03). */
  .gift__title {
    margin: 0;
    max-width: 8.8em;
    font-weight: 700;
    font-size: clamp(2.75rem, 1.5rem + 6.4vw, 7.25rem);
    line-height: 0.94;
    letter-spacing: 0.005em;
    text-wrap: balance;
  }
  /* The inner pages' accent rule under the headline: a pseudo-element, so the H1 itself stays
     still. Hero choreography, longer than the UI duration tokens on purpose. */
  .gift__title::after {
    content: "";
    display: block;
    width: clamp(64px, 18vw, 160px);
    height: 5px;
    margin-top: 0.45rem;
    background: var(--accent);
    transform-origin: left;
    animation: gift-wipe 0.7s var(--ease-out-expo) 0.35s both;
  }
  @keyframes gift-wipe { from { transform: scaleX(0); } }
  .gift__lede {
    margin: 1.4rem 0 0;
    max-width: 30em;
    font-size: clamp(1.05rem, 0.95rem + 0.45vw, 1.3rem);
    line-height: 1.55;
    color: var(--color-muted);
    text-wrap: pretty;
  }
  .gift__cta { margin-top: 1.9rem; }
  .gift__btn {
    min-height: 48px;
    padding-inline: 1.6rem;
    transition:
      background-color var(--duration-fast) var(--ease-out-expo),
      transform var(--duration-fast) var(--ease-out-expo);
  }
  .gift__btn:active { transform: translateY(1px) scale(0.98); }

  /* --- The voucher: a face and a stub split by a perforation, notched at both ends. Everything in
     it scales with its own width (cqi), so it reads the same on a phone and on a wide screen. --- */
  .gift__art {
    grid-area: art;
    container-type: inline-size;
    justify-self: center;
    width: min(100%, 30rem);
    margin-top: clamp(3rem, 10vw, 4rem);
  }
  .ticket {
    --stub: 30%;
    --notch: 4cqi;
    --tilt: -3deg;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--stub);
    aspect-ratio: 1.85 / 1;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--color-surface-2), var(--color-surface));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-foreground) 12%, transparent);
    transform: rotate(var(--tilt));
    /* Each half is masked by its own circle at the perforation, so the two notches are real
       cut-outs over whatever is behind. A mask reads only alpha. */
    mask:
      radial-gradient(circle at calc(100% - var(--stub)) 0, transparent var(--notch), black calc(var(--notch) + 0.5px)) top / 100% 51% no-repeat,
      radial-gradient(circle at calc(100% - var(--stub)) 100%, transparent var(--notch), black calc(var(--notch) + 0.5px)) bottom / 100% 51% no-repeat;
    animation: ticket-in 1.1s var(--ease-out-expo) 0.25s both;
  }
  /* Arrives once, then a single light runs across its face: the gift being handed over. */
  @keyframes ticket-in {
    from { opacity: 0; transform: translate3d(0, 1.5rem, 0) rotate(calc(var(--tilt) - 5deg)); }
  }
  .ticket::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(105deg, transparent 38%, color-mix(in srgb, var(--color-foreground) 9%, transparent) 50%, transparent 62%);
    transform: translateX(-100%);
    animation: ticket-sheen 1.6s var(--ease-out-expo) 1.1s both;
  }
  @keyframes ticket-sheen { to { transform: translateX(100%); } }

  .ticket__face {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
    padding: 6.5cqi 6cqi;
    /* Fine hatching, like the security print of a printed voucher. */
    background: repeating-linear-gradient(-45deg, color-mix(in srgb, var(--color-foreground) 3.5%, transparent) 0 1px, transparent 1px 9px);
  }
  .ticket__brand,
  .ticket__note {
    margin: 0;
    font-family: var(--font-mono);
    font-size: max(0.625rem, 2.4cqi);
    line-height: 1.3;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .ticket__brand {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-accent-hover);
  }
  .ticket__brand::before { content: "// "; }
  .ticket__note { color: var(--color-muted); }
  .ticket__line {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ticket__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 11cqi;
    line-height: 0.92;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .ticket__stub {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 6.5cqi 4.5cqi;
    background: color-mix(in srgb, var(--color-accent) 7%, transparent);
  }
  /* The perforation, between the two notches. */
  .ticket__stub::before {
    content: "";
    position: absolute;
    left: -1px;
    top: calc(var(--notch) + 2cqi);
    bottom: calc(var(--notch) + 2cqi);
    width: 2px;
    background: repeating-linear-gradient(to bottom, color-mix(in srgb, var(--color-foreground) 30%, transparent) 0 1.6cqi, transparent 1.6cqi 3cqi);
  }
  /* The file's last pixel column is faintly opaque: clipped, or the tilt shows it as a line. */
  .ticket__logo {
    width: 14cqi;
    height: auto;
    opacity: 0.92;
    clip-path: inset(0 1.5% 0 0);
  }
  /* A narrow ticket (phones) stands a little taller, so the title and the readout keep their air. */
  @container (max-width: 26rem) {
    .ticket { aspect-ratio: 1.65 / 1; }
  }
  /* A barcode: bars of four widths in one repeating tile. */
  .ticket__code {
    width: 100%;
    height: 8cqi;
    color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
    background: linear-gradient(90deg,
      currentColor 0 2px, transparent 0 4px, currentColor 0 5px, transparent 0 8px,
      currentColor 0 11px, transparent 0 12px, currentColor 0 13px, transparent 0 16px,
      currentColor 0 17px, transparent 0 20px) 0 0 / 20px 100%;
  }

  /* Desktop: the voucher beside the copy, a little larger and more tilted. */
  @media (min-width: 1024px) {
    .gift__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      grid-template-areas: "crumbs crumbs" "copy art";
      column-gap: clamp(3rem, 6vw, 7rem);
      align-items: center;
    }
    .gift__art {
      justify-self: end;
      width: min(100%, 36rem);
      margin-top: clamp(1.25rem, 4vw, 2.5rem);
    }
    .ticket { --tilt: -4deg; }
  }

  /* Landscape phones: a smaller headline brings the button up; the frame's top pair and the readout
     have no room under the header. */
  @media (max-height: 500px) and (orientation: landscape) {
    .gift { --gift-top: 4.75rem; }
    .gift .hud__corner--tl,
    .gift .hud__corner--tr,
    .gift .hud__tag { display: none; }
    .gift__copy { margin-top: 1rem; }
    .gift__title { max-width: none; font-size: clamp(2rem, 11vh, 2.75rem); }
    .gift__eyebrow { margin-bottom: 0.6rem; }
    .gift__lede { margin-top: 0.75rem; font-size: 1rem; }
    .gift__cta { margin-top: 1.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gift__title::after,
    .ticket,
    .ticket::after { animation: none; }
    .ticket::after { display: none; }
    .gift__btn { transition: none; }
  }

  /* ============ The two vouchers ============ */
  .vtypes {
    --accent: var(--color-accent);
    padding-block: clamp(4rem, 9vw, 7rem) clamp(4.5rem, 10vw, 8rem);
  }
  .vtypes__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    margin-top: clamp(2.25rem, 5vw, 3.5rem);
  }
  .vcard {
    --pad: clamp(1.25rem, 3vw, 2.25rem);
    --notch: 0.7rem;
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--pad);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--lift);
  }
  /* Name on the left, price on the right where the card is wide enough; below it otherwise. The
     names start on one line across the cards, the prices sit on the row's foot. */
  .vcard__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding-bottom: clamp(1.5rem, 3vw, 2rem);
  }
  .vcard__head {
    flex: 1 1 15rem;
    min-width: 0;
  }
  .vcard__title {
    margin: 0;
    font-weight: 700;
    font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.3rem);
    letter-spacing: 0.01em;
    text-wrap: balance;
  }
  .vcard__for {
    margin: 0.55rem 0 0;
    max-width: 34ch;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .vcard__price {
    flex: none;
    align-self: flex-end;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    white-space: nowrap;
  }
  .vcard__num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.25rem, 2.6rem + 2.6vw, 4.75rem);
    line-height: 0.9;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
  .vcard__unit {
    font-size: 0.95rem;
    line-height: 1.25;
    color: var(--color-muted);
  }

  /* The perforation runs across the whole card, from notch to notch. The notches are half discs of
     the band's ground laid over the card's border, outlined like it, so no clipping is needed. */
  .vcard__body {
    position: relative;
    margin-inline: calc(-1 * var(--pad));
    padding: clamp(1.5rem, 3vw, 2rem) var(--pad) 0;
    background: repeating-linear-gradient(90deg, var(--color-border) 0 0.5rem, transparent 0.5rem 0.9rem) center top / calc(100% - 2 * var(--notch) - 1.5rem) 1px no-repeat;
  }
  .vcard__body::before,
  .vcard__body::after {
    content: "";
    position: absolute;
    top: calc(-1 * var(--notch));
    width: var(--notch);
    height: calc(2 * var(--notch));
    border: 1px solid var(--color-border);
    background: var(--plane);
  }
  .vcard__body::before {
    left: -1px;
    border-left: 0;
    border-radius: 0 var(--notch) var(--notch) 0;
  }
  .vcard__body::after {
    right: -1px;
    border-right: 0;
    border-radius: var(--notch) 0 0 var(--notch);
  }
  .vcard__incl-title {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    line-height: 1.3;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .vcard__incl {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: 0.8rem 1.5rem;
  }
  .vcard__item {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    line-height: 1.45;
    text-wrap: pretty;
  }
  /* The same check as the site's "included" lists. */
  .vcard__check {
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-top: 0;
    border-radius: 50%;
    color: var(--color-on-accent);
    background: var(--accent);
  }
  .vcard__check svg { stroke-width: 3; }
  .vcard__note {
    margin: 1.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.95rem;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
    color: var(--color-foreground);
  }

  /* Side by side from tablets: one shared row per part (top, list, note), so the perforations
     line up and the notes sit on the same foot line. */
  @media (min-width: 768px) {
    .vtypes__list {
      grid-template-columns: repeat(var(--n, 2), minmax(0, 1fr));
      grid-template-rows: repeat(3, auto);
      row-gap: 0;
    }
    @supports (grid-template-rows: subgrid) {
      .vcard {
        display: grid;
        grid-row: span 3;
        grid-template-rows: subgrid;
      }
      .vcard__top { grid-row: 1; }
      .vcard__body { grid-row: 2; align-self: start; }
      .vcard__note { grid-row: 3; align-self: end; }
    }
  }

  /* ============ Before playing (under the steps) ============ */
  .vrules {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .vrules .incl { justify-self: stretch; }
  .vrules__link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    font-weight: 600;
    color: var(--color-foreground);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 50%, transparent);
    text-underline-offset: 5px;
    transition:
      color var(--duration-fast) var(--ease-out-expo),
      text-decoration-color var(--duration-fast) var(--ease-out-expo);
  }
  .vrules__link svg {
    flex: none;
    color: var(--color-accent);
    transition: transform var(--duration-base) var(--ease-out-expo);
  }
  .vrules__link:hover { color: var(--color-accent-hover); text-decoration-color: var(--color-accent); }
  .vrules__link:hover svg { transform: translateX(3px); }
  .vrules__link:active { transform: translateY(1px); }

  /* ============ Purchase (#acquista) ============ */
  .buy {
    --accent: var(--color-accent);
    padding-block: clamp(4rem, 9vw, 7rem) clamp(4.5rem, 10vw, 8rem);
  }
  /* The page's destination, framed by the HUD's corner brackets. */
  .buy__panel {
    --arm: 1.5rem;
    position: relative;
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.5rem);
    padding: clamp(1.75rem, 5vw, 4.5rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--lift);
  }
  .buy__corners {
    inset: 0.75rem;
    color: color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .buy__title {
    margin: 0;
    font-weight: 700;
    font-size: clamp(2rem, 5.5vw, 3.4rem);
    letter-spacing: 0.01em;
    text-wrap: balance;
  }
  .buy__text {
    margin: 1.1rem 0 0;
    max-width: 34ch;
    color: var(--color-muted);
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .buy__contacts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .buy__call,
  .buy__mail {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 4.5rem;
    padding: 0.5rem 1.5rem 0.5rem 0.5rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out-expo),
      border-color var(--duration-fast) var(--ease-out-expo),
      transform var(--duration-fast) var(--ease-out-expo);
  }
  /* The call is the way to buy today: the section's one accent action. */
  .buy__call {
    background: var(--accent);
    color: var(--color-on-accent);
  }
  .buy__call:hover { background: var(--color-accent-hover); }
  .buy__mail {
    border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--color-border));
    background: var(--lift-2);
    color: var(--color-foreground);
  }
  .buy__mail:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 7%, var(--lift-2));
  }
  .buy__call:active,
  .buy__mail:active { transform: translateY(1px) scale(0.98); }
  .buy .buy__call:focus-visible,
  .buy .buy__mail:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: var(--radius-md);
  }
  .buy__chip {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-sm);
    background: var(--color-on-accent);
    color: var(--accent);
  }
  .buy__chip--line {
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--color-border));
    background: color-mix(in srgb, var(--accent) 6%, transparent);
  }
  .buy__call-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .buy__cap {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8rem;
    line-height: 1.3;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .buy__mail .buy__cap { color: var(--color-muted); }
  .buy__num {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.45rem, 1.2rem + 0.8vw, 1.85rem);
    line-height: 1.1;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .buy__addr {
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    font-weight: 500;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  /* --- Online purchase (TicketingHub), once wired: one click loads it (CODE-09). --- */
  .buy__open {
    min-height: 52px;
    padding-inline: 1.75rem;
    transition:
      background-color var(--duration-fast) var(--ease-out-expo),
      transform var(--duration-fast) var(--ease-out-expo);
  }
  .buy__open:active { transform: translateY(1px) scale(0.98); }
  .buy__open-busy,
  .buy__spin { display: none; }
  /* Loading: the label says so and a ring turns. aria-disabled, not disabled, so the focused
     button keeps focus until the purchase takes it. */
  .buy__shop.is-loading .buy__open { cursor: progress; }
  .buy__shop.is-loading .buy__open-idle { display: none; }
  .buy__shop.is-loading .buy__open-busy { display: inline; }
  .buy__shop.is-loading .buy__spin {
    display: inline-block;
    order: -1;
    width: 1.1rem;
    height: 1.1rem;
    border: 2px solid currentColor;
    border-inline-end-color: transparent;
    border-radius: 50%;
    /* Linear on purpose: a steady turn, not an entrance. Reduced motion stops it on its first frame. */
    animation: buy-spin calc(var(--duration-slow) * 1.75) linear infinite;
  }
  @keyframes buy-spin { to { transform: rotate(1turn); } }
  .buy__note,
  .buy__error {
    margin: 0.85rem 0 0;
    max-width: 44ch;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-muted);
    text-wrap: pretty;
  }
  .buy__error { color: var(--color-foreground); }
  .buy__mount:not([hidden]) { min-height: 36rem; }
  /* With the online purchase, the phone and the email step back to an alternative. */
  .buy__contacts--alt { margin-top: 1.75rem; }
  .buy__contacts--alt .buy__call {
    border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--color-border));
    background: var(--lift-2);
    color: var(--color-foreground);
  }
  .buy__contacts--alt .buy__call .buy__cap { color: var(--color-muted); }

  /* Tablets: the two ways side by side. */
  @media (min-width: 640px) {
    .buy__contacts { grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  }
  /* Desktop: the copy on the left, the ways to buy on the right. */
  @media (min-width: 1024px) {
    .buy__panel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      align-items: center;
      column-gap: clamp(3rem, 6vw, 6rem);
    }
    .buy__contacts { grid-template-columns: minmax(0, 1fr); }
    .buy__mount:not([hidden]) { grid-column: 1 / -1; }
  }
  @media (min-width: 1280px) {
    .buy__contacts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .buy__call,
    .buy__mail,
    .buy__open,
    .vrules__link,
    .vrules__link svg { transition: none; }
  }
</style>

<script>
  // Click to load: TicketingHub receives nothing until the visitor asks to buy (CODE-09). The panel
  // exists only once the embed is wired (see the page's frontmatter).
  const root = document.querySelector<HTMLElement>('[data-voucher-shop]');
  const idle = root?.querySelector<HTMLElement>('[data-shop-idle]');
  const button = root?.querySelector<HTMLElement>('[data-shop-load]');
  const mount = root?.querySelector<HTMLElement>('[data-shop-mount]');
  const error = root?.querySelector<HTMLElement>('[data-shop-error]');

  if (root?.dataset.src && idle && button && mount && error) {
    let started = false;
    button.addEventListener('click', () => {
      if (started) return;
      started = true;
      root.classList.add('is-loading');
      button.setAttribute('aria-disabled', 'true');
      error.hidden = true;
      mount.hidden = false;

      // The purchase replaces the button once its script is in; if it never arrives, the button
      // comes back with a line that points to the phone and the email below.
      const fail = () => {
        clearTimeout(timer);
        started = false;
        root.classList.remove('is-loading');
        button.removeAttribute('aria-disabled');
        mount.hidden = true;
        mount.replaceChildren();
        error.hidden = false;
      };
      const timer = setTimeout(fail, 10000);

      const script = document.createElement('script');
      script.src = root.dataset.src!;
      script.async = true;
      // TODO(TicketingHub): give the script the attributes its embed snippet sets (the voucher
      // widget's id is in root.dataset.id) and render the widget into `mount`.
      script.addEventListener(
        'load',
        () => {
          clearTimeout(timer);
          root.classList.remove('is-loading');
          idle.hidden = true;
          mount.tabIndex = -1;
          mount.focus({ preventScroll: true });
        },
        { once: true }
      );
      script.addEventListener('error', fail, { once: true });
      mount.append(script);
    });
  }
</script>

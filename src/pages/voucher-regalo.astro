---
// Gift vouchers (/voucher-regalo, the same address as the old site): someone buys a game for
// friends or family, who then book their own date within the validity. A text-only opening with
// the voucher drawn beside the title, the two vouchers side by side (#scegli, where the opening's
// button leads), each with its own button to buy it online, how the gift becomes a game, and the
// closing section every page ends on, with the phone and the email. Buying goes through a
// TicketingHub widget per voucher, which loads only with consent to the «external» cookies
// (CODE-09): until then a box above the cards explains it and activates it. Copy, prices and each
// voucher's widget id come from voucher.json (CMS-11); a section emptied in the CMS disappears
// (CMS-10).

import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/atoms/ArrowLink.astro';
import Button from '../components/atoms/Button.astro';
import Icon from '../components/atoms/Icon.astro';
import Breadcrumb from '../components/molecules/Breadcrumb.astro';
import HudFrame from '../components/molecules/HudFrame.astro';
import IncludedList from '../components/molecules/IncludedList.astro';
import Reveal from '../components/molecules/Reveal.astro';
import SectionHead from '../components/molecules/SectionHead.astro';
import VoucherTicket from '../components/molecules/VoucherTicket.astro';
import StepTimeline from '../components/organisms/StepTimeline.astro';
import FaqAccordion from '../components/organisms/FaqAccordion.astro';
import FinalCta from '../components/organisms/FinalCta.astro';
import page from '../data/voucher.json';
import navigation from '../data/navigation.json';
import settings from '../data/settings.json';
import { has } from '../lib/fields';
import { breadcrumbLd, faqLd } from '../lib/jsonld';
import { flattenNav, type NavItem } from '../lib/nav';

const { seo, hero, types, steps, faq } = page;

const path = '/voucher-regalo';
// The page name in the trail is its menu label (single source for both).
const pageName = flattenNav(navigation.items as NavItem[]).find((it) => it.href === path)?.label || hero.title;
const crumbs = [
  { label: 'Home', href: '/' },
  { label: pageName, href: path },
];

const cta = has(hero.cta?.label) && has(hero.cta?.href) ? hero.cta : undefined;

// Keep "3 €" on one line: a figure never wraps away from its unit.
const keep = (s: string) => s.replace(/(\d) €/g, '$1 €');

// A voucher shows once it has a name and a price; its parts drop out one by one when emptied. Its
// button needs both a label and the widget id: a voucher without one is shown, not sold online.
const cards = (types?.items ?? [])
  .filter((c) => has(c?.title) && has(c?.price))
  .map((c) => ({
    ...c,
    included: (c.included ?? []).filter(has),
    buy: has(c.buyLabel) && has(c.widgetId) ? { label: c.buyLabel.trim(), config: JSON.stringify({ widgetId: c.widgetId.trim() }) } : undefined,
  }));
const hasTypes = has(types?.title) && cards.length > 0;
const buy = types?.buy;
const sells = cards.some((c) => c.buy);

const stepItems = (steps?.items ?? []).filter((s) => has(s?.title));
const rules = (steps?.rules ?? []).filter(has);
const rulesLink = has(steps?.rulesLink?.label) && has(steps?.rulesLink?.href) ? steps.rulesLink : undefined;

const faqItems = (faq?.items ?? []).filter((f) => has(f.q) && has(f.a));
const faqData = faqLd(faqItems);
const jsonLd = [breadcrumbLd(crumbs, Astro.site), ...(faqData ? [faqData] : [])];
---

<BaseLayout title={seo.title} description={seo.description} image={seo.image} imageAlt={seo.imageAlt} jsonLd={jsonLd}>
  <section class="gift band" aria-labelledby="gift-title">
    <HudFrame tag={hero.hudTag} />

    <div class="gift__inner shell">
      <Breadcrumb items={crumbs} class="gift__crumbs" />

      <div class="gift__copy">
        {has(hero.eyebrow) && <p class="gift__eyebrow">{hero.eyebrow}</p>}
        <h1 class="gift__title" id="gift-title">{hero.title}</h1>
        {has(hero.subtitle) && <p class="gift__lede">{hero.subtitle}</p>}
        {cta && (
          <div class="gift__cta">
            <Button href={cta.href} variant="primary" class="gift__btn">{cta.label}</Button>
          </div>
        )}
      </div>

      {/* The voucher itself, drawn beside the title: it arrives once as the page opens. */}
      <div class="gift__art">
        <VoucherTicket title={hero.title} note={hero.ticketNote} brand={settings.siteName} entrance />
      </div>
    </div>
  </section>

  {hasTypes && (
    <section class="vtypes band" id="scegli" aria-labelledby="vtypes-title" data-checkout-title="Acquisto del voucher">
      {/* data-checkout-title: UI microcopy, the checkout frame's accessible name (CMS-02). */}
      {/* Before the cards paint, the stored cookie choice decides between the activation box and
          the cards' buy buttons, so a returning visitor sees no jump; the page script keeps it in
          sync after that. Without JavaScript neither shows: the closing section has the phone.
          The cookie is the one src/scripts/consent.ts names (cc_cookie). */}
      {sells && (
        <script is:inline>
          (() => {
            const section = document.currentScript.parentElement;
            const stored = document.cookie.match(/(?:^|; )cc_cookie=([^;]*)/);
            let on = false;
            try {
              on = !!stored && JSON.parse(decodeURIComponent(stored[1])).categories.includes('external');
            } catch {}
            section.setAttribute('data-buy', on ? 'on' : 'off');
          })();
        </script>
      )}
      <div class="shell">
        <div data-reveal>
          <SectionHead title={types.title} text={types.text} id="vtypes-title" />
        </div>

        {/* The step before choosing: what activating the purchase means, before anything loads.
            One box for both cards, gone once the purchase is active; never without its button. */}
        {sells && has(buy?.consentButton) && (
          <div class="vbuy">
            {has(buy?.consentText) && <p class="vbuy__text" id="vbuy-text">{buy.consentText}</p>}
            <div class="vbuy__actions">
              <Button type="button" variant="primary" class="vbuy__activate" data-vbuy-activate aria-describedby={has(buy?.consentText) ? 'vbuy-text' : undefined}>
                {buy.consentButton}
              </Button>
              {has(buy?.preferencesLabel) && (
                <button type="button" class="vbuy__prefs" data-cc="show-preferencesModal" data-vbuy-prefs>{buy.preferencesLabel}</button>
              )}
            </div>
          </div>
        )}

        {/* Once the purchase is active, in the box's place: the one thing to know about paying,
            read before pressing a card's button. The icon is decoration, the sentence the meaning. */}
        {sells && has(buy?.paymentNote) && (
          <p class="vpay">
            <span class="vpay__icon" aria-hidden="true"><Icon name="alert" size={20} /></span>
            <span id="vpay-text">{buy.paymentNote}</span>
          </p>
        )}

        <div class="vtypes__list" style={`--n: ${cards.length}`}>
          {cards.map((c, i) => (
            <article class="vcard" aria-labelledby={`vcard-${i}-title`} data-reveal style={`--i: ${i + 1}`}>
              <div class="vcard__top">
                <div class="vcard__head">
                  <h3 class="vcard__title" id={`vcard-${i}-title`}>{c.title}</h3>
                  {has(c.audience) && <p class="vcard__for">{c.audience}</p>}
                </div>
                <p class="vcard__price">
                  <span class="vcard__num">{c.price}</span>
                  {has(c.unit) && <span class="vcard__unit">{c.unit}</span>}
                </p>
              </div>
              {/* The perforation: the line a voucher is torn along, notched at both edges. */}
              <div class="vcard__body">
                {c.included.length > 0 && (
                  <Fragment>
                    {has(types.includedTitle) && <p class="vcard__incl-title" id={`vcard-${i}-incl`}>{types.includedTitle}</p>}
                    <ul class="vcard__incl" role="list" aria-labelledby={has(types.includedTitle) ? `vcard-${i}-incl` : undefined}>
                      {c.included.map((it) => (
                        <li class="vcard__item">
                          <span class="vcard__check" aria-hidden="true"><Icon name="check" size={14} /></span>
                          {it}
                        </li>
                      ))}
                    </ul>
                  </Fragment>
                )}
              </div>
              {has(c.note) && <p class="vcard__note">{keep(c.note)}</p>}
              {/* Our own button, shown once the external services are accepted: TicketingHub's
                  script is bound to it (the script below). It hears the payment notice too, which
                  focus skips on its way here. */}
              {c.buy && (
                <div class="vcard__buy">
                  <Button
                    type="button"
                    variant="primary"
                    class="vcard__btn"
                    data-th-popover=""
                    data-th-config={c.buy.config}
                    data-th-manually-managed=""
                    data-vbuy-open
                    aria-describedby={has(buy?.paymentNote) ? 'vpay-text' : undefined}
                  >
                    <span class="vcard__btn-idle">{c.buy.label}</span>
                    {/* Status label while the purchase loads (CMS-02). */}
                    <span class="vcard__btn-busy">Caricamento in corso</span>
                    <span class="vcard__spin" aria-hidden="true"></span>
                  </Button>
                </div>
              )}
            </article>
          ))}
        </div>

        {/* Under the cards: why the purchase did not load, if it did not (the client's words), and
            what assistive technologies hear when it becomes active (status microcopy, CMS-02). */}
        {sells && (
          <div class="vbuy-foot">
            <p class="vbuy-foot__status" role="status" data-vbuy-status data-fail={buy?.failText?.trim() ?? ''}></p>
            <p class="sr-only" aria-live="polite" data-vbuy-live data-on="Acquisto online attivo: scegli il voucher."></p>
          </div>
        )}
      </div>
    </section>
  )}

  {has(steps?.title) && stepItems.length > 0 && (
    <StepTimeline title={steps.title} text={steps.text} steps={stepItems} id="come-funziona">
      {rules.length > 0 && (
        <div class="vrules">
          <IncludedList title={steps.rulesTitle} items={rules} layout="row" />
          {rulesLink && (
            <ArrowLink href={rulesLink.href}>{rulesLink.label}</ArrowLink>
          )}
        </div>
      )}
    </StepTimeline>
  )}

  {faq && has(faq.title) && faqItems.length > 0 && <FaqAccordion title={faq.title} items={faqItems} />}

  {/* #prenota: the closing section of every page, where the header's Prenota lands. */}
  <FinalCta {...settings.finalCta} />

  <Reveal />
</BaseLayout>

<style is:global>
  /* ============ Opening ============ */
  .gift {
    --accent: var(--color-accent);
    /* Room for the floating header (logo 48px + 20px padding each side), as in the other text-only
       openings; the HUD readout sits on the breadcrumb's row, right-aligned with the page column. */
    --gift-top: 5.75rem;
    --hud-tag-top: calc(var(--gift-top) + 0.55rem);
    --hud-tag-right: calc(max(0px, (100% - var(--shell-max)) / 2) + var(--shell-gutter));
    --hud-tag-bottom: auto;
    isolation: isolate;
    overflow: hidden;
  }
  /* A soft, neutral light behind the title, as on the contact page: depth, not a halo. */
  .gift::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(55% 60% at 12% 18%, color-mix(in srgb, var(--color-foreground) 6%, transparent), transparent 70%);
  }
  .gift .hud__scan { z-index: 0; }
  .gift .hud__corners,
  .gift .hud__tag { z-index: 2; }
  /* Below desktop the header's logo and Menu pill fill the top corners: the frame's top pair drops
     under them. */
  @media (max-width: 1023px) {
    .gift .hud__corners { top: 5.5rem; }
  }

  .gift__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "crumbs" "copy" "art";
    /* The bottom clears the frame's lower corners (18px inset + 34px). */
    padding-block: var(--gift-top) clamp(4.5rem, 9vw, 6rem);
  }
  /* The trail's first label lines up with the headline: the link's own padding hangs outside. */
  .gift__crumbs {
    grid-area: crumbs;
    justify-self: start;
    max-width: 100%;
    margin-left: -0.375rem;
  }

  .gift__copy {
    grid-area: copy;
    margin-top: clamp(1.25rem, 4vw, 2.5rem);
  }
  .gift__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(0.75rem, 1.4vw, 0.85rem);
    line-height: 1.3;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .gift__eyebrow::before {
    content: "";
    flex: none;
    width: 30px;
    height: 2px;
    background: var(--accent);
  }
  /* The page's largest text and its LCP: it never gets an entrance (DES-08). In em, not ch, so the
     fallback face wraps where Oswald will (PERF-03). */
  .gift__title {
    margin: 0;
    max-width: 8.8em;
    font-weight: 700;
    font-size: clamp(2.75rem, 1.5rem + 6.4vw, 7.25rem);
    line-height: 0.94;
    letter-spacing: 0.005em;
    text-wrap: balance;
  }
  /* The inner pages' accent rule under the headline: a pseudo-element, so the H1 itself stays
     still. Hero choreography, longer than the UI duration tokens on purpose. */
  .gift__title::after {
    content: "";
    display: block;
    width: clamp(64px, 18vw, 160px);
    height: 5px;
    margin-top: 0.45rem;
    background: var(--accent);
    transform-origin: left;
    animation: gift-wipe 0.7s var(--ease-out-expo) 0.35s both;
  }
  @keyframes gift-wipe { from { transform: scaleX(0); } }
  .gift__lede {
    margin: 1.4rem 0 0;
    max-width: 30em;
    font-size: clamp(1.05rem, 0.95rem + 0.45vw, 1.3rem);
    line-height: 1.55;
    color: var(--color-muted);
    text-wrap: pretty;
  }
  .gift__cta { margin-top: 1.9rem; }
  .gift__btn {
    min-height: 48px;
    padding-inline: 1.6rem;
    transition:
      background-color var(--duration-fast) var(--ease-out-expo),
      transform var(--duration-fast) var(--ease-out-expo);
  }
  .gift__btn:active { transform: translateY(1px) scale(0.98); }

  /* --- The voucher (VoucherTicket): centred under the copy, beside it from desktop. --- */
  .gift__art {
    grid-area: art;
    justify-self: center;
    width: min(100%, 30rem);
    margin-top: clamp(3rem, 10vw, 4rem);
  }

  /* Desktop: the voucher beside the copy, a little larger and more tilted. */
  @media (min-width: 1024px) {
    .gift__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      grid-template-areas: "crumbs crumbs" "copy art";
      column-gap: clamp(3rem, 6vw, 7rem);
      align-items: center;
    }
    .gift__art {
      justify-self: end;
      width: min(100%, 36rem);
      margin-top: clamp(1.25rem, 4vw, 2.5rem);
      --ticket-tilt: -4deg;
    }
  }

  /* Landscape phones: a smaller headline brings the button up; the frame's top pair and the readout
     have no room under the header. */
  @media (max-height: 500px) and (orientation: landscape) {
    .gift { --gift-top: 4.75rem; }
    .gift .hud__corner--tl,
    .gift .hud__corner--tr,
    .gift .hud__tag { display: none; }
    .gift__copy { margin-top: 1rem; }
    .gift__title { max-width: none; font-size: clamp(2rem, 11vh, 2.75rem); }
    .gift__eyebrow { margin-bottom: 0.6rem; }
    .gift__lede { margin-top: 0.75rem; font-size: 1rem; }
    .gift__cta { margin-top: 1.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gift__title::after { animation: none; }
    .gift__btn { transition: none; }
  }

  /* ============ The two vouchers ============ */
  .vtypes {
    --accent: var(--color-accent);
    padding-block: clamp(4rem, 9vw, 7rem) clamp(4.5rem, 10vw, 8rem);
  }
  .vtypes__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    margin-top: clamp(2.25rem, 5vw, 3.5rem);
  }
  .vcard {
    --pad: clamp(1.25rem, 3vw, 2.25rem);
    --notch: 0.7rem;
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--pad);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--lift);
  }
  /* Name on the left, price on the right where the card is wide enough; below it otherwise. The
     names start on one line across the cards, the prices sit on the row's foot. */
  .vcard__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding-bottom: clamp(1.5rem, 3vw, 2rem);
  }
  .vcard__head {
    flex: 1 1 15rem;
    min-width: 0;
  }
  .vcard__title {
    margin: 0;
    font-weight: 700;
    font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.3rem);
    letter-spacing: 0.01em;
    text-wrap: balance;
  }
  .vcard__for {
    margin: 0.55rem 0 0;
    max-width: 34ch;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .vcard__price {
    flex: none;
    align-self: flex-end;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    white-space: nowrap;
  }
  .vcard__num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.25rem, 2.6rem + 2.6vw, 4.75rem);
    line-height: 0.9;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
  .vcard__unit {
    font-size: 0.95rem;
    line-height: 1.25;
    color: var(--color-muted);
  }

  /* The perforation runs across the whole card, from notch to notch. The notches are half discs of
     the band's ground laid over the card's border, outlined like it, so no clipping is needed. */
  .vcard__body {
    position: relative;
    margin-inline: calc(-1 * var(--pad));
    padding: clamp(1.5rem, 3vw, 2rem) var(--pad) 0;
    background: repeating-linear-gradient(90deg, var(--color-border) 0 0.5rem, transparent 0.5rem 0.9rem) center top / calc(100% - 2 * var(--notch) - 1.5rem) 1px no-repeat;
  }
  .vcard__body::before,
  .vcard__body::after {
    content: "";
    position: absolute;
    top: calc(-1 * var(--notch));
    width: var(--notch);
    height: calc(2 * var(--notch));
    border: 1px solid var(--color-border);
    background: var(--plane);
  }
  .vcard__body::before {
    left: -1px;
    border-left: 0;
    border-radius: 0 var(--notch) var(--notch) 0;
  }
  .vcard__body::after {
    right: -1px;
    border-right: 0;
    border-radius: var(--notch) 0 0 var(--notch);
  }
  .vcard__incl-title {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    line-height: 1.3;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .vcard__incl {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: 0.8rem 1.5rem;
  }
  .vcard__item {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    line-height: 1.45;
    text-wrap: pretty;
  }
  /* The same check as the site's "included" lists. */
  .vcard__check {
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-top: 0;
    border-radius: 50%;
    color: var(--color-on-accent);
    background: var(--accent);
  }
  .vcard__check svg { stroke-width: 3; }
  .vcard__note {
    margin: 1.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.95rem;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
    color: var(--color-foreground);
  }

  /* The card's own purchase, at its foot. The labels come from the CMS and can be long: the
     button takes the card's width and a long label wraps on balanced lines. */
  .vcard__buy { padding-top: 1.5rem; }
  .vcard__btn {
    width: 100%;
    min-height: 2.75rem;
    text-align: center;
    text-wrap: balance;
  }
  .vcard__btn:active { transform: translateY(1px) scale(0.98); }
  .vcard__btn-busy,
  .vcard__spin { display: none; }
  /* Waiting for TicketingHub after a press: the label says so and a ring turns, as on the
     contact page's map (aria-busy for assistive technologies), so the wait shows on touch too. */
  .vcard__btn.is-loading { cursor: progress; }
  .vcard__btn.is-loading .vcard__btn-idle { display: none; }
  .vcard__btn.is-loading .vcard__btn-busy { display: inline; }
  .vcard__btn.is-loading .vcard__spin {
    display: inline-block;
    order: -1;
    width: 1.1rem;
    height: 1.1rem;
    border: 2px solid currentColor;
    border-inline-end-color: transparent;
    border-radius: 50%;
    /* Linear on purpose: a steady turn, not an entrance. Reduced motion stops it on its first frame. */
    animation: vcard-spin calc(var(--duration-slow) * 1.75) linear infinite;
  }
  @keyframes vcard-spin {
    to { transform: rotate(1turn); }
  }

  /* What shows depends on the external services' consent (data-buy, set before the cards paint):
     off, the activation box; on, the buy buttons and the note on the payment. Hidden with display,
     so a hidden control is out of the tab order and of the accessibility tree too. Without
     JavaScript there is no data-buy and neither shows. */
  .vtypes:not([data-buy='off']) .vbuy,
  .vtypes:not([data-buy='on']) .vcard__buy,
  .vtypes:not([data-buy='on']) .vpay { display: none; }

  /* Side by side from tablets: one shared row per part (top, list, note, button), so the
     perforations line up and the notes and the buttons sit on the same foot line. */
  @media (min-width: 768px) {
    .vtypes__list {
      grid-template-columns: repeat(var(--n, 2), minmax(0, 1fr));
      grid-template-rows: repeat(4, auto);
      row-gap: 0;
    }
    @supports (grid-template-rows: subgrid) {
      .vcard {
        display: grid;
        grid-row: span 4;
        grid-template-rows: subgrid;
      }
      .vcard__top { grid-row: 1; }
      .vcard__body { grid-row: 2; align-self: start; }
      .vcard__note { grid-row: 3; align-self: end; }
      .vcard__buy { grid-row: 4; }
    }
  }

  /* --- The step before choosing: activating the online purchase --- */
  /* A raised panel opening on the accent seam, as the site's raised surfaces do: a step of the
     purchase, not a warning. */
  .vbuy {
    position: relative;
    display: grid;
    gap: 1.25rem 2.5rem;
    align-items: center;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    padding: clamp(1.25rem, 3vw, 1.75rem) clamp(1.25rem, 3vw, 2.25rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--lift);
  }
  .vbuy::before {
    content: "";
    position: absolute;
    top: -1px;
    left: clamp(1.25rem, 3vw, 2.25rem);
    width: 3rem;
    height: 2px;
    background: var(--accent);
  }
  .vbuy__text {
    margin: 0;
    max-width: 62ch;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .vbuy__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
  }
  .vbuy__activate { min-height: 2.75rem; }
  .vbuy__activate:active { transform: translateY(1px) scale(0.98); }
  /* The preferences: a link's look, as the footer's «Preferenze cookie». */
  .vbuy__prefs {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.9rem;
    color: var(--color-muted);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 50%, transparent);
    text-underline-offset: 4px;
    transition:
      color var(--duration-fast) var(--ease-out-expo),
      text-decoration-color var(--duration-fast) var(--ease-out-expo);
  }
  .vbuy__prefs:hover { color: var(--color-foreground); text-decoration-color: var(--accent); }
  .vbuy__prefs:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px; }

  /* --- The payment notice: a full-width line on the raised surface, the attention sign in the
     accent; the sentence carries the meaning, never the colour. --- */
  .vpay {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    margin: clamp(1.75rem, 4vw, 2.5rem) 0 0;
    padding: 0.95rem clamp(1.1rem, 2.5vw, 1.5rem);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--color-border));
    border-radius: var(--radius-md);
    background: var(--lift);
    color: var(--color-foreground);
    font-size: 1rem;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .vpay__icon {
    flex: none;
    display: grid;
    place-items: center;
    /* One line of text tall, so the sign sits on the first line whatever the wrap. */
    height: 1.5em;
    color: var(--accent);
  }

  /* --- Under the cards: why the purchase did not load, if it did not --- */
  /* Empty, the status region keeps no room but stays in the accessibility tree, so what it says
     later is announced. */
  .vbuy-foot__status {
    margin: 0;
    color: var(--color-foreground);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .vbuy-foot__status:not(:empty) { margin-top: clamp(1rem, 2vw, 1.5rem); }

  @media (min-width: 1024px) {
    .vbuy { grid-template-columns: minmax(0, 1fr) auto; }
  }

  /* TicketingHub's checkout overlay. Its document is light and the site's root is dark: with two
     different colour schemes Chrome paints the iframe opaque, and the checkout sits on a blank
     white page. The overlay's own scheme keeps it see-through over the site. */
  #ticketinghub-overlay-iframe { color-scheme: normal; }

  /* ============ Before playing (under the steps) ============ */
  .vrules {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .vrules .incl { justify-self: stretch; }
</style>

<script>
  // TicketingHub's checkout, one widget per voucher, as TicketingHub's popover snippets set it out:
  // the button is ours, the script binds to it (data-th-manually-managed) and opens the checkout
  // in a modal over the page. The script brings Google Analytics, so it loads only with consent to
  // the external services (CODE-09): from the banner, or from the box above the cards, which is
  // the contextual consent (src/scripts/consent.ts). Until then the box shows and the buttons do
  // not (data-buy on the section, set before the cards paint by the inline script there).
  interface Checkout {
    show: () => void;
    close: () => void;
  }
  declare global {
    interface Window {
      TicketinghubWidget?: {
        new (el: Element, config: Record<string, unknown>): Checkout;
        widgetConfig: (el: Element) => Record<string, unknown> | null;
      };
    }
  }

  const SCRIPT = 'https://widget.ticketinghub.com/embedding/latest.js';
  // How long a press waits for TicketingHub before the failure message.
  const WAIT = 10000;
  const section = document.getElementById('scegli');
  const buttons = [...document.querySelectorAll<HTMLElement>('[data-vbuy-open]')];

  if (section?.hasAttribute('data-buy') && buttons.length) {
    const activate = section.querySelector<HTMLElement>('[data-vbuy-activate]');
    const prefs = section.querySelector<HTMLElement>('[data-vbuy-prefs]');
    const status = section.querySelector<HTMLElement>('[data-vbuy-status]');
    const live = section.querySelector<HTMLElement>('[data-vbuy-live]');
    const checkouts = new Map<Element, Checkout>();
    let state: 'off' | 'loading' | 'ready' | 'failed' = 'off';
    let wanted: HTMLElement | null = null;
    let timer = 0;
    // The wait ran out: further presses go straight to the message instead of waiting again.
    let timedOut = false;
    // The purchase activated from the box or from the preferences, whose controls then disappear
    // or close: focus goes on to the first voucher.
    let fromBox = false;
    let fromPrefs = false;

    // --- Waiting: the pressed button says so (label, ring, aria-busy) until its checkout opens ---
    const busy = (b: HTMLElement | null, on: boolean) => {
      if (!b) return;
      b.classList.toggle('is-loading', on);
      if (on) b.setAttribute('aria-busy', 'true');
      else b.removeAttribute('aria-busy');
    };
    const want = (b: HTMLElement | null) => {
      busy(wanted, false);
      wanted = b;
      busy(b, true);
    };
    const clearStatus = () => {
      if (status) status.textContent = '';
    };
    // TicketingHub unreachable (offline, blocked) or a voucher's widget broken: the client's
    // message under the cards, which points to the contacts in the closing section. Emptied and
    // written again a moment later, so a repeated message is announced again.
    const fail = () => {
      clearTimeout(timer);
      want(null);
      if (!status) return;
      status.textContent = '';
      setTimeout(() => {
        status.textContent = status.dataset.fail ?? '';
      }, 100);
    };

    // --- The checkout as a modal (WCAG 2.4.3): focus goes in, the page behind is inert, and on
    // closing focus comes back to the button that opened it ---
    let opener: HTMLElement | null = null;
    let current: Checkout | null = null;
    let inert: Element[] = [];
    const ready = new WeakSet<HTMLIFrameElement>();
    // The opening already set up: TicketingHub may call show() again while it is open.
    let shown = false;
    let watch: MutationObserver | null = null;

    const restore = () => {
      watch?.disconnect();
      watch = null;
      shown = false;
      for (const el of inert) el.removeAttribute('inert');
      inert = [];
      current = null;
      const back = opener;
      opener = null;
      // TicketingHub has already put the page back where it was: focus without scrolling.
      back?.focus({ preventScroll: true });
    };

    // Dispatched by TicketingHub's show(), right after it mounts the checkout's frame. Only the
    // first of an opening counts: a second one would find the page already inert and lose the
    // list to restore, and take focus back to the frame.
    document.addEventListener('ticketinghub.shown', () => {
      const overlay = document.getElementById('ticketinghub-overlay');
      if (!overlay || !current || shown) return;
      shown = true;
      // Closed (its own X, Esc while focus is still here, TicketingHub itself): the overlay drops
      // its showing class, or leaves the page.
      watch = new MutationObserver(() => {
        if (current && (!overlay.isConnected || !overlay.classList.contains('ticketinghub-is-showing'))) restore();
      });
      watch.observe(overlay, { attributes: true, attributeFilter: ['class'] });
      watch.observe(document.body, { childList: true, subtree: true });
      inert = [...document.body.children].filter((el) => !el.contains(overlay) && !el.hasAttribute('inert'));
      for (const el of inert) el.setAttribute('inert', '');
      const frame = overlay.querySelector<HTMLIFrameElement>('#ticketinghub-overlay-iframe, iframe');
      if (!frame) return;
      frame.title = section.dataset.checkoutTitle ?? '';
      // The same voucher reopened keeps its frame, already loaded; a new one is focused once in.
      if (ready.has(frame)) frame.focus();
      else {
        frame.addEventListener(
          'load',
          () => {
            ready.add(frame);
            if (current) frame.focus();
          },
          { once: true }
        );
      }
    });

    // Esc closes the checkout only while focus is still in this document, before the frame takes
    // it: inside TicketingHub's frame the key is theirs, and their checkout ignores it (known
    // debt, docs/standards/README.md).
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && current) current.close();
    });

    const open = (b: HTMLElement) => {
      const checkout = checkouts.get(b);
      if (!checkout) return fail();
      clearStatus();
      opener = b;
      current = checkout;
      checkout.show();
    };

    const load = () => {
      if (state !== 'off') return;
      state = 'loading';
      // Without a Google tag of ours on the page, TicketingHub installs its own with no consent
      // defaults: give it the ones the visitor agreed to (advertising denied; statistics granted,
      // which the external services include). Not window.gtag: TicketingHub would skip its tag.
      if (!window.gtag) {
        window.dataLayer = window.dataLayer || [];
        function consentDefault(..._args: unknown[]) {
          // gtag reads the arguments object, not an array.
          window.dataLayer!.push(arguments);
        }
        consentDefault('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'granted',
        });
      }
      const script = document.createElement('script');
      script.src = SCRIPT;
      script.async = true;
      script.addEventListener(
        'load',
        () => {
          clearTimeout(timer);
          timedOut = false;
          clearStatus();
          const Widget = window.TicketinghubWidget;
          if (Widget) {
            for (const b of buttons) {
              try {
                // The modal last: a mode in a voucher's data-th-config never turns it into an embed.
                checkouts.set(b, new Widget(b, { ...Widget.widgetConfig(b), mode: 'modal' }));
              } catch {
                // That voucher's widget id is not valid: its button reports it when pressed.
              }
            }
          }
          state = 'ready';
          const b = wanted;
          want(null);
          if (b) open(b);
        },
        { once: true }
      );
      script.addEventListener(
        'error',
        () => {
          state = 'failed';
          fail();
        },
        { once: true }
      );
      document.head.append(script);
    };

    for (const b of buttons) {
      b.addEventListener('click', () => {
        if (state === 'ready') return open(b);
        if (state === 'failed' || timedOut) return fail();
        // Pressed before TicketingHub is in: its checkout opens as soon as it is, or the wait
        // ends in the failure message.
        want(b);
        clearStatus();
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          timedOut = true;
          fail();
        }, WAIT);
      });
    }

    const announce = () => {
      buttons[0].focus();
      if (live) live.textContent = live.dataset.on ?? '';
    };

    activate?.addEventListener('click', () => {
      // consent.ts defines it once the cookie library is running.
      if (!window.__acceptExternal) return;
      fromBox = true;
      window.__acceptExternal();
    });

    // The choice arrives after the page (the banner, or a stored choice read by consent.ts), and
    // again whenever it changes. Withdrawing reloads the page (consent.ts), so the purchase never
    // needs switching off here.
    const sync = () => {
      const moveFocus = fromBox;
      fromBox = false;
      const on = !!window.__consent?.external;
      section.setAttribute('data-buy', on ? 'on' : 'off');
      if (!on) return;
      load();
      if (moveFocus) announce();
    };
    window.addEventListener('consent-change', sync);
    if (window.__consent) sync();

    // Opened from the box's link (focus on it as the dialog opens: a press before the cookie
    // library ran leaves nothing behind), the preferences close after the choice: then focus goes
    // on to the first voucher if the purchase is now active, or back to the link if not. A tick
    // later, after the library's own handling of the choice and of the close.
    window.addEventListener('cc:onModalShow', (e) => {
      if ((e as CustomEvent<{ modalName?: string }>).detail?.modalName === 'preferencesModal') {
        fromPrefs = !!prefs && document.activeElement === prefs;
      }
    });
    window.addEventListener('cc:onModalHide', (e) => {
      if (!fromPrefs || (e as CustomEvent<{ modalName?: string }>).detail?.modalName !== 'preferencesModal') return;
      fromPrefs = false;
      setTimeout(() => {
        if (section.getAttribute('data-buy') === 'on') announce();
        else prefs?.focus();
      });
    });
  }
</script>
